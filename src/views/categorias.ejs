<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<style>
    /* ===== VARIÁVEIS ===== */
    :root {
        --primary: #667eea;
        --secondary: #764ba2;
        --light-bg: #fafaff;
        --text-dark: #2d3436;
        --text-light: #636e72;
        --shadow-sm: 0 5px 20px rgba(0,0,0,0.02);
        --shadow-md: 0 10px 30px rgba(102, 126, 234, 0.05);
        --shadow-lg: 0 20px 40px rgba(102, 126, 234, 0.08);
        --gradient: linear-gradient(135deg, var(--primary), var(--secondary));
    }

    /* ===== HEADER ===== */
    .categorias-header {
        background: linear-gradient(135deg, #f5f0ff 0%, #f0f5ff 100%);
        padding: 80px 0;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .categorias-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 100%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, transparent 60%);
        animation: spinSlow 90s linear infinite;
    }

    .categorias-header h1 {
        font-size: 3.5rem;
        font-weight: 300;
        color: var(--text-dark);
        margin-bottom: 20px;
        position: relative;
        z-index: 2;
    }

    .categorias-header h1 span {
        font-weight: 700;
        background: var(--gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .categorias-header p {
        font-size: 1.2rem;
        color: var(--text-light);
        font-weight: 300;
        max-width: 600px;
        margin: 0 auto;
        position: relative;
        z-index: 2;
    }

    @keyframes spinSlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* ===== CATEGORIA CARD ===== */
    .categoria-section {
        margin-bottom: 80px;
    }

    .categoria-section:last-child {
        margin-bottom: 0;
    }

    .categoria-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .categoria-titulo {
        font-size: 2rem;
        font-weight: 300;
        color: var(--text-dark);
    }

    .categoria-titulo span {
        font-weight: 700;
        background: var(--gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .categoria-stats {
        color: var(--text-light);
    }

    .categoria-stats i {
        color: var(--primary);
        margin-right: 5px;
    }

    .categoria-link {
        padding: 10px 25px;
        background: var(--gradient);
        color: white;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .categoria-link:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-lg);
        color: white;
    }

    /* ===== PRODUTOS DA CATEGORIA ===== */
    .categoria-produtos {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 20px;
    }

    .produto-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.3s ease;
        border: 1px solid rgba(102, 126, 234, 0.05);
        box-shadow: var(--shadow-sm);
        text-decoration: none;
        color: inherit;
    }

    .produto-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-md);
    }

    .produto-imagem {
        height: 150px;
        overflow: hidden;
    }

    .produto-imagem img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .produto-card:hover .produto-imagem img {
        transform: scale(1.1);
    }

    .produto-info {
        padding: 15px;
    }

    .produto-nome {
        font-size: 1rem;
        font-weight: 500;
        color: var(--text-dark);
        margin-bottom: 5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .produto-preco {
        color: var(--primary);
        font-weight: 600;
    }

    /* ===== CATEGORIA CARD GRANDE ===== */
    .categoria-card-grande {
        background: white;
        border-radius: 30px;
        padding: 40px;
        text-align: center;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid rgba(102, 126, 234, 0.05);
        box-shadow: var(--shadow-sm);
        height: 100%;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .categoria-card-grande:hover {
        transform: translateY(-10px) scale(1.02);
        box-shadow: var(--shadow-lg);
    }

    .categoria-card-grande i {
        font-size: 3.5rem;
        background: var(--gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 20px;
        transition: transform 0.3s ease;
    }

    .categoria-card-grande:hover i {
        transform: scale(1.2) rotate(5deg);
    }

    .categoria-card-grande h3 {
        font-size: 1.5rem;
        font-weight: 400;
        color: var(--text-dark);
        margin-bottom: 10px;
    }

    .categoria-card-grande p {
        color: var(--text-light);
        font-weight: 300;
        margin-bottom: 15px;
    }

    .categoria-card-grande .badge {
        background: var(--gradient);
        color: white;
        padding: 5px 15px;
        border-radius: 50px;
        font-size: 0.9rem;
    }

    /* ===== RESPONSIVIDADE ===== */
    @media (max-width: 992px) {
        .categoria-produtos {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (max-width: 768px) {
        .categoria-produtos {
            grid-template-columns: repeat(2, 1fr);
        }
        
        .categorias-header h1 {
            font-size: 2.5rem;
        }
    }

    @media (max-width: 576px) {
        .categoria-produtos {
            grid-template-columns: 1fr;
        }
    }

    /* ===== ANIMAÇÕES ===== */
    @keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .fade-up {
        animation: fadeUp 0.6s ease;
    }
</style>

<!-- Header -->
<section class="categorias-header">
    <div class="container">
        <h1>
            Navegue por <span>Categorias</span>
        </h1>
        <p>Encontre exatamente o que você procura em nossas categorias</p>
    </div>
</section>

<!-- Lista de Categorias -->
<section class="py-5">
    <div class="container">
        <% if (categorias && categorias.length > 0) { %>
            <!-- Cards de Categorias -->
            <div class="row g-4 mb-5">
                <% categorias.forEach((cat, index) => { %>
                <div class="col-md-4 col-lg-3">
                    <a href="/categoria/<%= encodeURIComponent(cat.categoria) %>" class="categoria-card-grande fade-up" style="animation-delay: <%= index * 0.1 %>s">
                        <% if (cat.categoria === 'Café da manhã') { %>
                            <i class="bi bi-cup-hot-fill"></i>
                        <% } else if (cat.categoria === 'Doces') { %>
                            <i class="bi bi-cake-fill"></i>
                        <% } else if (cat.categoria === 'Salgados') { %>
                            <i class="bi bi-egg-fried"></i>
                        <% } else if (cat.categoria === 'Bebidas') { %>
                            <i class="bi bi-cup-straw"></i>
                        <% } else { %>
                            <i class="bi bi-box-seam"></i>
                        <% } %>
                        <h3><%= cat.categoria %></h3>
                        <p><%= cat.total %> produtos</p>
                        <span class="badge">Explorar</span>
                    </a>
                </div>
                <% }) %>
            </div>
            
            <!-- Produtos Recentes por Categoria -->
            <% categorias.forEach((cat, index) => { %>
                <% if (cat.produtos && cat.produtos.length > 0) { %>
                <div class="categoria-section">
                    <div class="categoria-header">
                        <div>
                            <h2 class="categoria-titulo">
                                <span><%= cat.categoria %></span>
                            </h2>
                            <div class="categoria-stats">
                                <i class="bi bi-box"></i>
                                <%= cat.total %> produtos
                                <i class="bi bi-currency-dollar ms-3"></i>
                                <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(cat.preco_min) %> - 
                                <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(cat.preco_max) %>
                            </div>
                        </div>
                        <a href="/categoria/<%= encodeURIComponent(cat.categoria) %>" class="categoria-link">
                            Ver todos <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                    
                    <div class="categoria-produtos">
                        <% cat.produtos.forEach(produto => { %>
                        <a href="/usuario/<%= produto.usuario_id %>/produtos" class="produto-card">
                            <div class="produto-imagem">
                                <% if (produto.imagemUrl) { %>
                                    <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>">
                                <% } else { %>
                                    <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                        <i class="bi bi-image text-secondary"></i>
                                    </div>
                                <% } %>
                            </div>
                            <div class="produto-info">
                                <h4 class="produto-nome"><%= produto.name %></h4>
                                <span class="produto-preco"><%= produto.precoFormatado %></span>
                            </div>
                        </a>
                        <% }) %>
                    </div>
                </div>
                <% } %>
            <% }); %>
            
        <% } else { %>
            <div class="text-center py-5">
                <i class="bi bi-tags display-1 text-muted"></i>
                <h3 class="mt-3">Nenhuma categoria encontrada</h3>
                <p class="text-muted">Ainda não há produtos cadastrados no sistema.</p>
                <% if (user) { %>
                <a href="/produtos/adicionar" class="btn btn-primary mt-3">
                    <i class="bi bi-plus-circle me-2"></i>Adicionar produto
                </a>
                <% } %>
            </div>
        <% } %>
    </div>
</section>

<%- include('./includes/footer') %>