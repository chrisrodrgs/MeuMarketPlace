<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<!-- Header -->
<section class="hero-section" style="min-height: 30vh; padding: 60px 0;">
    <div class="container text-center">
        <h1 class="hero-title">
            Navegue por <span>Categorias</span>
        </h1>
        <p class="hero-subtitle">Encontre exatamente o que você procura</p>
    </div>
</section>

<!-- Categorias -->
<section class="py-5">
    <div class="container">
        <% if (categorias && categorias.length > 0) { %>
            <!-- Cards de Categorias -->
            <div class="row g-4 mb-5">
                <% categorias.forEach((cat, index) => { %>
                <div class="col-md-4 col-lg-3">
                    <a href="/categoria/<%= encodeURIComponent(cat.categoria) %>" class="text-decoration-none">
                        <div class="card-elegante text-center p-4 h-100">
                            <% if (cat.categoria === 'Café da manhã') { %>
                                <i class="bi bi-cup-hot-fill display-1 text-primary"></i>
                            <% } else if (cat.categoria === 'Doces') { %>
                                <i class="bi bi-cake-fill display-1 text-primary"></i>
                            <% } else if (cat.categoria === 'Salgados') { %>
                                <i class="bi bi-egg-fried display-1 text-primary"></i>
                            <% } else if (cat.categoria === 'Bebidas') { %>
                                <i class="bi bi-cup-straw display-1 text-primary"></i>
                            <% } else { %>
                                <i class="bi bi-box-seam display-1 text-primary"></i>
                            <% } %>
                            <h5 class="mt-3 fw-bold"><%= cat.categoria %></h5>
                            <p class="text-muted"><%= cat.total %> produtos</p>
                            <span class="badge bg-primary">Explorar</span>
                        </div>
                    </a>
                </div>
                <% }) %>
            </div>
            
            <!-- Produtos Recentes por Categoria -->
            <% categorias.forEach(cat => { %>
                <% if (cat.produtos && cat.produtos.length > 0) { %>
                <div class="mb-5">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="fw-light"><%= cat.categoria %></h3>
                        <a href="/categoria/<%= encodeURIComponent(cat.categoria) %>" class="btn-elegante outline small">Ver todos <i class="bi bi-arrow-right"></i></a>
                    </div>
                    <div class="row g-3">
                        <% cat.produtos.forEach(produto => { %>
                        <div class="col-md-3">
                            <a href="/produto/<%= produto.id %>" class="text-decoration-none">
                                <div class="card-elegante">
                                    <div class="product-image-elegante" style="height: 120px;">
                                        <% if (produto.imagemUrl) { %>
                                            <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>">
                                        <% } else { %>
                                            <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                                <i class="bi bi-image text-secondary"></i>
                                            </div>
                                        <% } %>
                                    </div>
                                    <div class="p-2">
                                        <h6 class="text-truncate mb-0"><%= produto.name %></h6>
                                        <span class="text-primary fw-bold"><%= produto.precoFormatado %></span>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% } %>
            <% }); %>
            
        <% } else { %>
            <div class="text-center py-5">
                <i class="bi bi-tags display-1 text-muted"></i>
                <h3 class="fw-light mt-3">Nenhuma categoria encontrada</h3>
                <p class="text-muted">Ainda não há produtos cadastrados.</p>
                <a href="/produtos/adicionar" class="btn-elegante primary mt-3">Adicionar produto</a>
            </div>
        <% } %>
    </div>
</section>

<%- include('./includes/footer') %>