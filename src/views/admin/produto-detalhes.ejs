<%- include('../includes/head') %>
<%- include('../includes/nav1') %>

<style>
    :root {
        --primary: #667eea;
        --secondary: #764ba2;
        --light-bg: #fafaff;
        --text-dark: #2d3436;
        --text-light: #636e72;
        --shadow-sm: 0 5px 20px rgba(0,0,0,0.02);
        --shadow-md: 0 10px 30px rgba(102, 126, 234, 0.05);
        --shadow-lg: 0 20px 40px rgba(102, 126, 234, 0.08);
        --gradient: linear-gradient(135deg, var(--primary), var(--secondary));
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #f8f9fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .header-section {
        background: linear-gradient(135deg, #f5f0ff 0%, #f0f5ff 100%);
        padding: 40px 0;
        margin-bottom: 30px;
        border-radius: 0 0 30px 30px;
    }

    .product-image {
        width: 100%;
        max-height: 300px;
        object-fit: cover;
        border-radius: 30px;
        box-shadow: var(--shadow-lg);
        background-color: #f8f9fa;
    }

    .image-placeholder {
        width: 100%;
        height: 300px;
        background: var(--light-bg);
        border-radius: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        color: var(--text-light);
        border: 2px dashed rgba(102, 126, 234, 0.2);
    }

    .info-card {
        background: white;
        border-radius: 30px;
        padding: 25px;
        box-shadow: var(--shadow-md);
        margin-bottom: 30px;
    }

    .info-card h4 {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .info-card h4 i {
        color: var(--primary);
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-label {
        color: var(--text-light);
        font-weight: 300;
    }

    .info-value {
        font-weight: 500;
        color: var(--text-dark);
    }

    .badge {
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 0.85rem;
        display: inline-block;
    }

    .badge-categoria {
        background: #f0f2ff;
        color: var(--primary);
        border: 1px solid rgba(102, 126, 234, 0.2);
    }

    .review-table {
        background: white;
        border-radius: 30px;
        padding: 25px;
        box-shadow: var(--shadow-md);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        text-align: left;
        padding: 15px 12px;
        color: var(--text-light);
        font-weight: 500;
        font-size: 0.9rem;
        border-bottom: 2px solid rgba(102, 126, 234, 0.1);
    }

    td {
        padding: 15px 12px;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        color: var(--text-dark);
        vertical-align: middle;
    }

    tr:hover td {
        background: var(--light-bg);
    }

    .btn-sm {
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.85rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
    }

    .btn-sm-view {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

    .btn-sm-delete {
        background: linear-gradient(135deg, #f56565, #c53030);
        color: white;
    }

    .btn-sm-view:hover, .btn-sm-delete:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        color: white;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: white;
        border: 2px solid rgba(102, 126, 234, 0.1);
        border-radius: 50px;
        color: var(--text-dark);
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .back-btn:hover {
        border-color: var(--primary);
        transform: translateX(-5px);
    }

    .star-rating {
        color: #ffd700;
    }
    
    .btn-delete-product {
        width: 100%;
        text-align: center;
        justify-content: center;
    }
    
    .review-comment {
        max-width: 300px;
        word-wrap: break-word;
    }
    
    /* Estilos para mensagens flash */
    .alert {
        padding: 15px 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        border: none;
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    .alert-success {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        color: #155724;
        border-left: 4px solid #28a745;
    }
    
    .alert-danger {
        background: linear-gradient(135deg, #f8d7da, #f5c6cb);
        color: #721c24;
        border-left: 4px solid #dc3545;
    }
    
    .btn-close {
        margin-left: auto;
        background: transparent;
        border: none;
        font-size: 1.2rem;
        cursor: pointer;
        opacity: 0.7;
        padding: 0;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .btn-close:hover {
        opacity: 1;
    }
    
    .d-flex {
        display: flex;
    }
    
    .gap-2 {
        gap: 8px;
    }
    
    .gap-3 {
        gap: 16px;
    }
    
    .text-center {
        text-align: center;
    }
    
    .py-5 {
        padding-top: 3rem;
        padding-bottom: 3rem;
    }
    
    .py-4 {
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
    }
    
    .mt-3 {
        margin-top: 1rem;
    }
    
    .mt-4 {
        margin-top: 1.5rem;
    }
    
    .mb-3 {
        margin-bottom: 1rem;
    }
    
    .mb-4 {
        margin-bottom: 1.5rem;
    }
    
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 15px;
    }
    
    .fw-light {
        font-weight: 300;
    }
    
    .text-muted {
        color: var(--text-light);
    }
    
    .row {
        display: flex;
        flex-wrap: wrap;
        margin: 0 -15px;
    }
    
    .col-md-4, .col-md-8 {
        flex: 0 0 auto;
        padding: 0 15px;
    }
    
    .col-md-4 { width: 33.333%; }
    .col-md-8 { width: 66.666%; }
    
    .d-grid {
        display: grid;
    }
    
    .gap-2 {
        gap: 8px;
    }
    
    .d-block {
        display: block;
    }
    
    .align-items-center {
        align-items: center;
    }
    
    @media (max-width: 768px) {
        .col-md-4, .col-md-8 {
            width: 100%;
        }
        
        .review-comment {
            max-width: 150px;
        }
    }
</style>

<!-- Header -->
<section class="header-section">
    <div class="container">
        <a href="/admin/produtos" class="back-btn mb-4">
            <i class="bi bi-arrow-left"></i> Voltar para lista de produtos
        </a>
        
        <div class="row align-items-center mt-4">
            <div class="col-md-4">
                <% 
                    // Função para determinar a URL da imagem
                    let imageUrl = null;
                    if (typeof produto !== 'undefined' && produto.imagem && produto.imagem.trim() !== '') {
                        // Verifica se é uma URL completa (http:// ou https://)
                        if (produto.imagem.startsWith('http://') || produto.imagem.startsWith('https://')) {
                            imageUrl = produto.imagem;
                        } 
                        // Verifica se é um caminho local que começa com /
                        else if (produto.imagem.startsWith('/')) {
                            imageUrl = produto.imagem;
                        }
                        // Caso contrário, assume que é apenas o nome do arquivo na pasta uploads
                        else {
                            imageUrl = `/uploads/produtos/${produto.imagem}`;
                        }
                    }
                %>
                <% if (imageUrl) { %>
                    <img src="<%= imageUrl %>" 
                         class="product-image" 
                         alt="<%= produto.name %>"
                         onerror="this.style.display='none'; this.parentElement.querySelector('.image-placeholder').style.display='flex';">
                    <div class="image-placeholder" style="display: none;">
                        <i class="bi bi-image"></i>
                    </div>
                <% } else { %>
                    <div class="image-placeholder">
                        <i class="bi bi-image"></i>
                    </div>
                <% } %>
            </div>
            <div class="col-md-8">
                <h1 class="fw-light mb-3"><%= produto.name %></h1>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="badge badge-categoria"><%= produto.categoria %></span>
                    <span class="star-rating">
                        <% if (produto.media_avaliacoes) { %>
                            <%= Number(produto.media_avaliacoes).toFixed(1) %> ⭐
                        <% } else { %>
                            Sem avaliações
                        <% } %>
                    </span>
                </div>
                <p class="text-muted"><%= produto.description || 'Sem descrição' %></p>
            </div>
        </div>
    </div>
</section>

<!-- Conteúdo -->
<div class="container">
    <!-- Mensagens Flash - CORRIGIDAS -->
    <% if (locals.errors && errors && errors.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <%= Array.isArray(errors) ? errors[0] : errors %>
            <button type="button" class="btn-close" onclick="this.parentElement.style.display='none';">×</button>
        </div>
    <% } %>

    <% if (locals.success && success && success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= Array.isArray(success) ? success[0] : success %>
            <button type="button" class="btn-close" onclick="this.parentElement.style.display='none';">×</button>
        </div>
    <% } %>

    <div class="row">
        <!-- Coluna da Esquerda - Informações do Produto -->
        <div class="col-md-4">
            <div class="info-card">
                <h4><i class="bi bi-info-circle"></i> Informações do Produto</h4>
                
                <div class="info-row">
                    <span class="info-label">ID:</span>
                    <span class="info-value">#<%= produto.id %></span>
                </div>
                
                <div class="info-row">
                    <span class="info-label">Vendedor:</span>
                    <span class="info-value">
                        <a href="/admin/usuarios/<%= produto.vendedor_id %>" style="color: var(--primary); text-decoration: none;">
                            <%= produto.vendedor_email %>
                        </a>
                    </span>
                </div>
                
                <div class="info-row">
                    <span class="info-label">Preço:</span>
                    <span class="info-value">R$ <%= Number(produto.price).toFixed(2) %></span>
                </div>
                
                <div class="info-row">
                    <span class="info-label">Estoque:</span>
                    <span class="info-value"><%= produto.estoque || 0 %> unidades</span>
                </div>
                
                <div class="info-row">
                    <span class="info-label">Categoria:</span>
                    <span class="info-value"><%= produto.categoria %></span>
                </div>
                
                <div class="info-row">
                    <span class="info-label">Criado em:</span>
                    <span class="info-value"><%= new Date(produto.data_criacao).toLocaleDateString('pt-BR') %></span>
                </div>
            </div>
            
            <div class="info-card">
                <h4><i class="bi bi-bar-chart"></i> Estatísticas</h4>
                
                <div class="info-row">
                    <span class="info-label">Total de avaliações:</span>
                    <span class="info-value"><%= typeof avaliacoes !== 'undefined' ? avaliacoes.length : 0 %></span>
                </div>
                
                <div class="info-row">
                    <span class="info-label">Média de avaliações:</span>
                    <span class="info-value star-rating">
                        <% if (produto.media_avaliacoes) { %>
                            <%= Number(produto.media_avaliacoes).toFixed(1) %> ⭐
                        <% } else { %>
                            -
                        <% } %>
                    </span>
                </div>
            </div>
            
            <!-- Ações Rápidas -->
            <div class="d-grid gap-2">
                <a href="/admin/produtos/<%= produto.id %>/deletar?redirect=/admin/produtos" 
                   class="btn-sm btn-sm-delete btn-delete-product"
                   onclick="return confirm('Tem certeza que deseja deletar este produto? Todas as avaliações também serão removidas. Esta ação não pode ser desfeita.')">
                    <i class="bi bi-trash"></i> Deletar Produto
                </a>
            </div>
        </div>
        
        <!-- Coluna da Direita - Avaliações -->
        <div class="col-md-8">
            <div class="review-table">
                <h4><i class="bi bi-star"></i> Avaliações do Produto (<%= typeof avaliacoes !== 'undefined' ? avaliacoes.length : 0 %>)</h4>
                
                <% if (typeof avaliacoes !== 'undefined' && avaliacoes && avaliacoes.length > 0) { %>
                    <div class="table-responsive" style="overflow-x: auto;">
                        <table style="min-width: 500px;">
                            <thead>
                                <tr>
                                    <th>Avaliador</th>
                                    <th>Nota</th>
                                    <th>Comentário</th>
                                    <th>Data</th>
                                    <th>Ação</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% avaliacoes.forEach(av => { %>
                                <tr>
                                    <td><%= av.avaliador_email ? av.avaliador_email.split('@')[0] : 'Anônimo' %></td>
                                    <td class="star-rating"><%= av.nota %> ⭐</td>
                                    <td class="review-comment"><%= av.comentario || '-' %></td>
                                    <td><%= new Date(av.data_avaliacao).toLocaleDateString('pt-BR') %></td>
                                    <td>
                                        <a href="/admin/avaliacao/<%= av.id %>/deletar?redirect=/admin/produtos/<%= produto.id %>" 
                                           class="btn-sm btn-sm-delete"
                                           style="text-decoration: none;"
                                           onclick="return confirm('Deletar esta avaliação?')">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="bi bi-chat-dots" style="font-size: 3rem; color: var(--text-light);"></i>
                        <p class="text-muted mt-3">Este produto não possui avaliações ainda.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../includes/footer') %>