<%- include('../includes/head') %>
<%- include('../includes/nav1') %>

<style>
    /* ===== VARIÁVEIS ===== */
    :root {
        --primary: #667eea;
        --secondary: #764ba2;
        --light-bg: #fafaff;
        --text-dark: #2d3436;
        --text-light: #636e72;
        --shadow-sm: 0 5px 20px rgba(0,0,0,0.02);
        --shadow-md: 0 10px 30px rgba(102, 126, 234, 0.05);
        --shadow-lg: 0 20px 40px rgba(102, 126, 234, 0.08);
        --gradient: linear-gradient(135deg, var(--primary), var(--secondary));
        --success: #48bb78;
        --danger: #f56565;
        --warning: #ecc94b;
    }

    /* ===== CHAT CONTAINER ===== */
    .chat-admin-container {
        height: calc(100vh - 180px);
        min-height: 600px;
        background: white;
        border-radius: 30px;
        overflow: hidden;
        box-shadow: var(--shadow-lg);
        margin: 30px 0;
    }

    /* ===== SIDEBAR ===== */
    .chat-sidebar {
        background: white;
        border-right: 1px solid rgba(102, 126, 234, 0.1);
        height: 100%;
        overflow-y: auto;
    }

    .chat-sidebar-header {
        padding: 20px;
        border-bottom: 1px solid rgba(102, 126, 234, 0.1);
        background: var(--light-bg);
    }

    .chat-sidebar-header h4 {
        font-size: 1.2rem;
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .chat-sidebar-header h4 i {
        color: var(--primary);
    }

    .chat-user-item {
        padding: 15px 20px;
        border-bottom: 1px solid rgba(102, 126, 234, 0.05);
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
    }

    .chat-user-item:hover {
        background: var(--light-bg);
    }

    .chat-user-item.active {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.05), rgba(118, 75, 162, 0.05));
        border-left: 3px solid var(--primary);
    }

    .chat-user-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
        background: var(--light-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--primary);
    }

    .chat-user-info {
        flex: 1;
        min-width: 0;
    }

    .chat-user-name {
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 3px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .chat-user-email {
        font-size: 0.75rem;
        color: var(--text-light);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .chat-user-last-message {
        font-size: 0.8rem;
        color: var(--text-light);
        margin-top: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 180px;
    }

    .unread-badge {
        background: var(--danger);
        color: white;
        border-radius: 50%;
        min-width: 20px;
        height: 20px;
        font-size: 0.7rem;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 5px;
    }

    /* ===== CHAT AREA ===== */
    .chat-area {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: white;
    }

    .chat-area-header {
        padding: 20px;
        border-bottom: 1px solid rgba(102, 126, 234, 0.1);
        background: white;
    }

    .chat-area-header h5 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .chat-area-header h5 i {
        color: var(--primary);
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        background: var(--light-bg);
    }

    .message-wrapper {
        margin-bottom: 15px;
        animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .message {
        max-width: 70%;
        padding: 12px 16px;
        border-radius: 18px;
        position: relative;
        word-wrap: break-word;
        font-size: 0.95rem;
    }

    .message.sent {
        background: var(--gradient);
        color: white;
        margin-left: auto;
        border-bottom-right-radius: 5px;
    }

    .message.received {
        background: white;
        color: var(--text-dark);
        margin-right: auto;
        border-bottom-left-radius: 5px;
        box-shadow: var(--shadow-sm);
    }

    .message .sender-name {
        font-size: 0.7rem;
        opacity: 0.7;
        margin-bottom: 3px;
    }

    .message .time {
        font-size: 0.65rem;
        opacity: 0.6;
        margin-top: 5px;
        text-align: right;
    }

    .message.sent .time {
        color: rgba(255,255,255,0.8);
    }

    /* ===== INPUT AREA ===== */
    .chat-input-area {
        padding: 20px;
        border-top: 1px solid rgba(102, 126, 234, 0.1);
        background: white;
    }

    .chat-input-wrapper {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .chat-input-wrapper input {
        flex: 1;
        border: 2px solid rgba(102, 126, 234, 0.1);
        border-radius: 25px;
        padding: 12px 20px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

    .chat-input-wrapper input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .chat-input-wrapper button {
        background: var(--gradient);
        border: none;
        color: white;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .chat-input-wrapper button:hover {
        transform: scale(1.05);
        box-shadow: var(--shadow-md);
    }

    .typing-indicator {
        padding: 8px 20px;
        font-size: 0.8rem;
        color: var(--text-light);
        font-style: italic;
        background: var(--light-bg);
    }

    /* ===== EMPTY STATE ===== */
    .empty-chat {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #adb5bd;
    }

    .empty-chat i {
        font-size: 5rem;
        margin-bottom: 20px;
        opacity: 0.5;
    }

    .empty-chat h5 {
        font-size: 1.2rem;
        margin-bottom: 10px;
        color: var(--text-dark);
    }

    .empty-chat p {
        font-size: 0.9rem;
    }

    /* ===== RESPONSIVIDADE ===== */
    @media (max-width: 768px) {
        .chat-sidebar {
            position: absolute;
            left: -100%;
            width: 80%;
            z-index: 100;
            transition: left 0.3s ease;
            background: white;
        }
        
        .chat-sidebar.show {
            left: 0;
        }
        
        .message {
            max-width: 85%;
        }
    }
</style>

<!-- Header -->
<section class="page-header" style="padding: 40px 0;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="fw-light">Chat <span class="fw-bold" style="background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Administrativo</span></h1>
                <p class="text-muted">Atenda seus clientes em tempo real</p>
            </div>
            <a href="/admin" class="btn-elegante outline">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>
    </div>
</section>

<div class="container">
    <div class="chat-admin-container">
        <div class="row g-0 h-100">
            <!-- Sidebar de Usuários -->
            <div class="col-md-4 chat-sidebar" id="usersSidebar">
                <div class="chat-sidebar-header">
                    <h4>
                        <i class="bi bi-people"></i>
                        Conversas
                    </h4>
                </div>
                <div id="userList">
                    <% if (usuarios && usuarios.length > 0) { %>
                        <% usuarios.forEach(function(user) { %>
                        <div class="chat-user-item" data-user-id="<%= user.id %>" data-user-name="<%= user.email.split('@')[0] %>">
                            <div class="chat-user-avatar">
                                <% if (user.avatar) { %>
                                    <img src="/<%= user.avatar %>" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                                <% } else { %>
                                    <i class="bi bi-person-circle"></i>
                                <% } %>
                            </div>
                            <div class="chat-user-info">
                                <div class="chat-user-name">
                                    <span><%= user.email.split('@')[0] %></span>
                                    <% if (user.unread_count > 0) { %>
                                        <span class="unread-badge"><%= user.unread_count %></span>
                                    <% } %>
                                </div>
                                <div class="chat-user-email"><%= user.email %></div>
                                <div class="chat-user-last-message">
                                    <%= user.last_message ? user.last_message.substring(0, 40) + '...' : 'Nenhuma mensagem' %>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    <% } else { %>
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-chat-dots"></i>
                            <p class="mt-2">Nenhuma conversa ainda</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Área do Chat -->
            <div class="col-md-8 chat-area">
                <div class="chat-area-header">
                    <h5 id="chatHeaderTitle">
                        <i class="bi bi-chat-dots"></i>
                        Selecione uma conversa
                    </h5>
                </div>

                <div class="chat-messages" id="chatMessages">
                    <div class="empty-chat">
                        <i class="bi bi-chat"></i>
                        <h5>Nenhuma conversa selecionada</h5>
                        <p>Clique em um usuário para iniciar o atendimento</p>
                    </div>
                </div>

                <div class="typing-indicator d-none" id="typingIndicator">
                    <span id="typingText"></span>
                </div>

                <div class="chat-input-area">
                    <div class="chat-input-wrapper">
                        <input type="text" id="messageInput" placeholder="Digite sua mensagem..." disabled>
                        <button id="sendButton" disabled>
                            <i class="bi bi-send"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    (function() {
        // Configuração
        var userId = '<%= user.id %>';
        var userEmail = '<%= user.email %>';
        var isAdmin = true;
        
        // Elementos DOM
        var chatMessages = document.getElementById('chatMessages');
        var messageInput = document.getElementById('messageInput');
        var sendButton = document.getElementById('sendButton');
        var typingIndicator = document.getElementById('typingIndicator');
        var typingText = document.getElementById('typingText');
        var chatHeaderTitle = document.getElementById('chatHeaderTitle');
        
        var currentUserId = null;
        var currentUserName = null;
        var typingTimeout = null;
        var socket = null;
        var mensagensRecebidas = {}; // Para evitar duplicação
        
        // Função para formatar hora
        function formatarHora(dataISO) {
            var data = new Date(dataISO);
            return data.toLocaleTimeString('pt-BR', {
                hour: '2-digit',
                minute: '2-digit'
            });
        }
        
        // Escapar HTML
        function escapeHtml(text) {
            var div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        // Exibir mensagem (com verificação de duplicidade)
        function displayMessage(message) {
            // Verificar se a mensagem já foi exibida
            if (mensagensRecebidas[message.id]) {
                return;
            }
            mensagensRecebidas[message.id] = true;
            
            var isSent = (message.sender_id == userId);
            var div = document.createElement('div');
            div.className = 'message-wrapper';
            
            var html = '<div class="message ' + (isSent ? 'sent' : 'received') + '">';
            
            if (!isSent) {
                html += '<div class="sender-name">' + escapeHtml(message.sender_name) + '</div>';
            }
            
            html += '<div>' + escapeHtml(message.message) + '</div>';
            html += '<div class="time">' + formatarHora(message.created_at) + '</div>';
            html += '</div>';
            
            div.innerHTML = html;
            chatMessages.appendChild(div);
            scrollToBottom();
        }
        
        function scrollToBottom() {
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }
        
        // Limpar mensagens da conversa atual
        function limparMensagens() {
            chatMessages.innerHTML = '';
            // Resetar cache de mensagens recebidas ao trocar de conversa
            mensagensRecebidas = {};
        }
        
        // Enviar mensagem
        function sendMessage() {
            var message = messageInput.value.trim();
            if (!message) return;
            if (!currentUserId) return;
            
            socket.emit('send_message', {
                message: message,
                userId: currentUserId
            });
            
            messageInput.value = '';
        }
        
        // Inicializar socket
        function initSocket() {
            socket = io({
                auth: {
                    userId: userId,
                    userEmail: userEmail,
                    isAdmin: 'true'
                }
            });
            
            socket.on('connect', function() {
                console.log('✅ Conectado ao chat');
            });
            
            socket.on('message_history', function(messages) {
                limparMensagens();
                if (messages.length === 0) {
                    chatMessages.innerHTML = '<div class="empty-chat"><i class="bi bi-chat"></i><h5>Nenhuma mensagem ainda</h5><p>Inicie uma conversa</p></div>';
                } else {
                    for (var i = 0; i < messages.length; i++) {
                        displayMessage(messages[i]);
                    }
                }
            });
            
            socket.on('historico_conversa', function(data) {
                if (data.userId == currentUserId) {
                    limparMensagens();
                    if (data.messages.length === 0) {
                        chatMessages.innerHTML = '<div class="empty-chat"><i class="bi bi-chat"></i><h5>Nenhuma mensagem ainda</h5><p>Inicie uma conversa</p></div>';
                    } else {
                        for (var i = 0; i < data.messages.length; i++) {
                            displayMessage(data.messages[i]);
                        }
                    }
                }
            });
            
            socket.on('receive_message', function(message) {
                // Verificar se a mensagem pertence à conversa atual
                if (currentUserId && (message.sender_id == currentUserId || message.sender_id == userId)) {
                    if (chatMessages.querySelector('.empty-chat')) {
                        chatMessages.innerHTML = '';
                    }
                    displayMessage(message);
                }
            });
            
            socket.on('user_typing', function(data) {
                if (data.userId == currentUserId) {
                    if (data.isTyping) {
                        typingText.textContent = data.userName + ' está digitando...';
                        typingIndicator.classList.remove('d-none');
                    } else {
                        typingIndicator.classList.add('d-none');
                    }
                }
            });
            
            socket.on('lista_usuarios', function(usuarios) {
                atualizarListaUsuarios(usuarios);
            });
        }
        
        // Atualizar lista de usuários
        function atualizarListaUsuarios(usuarios) {
            var userList = document.getElementById('userList');
            if (!userList) return;
            
            if (usuarios.length === 0) {
                userList.innerHTML = '<div class="p-4 text-center text-muted"><i class="bi bi-chat-dots"></i><p class="mt-2">Nenhuma conversa ainda</p></div>';
                return;
            }
            
            userList.innerHTML = '';
            for (var i = 0; i < usuarios.length; i++) {
                var user = usuarios[i];
                var div = document.createElement('div');
                div.className = 'chat-user-item' + (currentUserId == user.id ? ' active' : '');
                div.setAttribute('data-user-id', user.id);
                div.setAttribute('data-user-name', user.email.split('@')[0]);
                
                var avatarHtml = '';
                if (user.avatar) {
                    avatarHtml = '<img src="/' + escapeHtml(user.avatar) + '" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">';
                } else {
                    avatarHtml = '<i class="bi bi-person-circle"></i>';
                }
                
                var unreadHtml = '';
                if (user.unread_count > 0) {
                    unreadHtml = '<span class="unread-badge">' + user.unread_count + '</span>';
                }
                
                var lastMessageHtml = user.last_message ? escapeHtml(user.last_message.substring(0, 40)) + '...' : 'Nenhuma mensagem';
                
                div.innerHTML = `
                    <div class="chat-user-avatar">
                        ${avatarHtml}
                    </div>
                    <div class="chat-user-info">
                        <div class="chat-user-name">
                            <span>${escapeHtml(user.email.split('@')[0])}</span>
                            ${unreadHtml}
                        </div>
                        <div class="chat-user-email">${escapeHtml(user.email)}</div>
                        <div class="chat-user-last-message">${lastMessageHtml}</div>
                    </div>
                `;
                
                div.addEventListener('click', function() {
                    var items = document.querySelectorAll('.chat-user-item');
                    for (var j = 0; j < items.length; j++) {
                        items[j].classList.remove('active');
                    }
                    this.classList.add('active');
                    
                    currentUserId = this.dataset.userId;
                    currentUserName = this.dataset.userName;
                    
                    chatHeaderTitle.innerHTML = '<i class="bi bi-person"></i> Conversando com ' + currentUserName;
                    messageInput.disabled = false;
                    sendButton.disabled = false;
                    
                    // Limpar mensagens anteriores e carregar nova conversa
                    limparMensagens();
                    chatMessages.innerHTML = '<div class="empty-chat"><i class="bi bi-chat"></i><h5>Carregando...</h5></div>';
                    
                    if (socket) {
                        socket.emit('join_user_room', { userId: currentUserId });
                    }
                });
                
                userList.appendChild(div);
            }
        }
        
        // Event listeners
        if (sendButton) {
            sendButton.addEventListener('click', sendMessage);
        }
        
        if (messageInput) {
            messageInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    sendMessage();
                }
                
                if (socket && currentUserId) {
                    socket.emit('typing', {
                        isTyping: true,
                        userId: currentUserId
                    });
                    
                    clearTimeout(typingTimeout);
                    typingTimeout = setTimeout(function() {
                        socket.emit('typing', {
                            isTyping: false,
                            userId: currentUserId
                        });
                    }, 1000);
                }
            });
        }
        
        // Iniciar
        initSocket();
    })();
</script>

<%- include('../includes/footer') %>