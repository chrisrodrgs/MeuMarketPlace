<%- include('../includes/head') %>
<%- include('../includes/nav1') %>

<!-- Header -->
<section class="hero-section" style="min-height: 40vh; padding: 60px 0;">
    <div class="container text-center">
        <h1 class="hero-title">
            Painel do <span>Administrador</span>
        </h1>
        <p class="hero-subtitle mx-auto">Gerencie usuários, produtos, avaliações e atendimento</p>
    </div>
</section>

<!-- Conteúdo Principal -->
<div class="container py-5">
    <!-- Mensagens Flash -->
    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <%= errors %>
        </div>
    <% } %>
    
    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= success %>
        </div>
    <% } %>

    <!-- Cards de Estatísticas -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card-elegante">
                <i class="bi bi-people"></i>
                <h3><%= totalUsuarios %></h3>
                <p>Usuários totais</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-elegante">
                <i class="bi bi-box"></i>
                <h3><%= totalProdutos %></h3>
                <p>Produtos</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-elegante">
                <i class="bi bi-shield"></i>
                <h3><%= totalAdmins %></h3>
                <p>Administradores</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-elegante">
                <i class="bi bi-star"></i>
                <h3><%= totalAvaliacoes %></h3>
                <p>Avaliações</p>
            </div>
        </div>
    </div>

    <!-- Ações Rápidas -->
    <div class="row g-3 mb-5">
        <div class="col-md-2">
            <a href="/admin/usuarios" class="action-btn">
                <i class="bi bi-people"></i>
                <h5>Usuários</h5>
            </a>
        </div>
        <div class="col-md-2">
            <a href="/admin/produtos" class="action-btn">
                <i class="bi bi-box"></i>
                <h5>Produtos</h5>
            </a>
        </div>
        <div class="col-md-2">
            <a href="/admin/avaliacoes" class="action-btn">
                <i class="bi bi-star"></i>
                <h5>Avaliações</h5>
            </a>
        </div>
        <div class="col-md-2">
            <a href="/admin/chat" class="action-btn chat-btn">
                <i class="bi bi-chat-dots"></i>
                <h5>Chat</h5>
            </a>
        </div>
        <div class="col-md-2">
            <a href="/admin/analytics" class="action-btn analytics-btn">
                <i class="bi bi-graph-up"></i>
                <h5>Dados</h5>
            </a>
        </div>
        <div class="col-md-2">
            <a href="/admin/cupons" class="action-btn">
                <i class="bi bi-tags"></i>
                <h5>Cupons</h5>
            </a>
        </div>
        <div class="col-md-2">
            <a href="/admin/banners" class="action-btn">
                <i class="bi bi-images"></i>
                <h5>Banners</h5>
            </a>
        </div>
        <div class="col-md-2">
            <a href="/admin/promocoes-produtos" class="action-btn">
                <i class="bi bi-fire"></i>
                <h5>Promoções</h5>
            </a>
        </div>
        <div class="col-md-2">
            <a href="/" class="action-btn">
                <i class="bi bi-house"></i>
                <h5>Site</h5>
            </a>
        </div>
    </div>

    <!-- Últimos Usuários -->
    <div class="card-elegante mb-4">
        <div class="card-header bg-gradient-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Últimos Usuários</h5>
                <a href="/admin/usuarios" class="btn btn-sm btn-light">Ver todos</a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Email</th>
                            <th>Tipo</th>
                            <th>Data</th>
                            <th>Ações</th>
                        </thead>
                        <tbody>
                            <% if (ultimosUsuarios && ultimosUsuarios.length > 0) { %>
                                <% ultimosUsuarios.forEach(function(user) { %>
                                <tr>
                                    <td><%= user.id %></td>
                                    <td><%= user.email %></td>
                                    <td>
                                        <% if (user.isAdmin) { %>
                                            <span class="badge bg-danger">Admin</span>
                                        <% } else { %>
                                            <span class="badge bg-primary">Usuário</span>
                                        <% } %>
                                    </td>
                                    <td><%= new Date(user.data_criacao).toLocaleDateString('pt-BR') %></td>
                                    <td>
                                        <a href="/admin/usuarios/<%= user.id %>" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="5" class="text-center">Nenhum usuário encontrado</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Últimos Produtos -->
    <div class="card-elegante mb-4">
        <div class="card-header bg-gradient-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Últimos Produtos</h5>
                <a href="/admin/produtos" class="btn btn-sm btn-light">Ver todos</a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                         <tr>
                            <th>ID</th>
                            <th>Produto</th>
                            <th>Vendedor</th>
                            <th>Preço</th>
                            <th>Data</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (ultimosProdutos && ultimosProdutos.length > 0) { %>
                            <% ultimosProdutos.forEach(function(prod) { %>
                            <tr>
                                <td><%= prod.id %></td>
                                <td><%= prod.name %></td>
                                <td><%= prod.vendedor_email.split('@')[0] %></td>
                                <td>R$ <%= Number(prod.price).toFixed(2) %></td>
                                <td><%= new Date(prod.data_criacao).toLocaleDateString('pt-BR') %></td>
                                <td>
                                    <a href="/admin/produtos/<%= prod.id %>" class="btn btn-sm btn-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="6" class="text-center">Nenhum produto encontrado</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Produtos Mais Avaliados -->
    <div class="card-elegante">
        <div class="card-header bg-gradient-primary text-white">
            <h5 class="mb-0"><i class="bi bi-star me-2"></i>Produtos Mais Avaliados</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Preço</th>
                            <th>Avaliações</th>
                            <th>Média</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (produtosMaisAvaliados && produtosMaisAvaliados.length > 0) { %>
                            <% produtosMaisAvaliados.forEach(function(prod) { %>
                            <tr>
                                <td><%= prod.name %></td>
                                <td>R$ <%= Number(prod.price).toFixed(2) %></td>
                                <td><%= prod.total_avaliacoes %></td>
                                <td>
                                    <% if (prod.media_avaliacoes) { %>
                                        <%= Number(prod.media_avaliacoes).toFixed(1) %> ⭐
                                    <% } else { %>
                                        -
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="4" class="text-center">Nenhum produto avaliado</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .action-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: white;
        border: 2px solid rgba(102, 126, 234, 0.1);
        border-radius: 20px;
        text-decoration: none;
        color: var(--text-dark);
        transition: all 0.3s ease;
        text-align: center;
    }
    .action-btn:hover {
        border-color: var(--primary);
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
    }
    .action-btn i {
        font-size: 2rem;
        color: var(--primary);
        margin-bottom: 10px;
    }
    .action-btn h5 {
        font-size: 0.9rem;
        font-weight: 500;
        margin: 0;
    }
    .chat-btn {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border-color: transparent;
        color: white;
    }
    .chat-btn i {
        color: white;
    }
    .analytics-btn {
        background: linear-gradient(135deg, #48bb78, #38a169);
        border-color: transparent;
        color: white;
    }
    .analytics-btn i {
        color: white;
    }
    .btn-sm {
        padding: 5px 10px;
        border-radius: 8px;
        font-size: 0.8rem;
    }
    .card-header .btn-sm {
        background: rgba(255,255,255,0.2);
        color: white;
    }
    .card-header .btn-sm:hover {
        background: rgba(255,255,255,0.3);
    }
</style>

<%- include('../includes/footer') %>