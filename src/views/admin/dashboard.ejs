<%- include('../includes/head') %>
<%- include('../includes/nav1') %>

<style>
    /* ===== VARIÁVEIS ===== */
    :root {
        --primary: #667eea;
        --secondary: #764ba2;
        --light-bg: #fafaff;
        --text-dark: #2d3436;
        --text-light: #636e72;
        --shadow-sm: 0 5px 20px rgba(0,0,0,0.02);
        --shadow-md: 0 10px 30px rgba(102, 126, 234, 0.05);
        --shadow-lg: 0 20px 40px rgba(102, 126, 234, 0.08);
        --gradient: linear-gradient(135deg, var(--primary), var(--secondary));
        --success: #48bb78;
        --danger: #f56565;
        --warning: #ecc94b;
    }

    /* ===== HEADER ===== */
    .admin-header {
        background: linear-gradient(135deg, #f5f0ff 0%, #f0f5ff 100%);
        padding: 60px 0;
        position: relative;
        overflow: hidden;
        margin-bottom: 40px;
    }

    .admin-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 100%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, transparent 60%);
        animation: spinSlow 90s linear infinite;
    }

    @keyframes spinSlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .admin-header h1 {
        font-size: 2.5rem;
        font-weight: 300;
        color: var(--text-dark);
        position: relative;
        z-index: 2;
    }

    .admin-header h1 span {
        font-weight: 700;
        background: var(--gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* ===== STATS CARDS ===== */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: white;
        border-radius: 30px;
        padding: 25px;
        box-shadow: var(--shadow-md);
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 20px;
        background: linear-gradient(135deg, rgba(102,126,234,0.1), rgba(118,75,162,0.1));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: var(--primary);
    }

    .stat-info h3 {
        font-size: 2rem;
        font-weight: 600;
        color: var(--text-dark);
        margin: 0;
        line-height: 1.2;
    }

    .stat-info p {
        color: var(--text-light);
        margin: 0;
        font-size: 0.9rem;
    }

    /* ===== AÇÕES RÁPIDAS ===== */
    .quick-actions {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 40px;
    }

    .action-btn {
        background: white;
        border: 2px solid rgba(102, 126, 234, 0.1);
        border-radius: 20px;
        padding: 20px;
        text-align: center;
        text-decoration: none;
        color: var(--text-dark);
        transition: all 0.3s ease;
    }

    .action-btn:hover {
        border-color: var(--primary);
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
    }

    .action-btn i {
        font-size: 2rem;
        color: var(--primary);
        margin-bottom: 10px;
    }

    .action-btn h5 {
        font-weight: 500;
        margin: 0;
    }

    /* ===== TABELAS ===== */
    .table-section {
        background: white;
        border-radius: 30px;
        padding: 25px;
        box-shadow: var(--shadow-md);
        margin-bottom: 30px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .section-header h4 {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--text-dark);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-header h4 i {
        color: var(--primary);
    }

    .table-responsive {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        text-align: left;
        padding: 12px;
        color: var(--text-light);
        font-weight: 500;
        font-size: 0.9rem;
        border-bottom: 2px solid rgba(102, 126, 234, 0.1);
    }

    td {
        padding: 12px;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        color: var(--text-dark);
    }

    tr:hover td {
        background: var(--light-bg);
    }

    .badge {
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .badge.admin {
        background: linear-gradient(135deg, #f56565, #c53030);
        color: white;
    }

    .badge.user {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

    .btn-sm {
        padding: 5px 10px;
        border-radius: 10px;
        font-size: 0.85rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.3s ease;
    }

    .btn-sm.view {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

    .btn-sm.delete {
        background: linear-gradient(135deg, #f56565, #c53030);
        color: white;
    }

    .btn-sm:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    /* ===== RESPONSIVIDADE ===== */
    @media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
        
        .quick-actions {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- Header -->
<section class="admin-header">
    <div class="container text-center">
        <h1>
            Painel do <span>Administrador</span>
        </h1>
        <p class="text-muted">Gerencie usuários, produtos e avaliações</p>
    </div>
</section>

<!-- Conteúdo Principal -->
<div class="container">
    <!-- Mensagens Flash -->
    <% if (typeof errors !== 'undefined' && errors) { %>
        <div class="alert alert-danger"><%= errors %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><%= success %></div>
    <% } %>

    <!-- Cards de Estatísticas -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-people"></i>
            </div>
            <div class="stat-info">
                <h3><%= totalUsuarios %></h3>
                <p>Usuários totais</p>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-box"></i>
            </div>
            <div class="stat-info">
                <h3><%= totalProdutos %></h3>
                <p>Produtos</p>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-shield"></i>
            </div>
            <div class="stat-info">
                <h3><%= totalAdmins %></h3>
                <p>Administradores</p>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-star"></i>
            </div>
            <div class="stat-info">
                <h3><%= totalAvaliacoes %></h3>
                <p>Avaliações</p>
            </div>
        </div>
    </div>

    <!-- Ações Rápidas -->
    <div class="quick-actions">
        <a href="/admin/usuarios" class="action-btn">
            <i class="bi bi-people"></i>
            <h5>Gerenciar Usuários</h5>
        </a>
        <a href="/admin/produtos" class="action-btn">
            <i class="bi bi-box"></i>
            <h5>Gerenciar Produtos</h5>
        </a>
        <a href="/admin/avaliacoes" class="action-btn">
            <i class="bi bi-star"></i>
            <h5>Gerenciar Avaliações</h5>
        </a>
        <a href="/" class="action-btn">
            <i class="bi bi-house"></i>
            <h5>Ver Site</h5>
        </a>
    </div>

    <!-- Últimos Usuários -->
    <div class="table-section">
        <div class="section-header">
            <h4><i class="bi bi-clock-history"></i> Últimos Usuários Cadastrados</h4>
            <a href="/admin/usuarios" class="btn-sm view">Ver todos <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Tipo</th>
                        <th>Data</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% ultimosUsuarios.forEach(user => { %>
                    <tr>
                        <td><%= user.id %></td>
                        <td><%= user.email %></td>
                        <td>
                            <% if (user.isAdmin) { %>
                                <span class="badge admin">Admin</span>
                            <% } else { %>
                                <span class="badge user">Usuário</span>
                            <% } %>
                        </td>
                        <td><%= new Date(user.data_criacao).toLocaleDateString('pt-BR') %></td>
                        <td>
                            <a href="/admin/usuarios/<%= user.id %>" class="btn-sm view">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Últimos Produtos -->
    <div class="table-section">
        <div class="section-header">
            <h4><i class="bi bi-clock-history"></i> Últimos Produtos</h4>
            <a href="/admin/produtos" class="btn-sm view">Ver todos <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Produto</th>
                        <th>Vendedor</th>
                        <th>Preço</th>
                        <th>Data</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% ultimosProdutos.forEach(prod => { %>
                    <tr>
                        <td><%= prod.id %></td>
                        <td><%= prod.name %></td>
                        <td><%= prod.vendedor_email.split('@')[0] %></td>
                        <td>R$ <%= Number(prod.price).toFixed(2) %></td>
                        <td><%= new Date(prod.data_criacao).toLocaleDateString('pt-BR') %></td>
                        <td>
                            <a href="/admin/produtos/<%= prod.id %>" class="btn-sm view">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Produtos Mais Avaliados -->
    <div class="table-section">
        <div class="section-header">
            <h4><i class="bi bi-star"></i> Produtos Mais Avaliados</h4>
        </div>
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Produto</th>
                        <th>Preço</th>
                        <th>Avaliações</th>
                        <th>Média</th>
                    </tr>
                </thead>
                <tbody>
                    <% produtosMaisAvaliados.forEach(prod => { %>
                    <tr>
                        <td><%= prod.name %></td>
                        <td>R$ <%= Number(prod.price).toFixed(2) %></td>
                        <td><%= prod.total_avaliacoes %></td>
                        <td>
                            <% if (prod.media_avaliacoes) { %>
                                <%= Number(prod.media_avaliacoes).toFixed(1) %> ⭐
                            <% } else { %>
                                -
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../includes/footer') %>