<%- include('../includes/head') %>
<%- include('../includes/nav1') %>

<style>
    /* ===== VARIÁVEIS ===== */
    :root {
        --primary: #667eea;
        --secondary: #764ba2;
        --light-bg: #fafaff;
        --text-dark: #2d3436;
        --text-light: #636e72;
        --shadow-sm: 0 5px 20px rgba(0,0,0,0.02);
        --shadow-md: 0 10px 30px rgba(102, 126, 234, 0.05);
        --shadow-lg: 0 20px 40px rgba(102, 126, 234, 0.08);
        --gradient: linear-gradient(135deg, var(--primary), var(--secondary));
    }

    .header-section {
        background: linear-gradient(135deg, #f5f0ff 0%, #f0f5ff 100%);
        padding: 40px 0;
        margin-bottom: 30px;
    }

    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 24px;
        padding: 20px;
        text-align: center;
        box-shadow: var(--shadow-md);
        transition: all 0.3s ease;
        border: 1px solid rgba(102, 126, 234, 0.1);
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
        border-color: rgba(102, 126, 234, 0.3);
    }

    .stat-card i {
        font-size: 2.5rem;
        background: var(--gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 10px;
        display: inline-block;
    }

    .stat-card h3 {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 5px;
    }

    .stat-card p {
        color: var(--text-light);
        margin: 0;
        font-size: 0.85rem;
    }

    .filter-section {
        background: white;
        border-radius: 30px;
        padding: 20px;
        box-shadow: var(--shadow-md);
        margin-bottom: 30px;
    }

    .search-box, .filter-select {
        border: 2px solid rgba(102, 126, 234, 0.1);
        border-radius: 50px;
        padding: 10px 20px;
        width: 100%;
        transition: all 0.3s ease;
        background: white;
    }

    .search-box:focus, .filter-select:focus {
        border-color: var(--primary);
        outline: none;
        box-shadow: var(--shadow-md);
    }

    .table-section {
        background: white;
        border-radius: 30px;
        padding: 25px;
        box-shadow: var(--shadow-md);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        text-align: left;
        padding: 15px 12px;
        color: var(--text-light);
        font-weight: 500;
        font-size: 0.9rem;
        border-bottom: 2px solid rgba(102, 126, 234, 0.1);
    }

    td {
        padding: 15px 12px;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        color: var(--text-dark);
        vertical-align: middle;
    }

    tr:hover td {
        background: var(--light-bg);
    }

    .user-avatar-sm {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
    }

    .product-image-sm {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        object-fit: cover;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
    }

    .image-placeholder-sm {
        width: 50px;
        height: 50px;
        background: #f8f9fa;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #adb5bd;
        border: 1px solid #e9ecef;
    }

    .badge {
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 500;
    }

    .badge-nota {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: white;
    }

    .badge-nota-alta {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
    }

    .badge-nota-media {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: white;
    }

    .badge-nota-baixa {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
    }

    .badge-produto {
        background: var(--light-bg);
        color: var(--primary);
        border: 1px solid rgba(102, 126, 234, 0.2);
    }

    .btn-sm {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.85rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
    }

    .btn-sm-view {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

    .btn-sm-delete {
        background: linear-gradient(135deg, #f56565, #c53030);
        color: white;
    }

    .btn-sm-view:hover, .btn-sm-delete:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        color: white;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 30px;
    }

    .page-item {
        padding: 8px 15px;
        border: 2px solid rgba(102, 126, 234, 0.1);
        border-radius: 10px;
        color: var(--text-dark);
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .page-item:hover,
    .page-item.active {
        background: var(--gradient);
        border-color: transparent;
        color: white;
    }

    .star-rating {
        color: #ffd700;
        font-size: 0.9rem;
    }

    .review-comment {
        max-width: 300px;
        word-wrap: break-word;
        line-height: 1.4;
    }

    /* Estilos para mensagens flash */
    .alert {
        padding: 15px 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        border: none;
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    .alert-success {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        color: #155724;
        border-left: 4px solid #28a745;
    }
    
    .alert-danger {
        background: linear-gradient(135deg, #f8d7da, #f5c6cb);
        color: #721c24;
        border-left: 4px solid #dc3545;
    }
    
    .btn-close {
        margin-left: auto;
        background: transparent;
        border: none;
        font-size: 1.2rem;
        cursor: pointer;
        opacity: 0.7;
        padding: 0;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .btn-close:hover {
        opacity: 1;
    }

    .d-flex {
        display: flex;
    }

    .gap-2 {
        gap: 8px;
    }

    .gap-3 {
        gap: 16px;
    }

    .text-center {
        text-align: center;
    }

    .py-5 {
        padding-top: 3rem;
        padding-bottom: 3rem;
    }

    .mt-3 {
        margin-top: 1rem;
    }

    .mb-4 {
        margin-bottom: 1.5rem;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 15px;
    }

    .fw-light {
        font-weight: 300;
    }

    .fw-bold {
        font-weight: 700;
    }

    .text-muted {
        color: var(--text-light);
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        margin: 0 -12px;
    }

    .col-md-3, .col-md-4, .col-md-6 {
        flex: 0 0 auto;
        padding: 0 12px;
    }

    .col-md-3 { width: 25%; }
    .col-md-4 { width: 33.333%; }
    .col-md-6 { width: 50%; }

    .g-3 {
        margin: -0.5rem;
    }

    .g-3 > [class*="col-"] {
        padding: 0.5rem;
    }

    @media (max-width: 768px) {
        .col-md-3, .col-md-4, .col-md-6 {
            width: 100%;
        }
        
        .review-comment {
            max-width: 200px;
        }
        
        .table-responsive {
            overflow-x: auto;
        }
    }
</style>

<!-- Header -->
<section class="header-section">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="fw-light">Gerenciar <span class="fw-bold" style="background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Avaliações</span></h1>
                <p class="text-muted">Total de <%= totalAvaliacoes %> avaliações cadastradas</p>
            </div>
            <a href="/admin" class="btn-sm-view" style="padding: 10px 20px; text-decoration: none;">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>
    </div>
</section>

<!-- Conteúdo -->
<div class="container">
    <!-- Mensagens Flash -->
    <% if (locals.errors && errors && errors.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <%= Array.isArray(errors) ? errors[0] : errors %>
            <button type="button" class="btn-close" onclick="this.parentElement.style.display='none';">×</button>
        </div>
    <% } %>

    <% if (locals.success && success && success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= Array.isArray(success) ? success[0] : success %>
            <button type="button" class="btn-close" onclick="this.parentElement.style.display='none';">×</button>
        </div>
    <% } %>

    <!-- Cards de Estatísticas -->
    <div class="stats-cards">
        <div class="stat-card">
            <i class="bi bi-star-fill"></i>
            <h3><%= totalAvaliacoes %></h3>
            <p>Total de avaliações</p>
        </div>
        <div class="stat-card">
            <i class="bi bi-trophy-fill"></i>
            <h3><%= mediaGeral %></h3>
            <p>Média geral</p>
        </div>
        <div class="stat-card">
            <i class="bi bi-people-fill"></i>
            <h3><%= totalAvaliadores %></h3>
            <p>Avaliadores únicos</p>
        </div>
        <div class="stat-card">
            <i class="bi bi-box-seam-fill"></i>
            <h3><%= totalProdutosAvaliados %></h3>
            <p>Produtos avaliados</p>
        </div>
    </div>

    <!-- Filtros -->
    <div class="filter-section">
        <form method="GET" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="search" class="search-box" placeholder="Buscar por produto ou comentário..." value="<%= search %>">
            </div>
            <div class="col-md-3">
                <select name="nota" class="filter-select">
                    <option value="">Todas as notas</option>
                    <option value="5" <%= notaFiltro == '5' ? 'selected' : '' %>>5 estrelas ⭐⭐⭐⭐⭐</option>
                    <option value="4" <%= notaFiltro == '4' ? 'selected' : '' %>>4 estrelas ⭐⭐⭐⭐</option>
                    <option value="3" <%= notaFiltro == '3' ? 'selected' : '' %>>3 estrelas ⭐⭐⭐</option>
                    <option value="2" <%= notaFiltro == '2' ? 'selected' : '' %>>2 estrelas ⭐⭐</option>
                    <option value="1" <%= notaFiltro == '1' ? 'selected' : '' %>>1 estrela ⭐</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="ordenar" class="filter-select">
                    <option value="recentes" <%= ordenar === 'recentes' ? 'selected' : '' %>>Mais recentes</option>
                    <option value="antigas" <%= ordenar === 'antigas' ? 'selected' : '' %>>Mais antigas</option>
                    <option value="maior_nota" <%= ordenar === 'maior_nota' ? 'selected' : '' %>>Maior nota</option>
                    <option value="menor_nota" <%= ordenar === 'menor_nota' ? 'selected' : '' %>>Menor nota</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-sm-view" style="width: 100%; padding: 10px;">
                    <i class="bi bi-search"></i> Filtrar
                </button>
            </div>
        </form>
    </div>

    <!-- Tabela de Avaliações -->
    <div class="table-section">
        <div class="table-responsive">
            <% if (avaliacoes && avaliacoes.length > 0) { %>
            <table style="min-width: 1000px;">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Produto</th>
                        <th>Avaliador</th>
                        <th>Nota</th>
                        <th>Comentário</th>
                        <th>Data</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% avaliacoes.forEach(av => { 
                        // Determinar classe do badge baseado na nota
                        let notaClass = 'badge-nota';
                        if (av.nota >= 4) notaClass = 'badge-nota-alta';
                        else if (av.nota >= 3) notaClass = 'badge-nota-media';
                        else notaClass = 'badge-nota-baixa';
                        
                        // Formatar data
                        const dataFormatada = new Date(av.data_avaliacao).toLocaleDateString('pt-BR', {
                            day: '2-digit',
                            month: '2-digit',
                            year: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        });
                        
                        // Determinar URL da imagem do produto
                        let produtoImageUrl = null;
                        if (av.produto_imagem && av.produto_imagem.trim() !== '') {
                            if (av.produto_imagem.startsWith('http://') || av.produto_imagem.startsWith('https://')) {
                                produtoImageUrl = av.produto_imagem;
                            } else if (av.produto_imagem.startsWith('/')) {
                                produtoImageUrl = av.produto_imagem;
                            } else {
                                produtoImageUrl = `/uploads/produtos/${av.produto_imagem}`;
                            }
                        }
                    %>
                    <tr>
                        <td>#<%= av.id %></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <% if (produtoImageUrl) { %>
                                    <img src="<%= produtoImageUrl %>" class="product-image-sm" alt="<%= av.produto_name %>"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                    <div class="image-placeholder-sm" style="display: none;">
                                        <i class="bi bi-image" style="font-size: 20px;"></i>
                                    </div>
                                <% } else { %>
                                    <div class="image-placeholder-sm">
                                        <i class="bi bi-image" style="font-size: 20px;"></i>
                                    </div>
                                <% } %>
                                <div>
                                    <a href="/produto/<%= av.produto_id %>" class="text-decoration-none fw-bold" style="color: var(--primary);">
                                        <%= av.produto_name %>
                                    </a>
                                    <div class="small text-muted">
                                        <i class="bi bi-tag"></i> <%= av.produto_categoria || 'Sem categoria' %>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <% if (av.avaliador_avatar) { %>
                                    <img src="/<%= av.avaliador_avatar %>" class="user-avatar-sm" alt="Avatar">
                                <% } else { %>
                                    <div class="user-avatar-sm bg-light d-flex align-items-center justify-content-center">
                                        <i class="bi bi-person-circle" style="font-size: 24px;"></i>
                                    </div>
                                <% } %>
                                <div>
                                    <div class="fw-semibold"><%= av.avaliador_email.split('@')[0] %></div>
                                    <div class="small text-muted"><%= av.avaliador_email %></div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge <%= notaClass %>">
                                <i class="bi bi-star-fill"></i> <%= av.nota %>/5
                            </span>
                            <div class="star-rating mt-1">
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <% if (i <= av.nota) { %>
                                        <i class="bi bi-star-fill"></i>
                                    <% } else { %>
                                        <i class="bi bi-star"></i>
                                    <% } %>
                                <% } %>
                            </div>
                        </td>
                        <td class="review-comment">
                            <% if (av.comentario && av.comentario.trim() !== '') { %>
                                "<%= av.comentario %>"
                            <% } else { %>
                                <span class="text-muted fst-italic">Sem comentário</span>
                            <% } %>
                        </td>
                        <td class="text-nowrap">
                            <i class="bi bi-calendar3"></i> <%= dataFormatada %>
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a href="/produto/<%= av.produto_id %>" class="btn-sm-view" style="text-decoration: none;" title="Ver produto">
                                    <i class="bi bi-box"></i>
                                </a>
                                <a href="/admin/avaliacao/<%= av.id %>/deletar?redirect=/admin/avaliacoes" 
                                   class="btn-sm-delete" style="text-decoration: none;"
                                   onclick="return confirm('Tem certeza que deseja deletar esta avaliação? Esta ação não pode ser desfeita.')"
                                   title="Deletar avaliação">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            <% } else { %>
                <div class="text-center py-5">
                    <i class="bi bi-chat-dots" style="font-size: 4rem; color: var(--text-light);"></i>
                    <h4 class="fw-light mt-3">Nenhuma avaliação encontrada</h4>
                    <p class="text-muted">
                        <% if (search || notaFiltro) { %>
                            Tente ajustar os filtros de busca.
                        <% } else { %>
                            Ainda não há avaliações no sistema.
                        <% } %>
                    </p>
                    <% if (search || notaFiltro) { %>
                        <a href="/admin/avaliacoes" class="btn-sm-view" style="text-decoration: none; padding: 10px 20px;">
                            <i class="bi bi-arrow-repeat"></i> Limpar filtros
                        </a>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Paginação -->
    <% if (totalPaginas > 1) { %>
    <div class="pagination">
        <% for (let i = 1; i <= totalPaginas; i++) { %>
            <a href="?page=<%= i %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= notaFiltro ? '&nota=' + notaFiltro : '' %><%= ordenar ? '&ordenar=' + ordenar : '' %>" 
               class="page-item <%= i === paginaAtual ? 'active' : '' %>">
                <%= i %>
            </a>
        <% } %>
    </div>
    <% } %>
</div>

<%- include('../includes/footer') %>