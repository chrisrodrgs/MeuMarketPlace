<%- include('../includes/head') %>
<%- include('../includes/nav1') %>

<style>
    :root {
        --primary: #667eea;
        --secondary: #764ba2;
        --light-bg: #fafaff;
        --text-dark: #2d3436;
        --text-light: #636e72;
        --shadow-sm: 0 5px 20px rgba(0,0,0,0.02);
        --shadow-md: 0 10px 30px rgba(102, 126, 234, 0.05);
        --shadow-lg: 0 20px 40px rgba(102, 126, 234, 0.08);
        --gradient: linear-gradient(135deg, var(--primary), var(--secondary));
    }

    .profile-header {
        background: linear-gradient(135deg, #f5f0ff 0%, #f0f5ff 100%);
        padding: 40px 0;
        margin-bottom: 30px;
    }

    .profile-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 3px solid white;
        box-shadow: var(--shadow-lg);
        object-fit: cover;
    }

    .avatar-placeholder {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: var(--gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2.5rem;
        border: 3px solid white;
    }

    .info-card {
        background: white;
        border-radius: 30px;
        padding: 25px;
        box-shadow: var(--shadow-md);
        margin-bottom: 30px;
    }

    .info-card h4 {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .info-card h4 i {
        color: var(--primary);
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-label {
        color: var(--text-light);
        font-weight: 300;
    }

    .info-value {
        font-weight: 500;
        color: var(--text-dark);
    }

    .badge {
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 0.85rem;
    }

    .badge.admin {
        background: linear-gradient(135deg, #f56565, #c53030);
        color: white;
    }

    .badge.user {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

    .product-table, .review-table {
        background: white;
        border-radius: 30px;
        padding: 25px;
        box-shadow: var(--shadow-md);
        margin-bottom: 30px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        text-align: left;
        padding: 15px 12px;
        color: var(--text-light);
        font-weight: 500;
        font-size: 0.9rem;
        border-bottom: 2px solid rgba(102, 126, 234, 0.1);
    }

    td {
        padding: 15px 12px;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        color: var(--text-dark);
    }

    tr:hover td {
        background: var(--light-bg);
    }

    .btn-sm {
        padding: 5px 10px;
        border-radius: 8px;
        font-size: 0.85rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.3s ease;
    }

    .btn-sm.view {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

    .btn-sm.delete {
        background: linear-gradient(135deg, #f56565, #c53030);
        color: white;
    }

    .btn-sm:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: white;
        border: 2px solid rgba(102, 126, 234, 0.1);
        border-radius: 50px;
        color: var(--text-dark);
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .back-btn:hover {
        border-color: var(--primary);
        transform: translateX(-5px);
    }

    .star-rating {
        color: #ffd700;
    }
</style>

<!-- Header -->
<section class="profile-header">
    <div class="container">
        <a href="/admin/usuarios" class="back-btn mb-4">
            <i class="bi bi-arrow-left"></i> Voltar para lista de usuários
        </a>
        
        <div class="d-flex align-items-center gap-4 mt-4">
            <div>
                <% if (usuario.avatar) { %>
                    <img src="/<%= usuario.avatar %>" class="profile-avatar">
                <% } else { %>
                    <div class="avatar-placeholder">
                        <i class="bi bi-person-fill"></i>
                    </div>
                <% } %>
            </div>
            <div>
                <h1 class="fw-light mb-2"><%= usuario.email.split('@')[0] %></h1>
                <p class="text-muted mb-2"><%= usuario.email %></p>
                <div>
                    <% if (usuario.isAdmin) { %>
                        <span class="badge admin">Administrador</span>
                    <% } else { %>
                        <span class="badge user">Usuário</span>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Conteúdo -->
<div class="container">
    <!-- Mensagens Flash -->
    <% if (typeof errors !== 'undefined' && errors) { %>
        <div class="alert alert-danger"><%= errors %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><%= success %></div>
    <% } %>

    <div class="row">
        <!-- Coluna da Esquerda - Informações -->
        <div class="col-md-4">
            <div class="info-card">
                <h4><i class="bi bi-info-circle"></i> Informações da Conta</h4>
                
                <div class="info-row">
                    <span class="info-label">ID:</span>
                    <span class="info-value">#<%= usuario.id %></span>
                </div>
                
                <div class="info-row">
                    <span class="info-label">Email:</span>
                    <span class="info-value"><%= usuario.email %></span>
                </div>
                
                <div class="info-row">
                    <span class="info-label">Membro desde:</span>
                    <span class="info-value"><%= new Date(usuario.data_criacao).toLocaleDateString('pt-BR') %></span>
                </div>
                
                <div class="info-row">
                    <span class="info-label">Status:</span>
                    <span class="info-value">
                        <span class="badge" style="background: var(--success); color: white;">Ativo</span>
                    </span>
                </div>
            </div>
            
            <div class="info-card">
                <h4><i class="bi bi-bar-chart"></i> Estatísticas</h4>
                
                <div class="info-row">
                    <span class="info-label">Total de produtos:</span>
                    <span class="info-value"><%= usuario.total_produtos %></span>
                </div>
                
                <div class="info-row">
                    <span class="info-label">Avaliações recebidas:</span>
                    <span class="info-value"><%= usuario.total_avaliacoes_recebidas || 0 %></span>
                </div>
                
                <div class="info-row">
                    <span class="info-label">Média das avaliações:</span>
                    <span class="info-value">
                        <% if (usuario.media_avaliacoes) { %>
                            <%= Number(usuario.media_avaliacoes).toFixed(1) %> ⭐
                        <% } else { %>
                            -
                        <% } %>
                    </span>
                </div>
            </div>
            
            <!-- Ações Rápidas -->
            <div class="d-grid gap-2">
                <% if (!usuario.isAdmin) { %>
                    <a href="/admin/usuarios/<%= usuario.id %>/tornar-admin" 
                       class="btn-sm view d-block text-center"
                       onclick="return confirm('Tornar este usuário administrador?')">
                        <i class="bi bi-shield"></i> Tornar Admin
                    </a>
                <% } else if (usuario.id != session.user.id) { %>
                    <a href="/admin/usuarios/<%= usuario.id %>/remover-admin" 
                       class="btn-sm edit d-block text-center"
                       onclick="return confirm('Remover status de admin?')">
                        <i class="bi bi-shield-slash"></i> Remover Admin
                    </a>
                <% } %>
                
                <% if (usuario.id != session.user.id) { %>
                    <a href="/admin/usuarios/<%= usuario.id %>/deletar" 
                       class="btn-sm delete d-block text-center"
                       onclick="return confirm('Tem certeza? Todos os produtos e avaliações deste usuário serão deletados.')">
                        <i class="bi bi-trash"></i> Deletar Usuário
                    </a>
                <% } %>
            </div>
        </div>
        
        <!-- Coluna da Direita - Produtos e Avaliações -->
        <div class="col-md-8">
            <!-- Produtos do Usuário -->
            <div class="product-table">
                <h4><i class="bi bi-box"></i> Produtos do Usuário (<%= produtos.length %>)</h4>
                
                <% if (produtos.length > 0) { %>
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Produto</th>
                                    <th>Preço</th>
                                    <th>Estoque</th>
                                    <th>Avaliações</th>
                                    <th>Média</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% produtos.forEach(prod => { %>
                                <tr>
                                    <td><%= prod.id %></td>
                                    <td><%= prod.name %></td>
                                    <td>R$ <%= Number(prod.price).toFixed(2) %></td>
                                    <td><%= prod.estoque || 0 %></td>
                                    <td><%= prod.total_avaliacoes || 0 %></td>
                                    <td class="star-rating">
                                        <% if (prod.media_avaliacoes) { %>
                                            <%= Number(prod.media_avaliacoes).toFixed(1) %> ⭐
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                    <td>
                                        <a href="/admin/produtos/<%= prod.id %>" class="btn-sm view">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/admin/produtos/<%= prod.id %>/deletar?redirect=/admin/usuarios/<%= usuario.id %>" 
                                           class="btn-sm delete"
                                           onclick="return confirm('Deletar este produto?')">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <p class="text-muted text-center py-4">Este usuário não possui produtos.</p>
                <% } %>
            </div>
            
            <!-- Avaliações Recebidas -->
            <div class="review-table">
                <h4><i class="bi bi-star"></i> Avaliações Recebidas (<%= avaliacoes.length %>)</h4>
                
                <% if (avaliacoes.length > 0) { %>
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th>Avaliador</th>
                                    <th>Nota</th>
                                    <th>Comentário</th>
                                    <th>Data</th>
                                    <th>Ação</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% avaliacoes.forEach(av => { %>
                                <tr>
                                    <td><%= av.produto_nome %></td>
                                    <td><%= av.avaliador_email.split('@')[0] %></td>
                                    <td class="star-rating"><%= av.nota %> ⭐</td>
                                    <td><%= av.comentario ? av.comentario.substring(0, 30) + '...' : '-' %></td>
                                    <td><%= new Date(av.data_avaliacao).toLocaleDateString('pt-BR') %></td>
                                    <td>
                                        <a href="/admin/avaliacao/<%= av.id %>/deletar?redirect=/admin/usuarios/<%= usuario.id %>" 
                                           class="btn-sm delete"
                                           onclick="return confirm('Deletar esta avaliação?')">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <p class="text-muted text-center py-4">Este usuário não recebeu avaliações.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../includes/footer') %>