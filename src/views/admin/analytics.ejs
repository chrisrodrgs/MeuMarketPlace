<%- include('../includes/head') %>
<%- include('../includes/nav1') %>

<style>
    /* ===== VARIÁVEIS ===== */
    :root {
        --primary: #667eea;
        --secondary: #764ba2;
        --light-bg: #fafaff;
        --text-dark: #2d3436;
        --text-light: #636e72;
        --shadow-sm: 0 5px 20px rgba(0,0,0,0.02);
        --shadow-md: 0 10px 30px rgba(102, 126, 234, 0.05);
        --shadow-lg: 0 20px 40px rgba(102, 126, 234, 0.08);
        --gradient: linear-gradient(135deg, var(--primary), var(--secondary));
        --success: #48bb78;
        --danger: #f56565;
        --warning: #ecc94b;
    }

    /* ===== HEADER ===== */
    .analytics-header {
        background: linear-gradient(135deg, #f5f0ff 0%, #f0f5ff 100%);
        padding: 60px 0;
        position: relative;
        overflow: hidden;
        margin-bottom: 40px;
    }

    .analytics-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 100%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, transparent 60%);
        animation: spinSlow 90s linear infinite;
    }

    @keyframes spinSlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .analytics-header h1 {
        font-size: 2.5rem;
        font-weight: 300;
        color: var(--text-dark);
        position: relative;
        z-index: 2;
    }

    .analytics-header h1 span {
        font-weight: 700;
        background: var(--gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* ===== STATS CARDS ===== */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: white;
        border-radius: 20px;
        padding: 20px;
        box-shadow: var(--shadow-md);
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
    }

    .stat-card h3 {
        font-size: 2rem;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 5px;
    }

    .stat-card p {
        color: var(--text-light);
        margin: 0;
        font-size: 0.9rem;
    }

    .stat-card small {
        color: var(--success);
        font-size: 0.8rem;
    }

    /* ===== GRÁFICOS ===== */
    .chart-card {
        background: white;
        border-radius: 20px;
        padding: 20px;
        box-shadow: var(--shadow-md);
        margin-bottom: 30px;
    }

    .chart-card h4 {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chart-card h4 i {
        color: var(--primary);
    }

    .chart-container {
        position: relative;
        height: 300px;
    }

    /* ===== TABELAS ===== */
    .table-card {
        background: white;
        border-radius: 20px;
        padding: 20px;
        box-shadow: var(--shadow-md);
        margin-bottom: 30px;
    }

    .table-card h4 {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .table-card h4 i {
        color: var(--primary);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        text-align: left;
        padding: 12px;
        color: var(--text-light);
        font-weight: 500;
        font-size: 0.85rem;
        border-bottom: 2px solid rgba(102, 126, 234, 0.1);
    }

    td {
        padding: 12px;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        color: var(--text-dark);
    }

    tr:hover td {
        background: var(--light-bg);
    }

    .user-avatar-sm {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        object-fit: cover;
    }

    .badge {
        padding: 4px 10px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .badge.categoria {
        background: var(--light-bg);
        color: var(--primary);
    }

    /* ===== BOTÕES ===== */
    .btn-elegante {
        padding: 10px 20px;
        border-radius: 25px;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
        cursor: pointer;
    }

    .btn-elegante.primary {
        background: var(--gradient);
        color: white;
    }

    .btn-elegante.secondary {
        background: white;
        color: var(--primary);
        border: 2px solid rgba(102, 126, 234, 0.2);
    }

    .btn-elegante:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .export-buttons {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-bottom: 20px;
    }

    /* ===== RESPONSIVIDADE ===== */
    @media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
        
        .chart-container {
            height: 250px;
        }
    }
</style>

<!-- Header -->
<section class="analytics-header">
    <div class="container text-center">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1>
                    Central de <span>Análise de Dados</span>
                </h1>
                <p class="text-muted">Métricas e indicadores do seu marketplace</p>
            </div>
            <a href="/admin" class="btn-elegante secondary">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>
    </div>
</section>

<!-- Conteúdo Principal -->
<div class="container">
    <!-- Mensagens Flash -->
    <% if (typeof errors !== 'undefined' && errors) { %>
        <div class="alert alert-danger"><%= errors %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><%= success %></div>
    <% } %>

    <!-- Botões de Exportação -->
    <div class="export-buttons">
        <a href="/admin/analytics/exportar?formato=csv" class="btn-elegante secondary">
            <i class="bi bi-filetype-csv"></i> Exportar CSV
        </a>
        <a href="/admin/analytics/exportar?formato=json" class="btn-elegante secondary">
            <i class="bi bi-filetype-json"></i> Exportar JSON
        </a>
    </div>

    <!-- Cards de Estatísticas -->
    <div class="stats-grid">
        <div class="stat-card">
            <h3><%= stats.totalUsuarios %></h3>
            <p>Usuários totais</p>
            <small>+12% vs mês anterior</small>
        </div>
        <div class="stat-card">
            <h3><%= stats.totalVendedores %></h3>
            <p>Vendedores ativos</p>
            <small><%= ((stats.totalVendedores / stats.totalUsuarios) * 100).toFixed(1) %>% do total</small>
        </div>
        <div class="stat-card">
            <h3><%= stats.totalProdutos %></h3>
            <p>Produtos ativos</p>
            <small>Média de <%= (stats.totalProdutos / stats.totalVendedores).toFixed(1) %> por vendedor</small>
        </div>
        <div class="stat-card">
            <h3><%= stats.totalPedidos %></h3>
            <p>Pedidos realizados</p>
            <small><%= stats.taxaConversao %>% dos usuários compraram</small>
        </div>
        <div class="stat-card">
            <h3>R$ <%= Number(stats.valorTotalVendido).toLocaleString('pt-BR') %></h3>
            <p>Valor total vendido</p>
            <small>Ticket médio: R$ <%= Number(stats.ticketMedio).toLocaleString('pt-BR') %></small>
        </div>
        <div class="stat-card">
            <h3><%= stats.totalAvaliacoes %></h3>
            <p>Avaliações recebidas</p>
            <small>Média: <%= stats.mediaAvaliacoes %> ⭐</small>
        </div>
    </div>

    <!-- Gráfico de Crescimento de Usuários -->
    <div class="chart-card">
        <h4><i class="bi bi-person-plus"></i> Crescimento de Usuários (últimos 6 meses)</h4>
        <div class="chart-container">
            <canvas id="usuariosChart"></canvas>
        </div>
    </div>

    <!-- Gráfico de Crescimento de Produtos -->
    <div class="chart-card">
        <h4><i class="bi bi-box"></i> Crescimento de Produtos (últimos 6 meses)</h4>
        <div class="chart-container">
            <canvas id="produtosChart"></canvas>
        </div>
    </div>

    <!-- Gráfico de Vendas Mensais -->
    <div class="chart-card">
        <h4><i class="bi bi-graph-up"></i> Vendas Mensais (últimos 12 meses)</h4>
        <div class="chart-container">
            <canvas id="vendasChart"></canvas>
        </div>
    </div>

    <div class="row">
        <!-- Top Vendedores -->
        <div class="col-md-6">
            <div class="table-card">
                <h4><i class="bi bi-trophy"></i> Top 10 Vendedores</h4>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Vendedor</th>
                                <th>Vendas</th>
                                <th>Itens</th>
                                <th>Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% topVendedores.forEach(function(v) { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <% if (v.avatar) { %>
                                            <img src="/<%= v.avatar %>" class="user-avatar-sm">
                                        <% } else { %>
                                            <i class="bi bi-person-circle"></i>
                                        <% } %>
                                        <span><%= v.email.split('@')[0] %></span>
                                    </div>
                                </td>
                                <td><%= v.total_vendas %></td>
                                <td><%= v.itens_vendidos %></td>
                                <td>R$ <%= Number(v.valor_total).toFixed(2) %></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Produtos Mais Vendidos -->
        <div class="col-md-6">
            <div class="table-card">
                <h4><i class="bi bi-fire"></i> Produtos Mais Vendidos</h4>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Produto</th>
                                <th>Vendas</th>
                                <th>Qtd</th>
                                <th>Valor</th>
                                <th>⭐</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% produtosMaisVendidos.forEach(function(p) { %>
                            <tr>
                                <td><%= p.name %></td>
                                <td><%= p.total_vendas %></td>
                                <td><%= p.quantidade_vendida %></td>
                                <td>R$ <%= Number(p.valor_total).toFixed(2) %></td>
                                <td><%= p.media_avaliacoes ? p.media_avaliacoes.toFixed(1) : '-' %></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Produtos Melhor Avaliados -->
        <div class="col-md-6">
            <div class="table-card">
                <h4><i class="bi bi-star"></i> Produtos Melhor Avaliados</h4>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Produto</th>
                                <th>Categoria</th>
                                <th>⭐</th>
                                <th>Avaliações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% produtosMelhorAvaliados.forEach(function(p) { %>
                            <tr>
                                <td><%= p.name %></td>
                                <td><span class="badge categoria"><%= p.categoria %></span></td>
                                <td><%= p.media_avaliacoes.toFixed(1) %></td>
                                <td><%= p.total_avaliacoes %></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Vendas por Categoria -->
        <div class="col-md-6">
            <div class="chart-card">
                <h4><i class="bi bi-pie-chart"></i> Vendas por Categoria</h4>
                <div class="chart-container">
                    <canvas id="categoriasChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Distribuição de Avaliações -->
    <div class="chart-card">
        <h4><i class="bi bi-bar-chart"></i> Distribuição de Avaliações</h4>
        <div class="chart-container">
            <canvas id="avaliacoesChart"></canvas>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Dados dos gráficos
        const usuariosData = {
            labels: <%= JSON.stringify(crescimentoUsuarios.map(u => u.mes)) %>,
            datasets: [{
                label: 'Novos usuários',
                data: <%= JSON.stringify(crescimentoUsuarios.map(u => u.total)) %>,
                borderColor: '#667eea',
                backgroundColor: 'rgba(102, 126, 234, 0.1)',
                fill: true,
                tension: 0.4
            }]
        };
        
        const produtosData = {
            labels: <%= JSON.stringify(crescimentoProdutos.map(p => p.mes)) %>,
            datasets: [{
                label: 'Novos produtos',
                data: <%= JSON.stringify(crescimentoProdutos.map(p => p.total)) %>,
                borderColor: '#48bb78',
                backgroundColor: 'rgba(72, 187, 120, 0.1)',
                fill: true,
                tension: 0.4
            }]
        };
        
        const vendasData = {
            labels: <%= JSON.stringify(vendasMensais.map(v => v.mes)) %>,
            datasets: [{
                label: 'Valor vendido (R$)',
                data: <%= JSON.stringify(vendasMensais.map(v => v.valor_total)) %>,
                borderColor: '#ecc94b',
                backgroundColor: 'rgba(236, 201, 75, 0.1)',
                fill: true,
                tension: 0.4
            }]
        };
        
        const categoriasData = {
            labels: <%= JSON.stringify(vendasPorCategoria.map(c => c.categoria)) %>,
            datasets: [{
                data: <%= JSON.stringify(vendasPorCategoria.map(c => c.valor_total)) %>,
                backgroundColor: ['#667eea', '#764ba2', '#48bb78', '#ecc94b', '#f56565', '#4299e1']
            }]
        };
        
        const avaliacoesData = {
            labels: <%= JSON.stringify(distribuicaoAvaliacoes.map(a => a.nota + ' estrelas')) %>,
            datasets: [{
                label: 'Quantidade',
                data: <%= JSON.stringify(distribuicaoAvaliacoes.map(a => a.total)) %>,
                backgroundColor: '#ffd700',
                borderRadius: 8
            }]
        };
        
        // Criar gráficos
        new Chart(document.getElementById('usuariosChart'), {
            type: 'line',
            data: usuariosData,
            options: { responsive: true, maintainAspectRatio: false }
        });
        
        new Chart(document.getElementById('produtosChart'), {
            type: 'line',
            data: produtosData,
            options: { responsive: true, maintainAspectRatio: false }
        });
        
        new Chart(document.getElementById('vendasChart'), {
            type: 'line',
            data: vendasData,
            options: { responsive: true, maintainAspectRatio: false }
        });
        
        new Chart(document.getElementById('categoriasChart'), {
            type: 'pie',
            data: categoriasData,
            options: { responsive: true, maintainAspectRatio: false }
        });
        
        new Chart(document.getElementById('avaliacoesChart'), {
            type: 'bar',
            data: avaliacoesData,
            options: { 
                responsive: true, 
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, grid: { color: '#e2e8f0' } },
                    x: { grid: { display: false } }
                }
            }
        });
    });
</script>

<%- include('../includes/footer') %>