<%- include('../includes/head') %>
<%- include('../includes/nav1') %>

<!-- Header -->
<section class="hero-section" style="min-height: 40vh; padding: 60px 0;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="hero-title">
                    Central de <span>Análise de Dados</span>
                </h1>
                <p class="hero-subtitle">Métricas e indicadores do seu marketplace</p>
            </div>
            <a href="/admin" class="btn-elegante outline">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>
    </div>
</section>

<!-- Conteúdo Principal -->
<div class="container py-4">
    <!-- MENSAGENS FLASH CORRIGIDAS -->
    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <%= errors %>
        </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= success %>
        </div>
    <% } %>

    <!-- Botões de Exportação -->
    <div class="d-flex justify-content-end gap-2 mb-4">
        <a href="/admin/analytics/exportar?formato=csv" class="btn-elegante secondary small">
            <i class="bi bi-filetype-csv"></i> Exportar CSV
        </a>
        <a href="/admin/analytics/exportar?formato=json" class="btn-elegante secondary small">
            <i class="bi bi-filetype-json"></i> Exportar JSON
        </a>
    </div>

    <!-- Cards de Estatísticas -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="stat-card-elegante">
                <i class="bi bi-people"></i>
                <h3><%= stats.totalUsuarios %></h3>
                <p>Usuários totais</p>
                <small class="text-success"><%= ((stats.totalVendedores / stats.totalUsuarios) * 100).toFixed(1) %>% vendedores</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card-elegante">
                <i class="bi bi-box"></i>
                <h3><%= stats.totalProdutos %></h3>
                <p>Produtos ativos</p>
                <small class="text-muted">Média de <%= (stats.totalProdutos / stats.totalVendedores).toFixed(1) %> por vendedor</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card-elegante">
                <i class="bi bi-star"></i>
                <h3><%= stats.totalAvaliacoes %></h3>
                <p>Avaliações recebidas</p>
                <small class="text-warning">Média: <%= stats.mediaAvaliacoes %> ⭐</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card-elegante">
                <i class="bi bi-cart"></i>
                <h3><%= stats.totalPedidos %></h3>
                <p>Pedidos realizados</p>
                <small class="text-success"><%= stats.taxaConversao %>% dos usuários compraram</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card-elegante">
                <i class="bi bi-currency-dollar"></i>
                <h3>R$ <%= Number(stats.valorTotalVendido).toLocaleString('pt-BR') %></h3>
                <p>Valor total vendido</p>
                <small class="text-info">Ticket médio: R$ <%= Number(stats.ticketMedio).toLocaleString('pt-BR') %></small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card-elegante">
                <i class="bi bi-graph-up"></i>
                <h3><%= stats.totalVendedores %></h3>
                <p>Vendedores ativos</p>
                <small class="text-muted"><%= ((stats.totalVendedores / stats.totalUsuarios) * 100).toFixed(1) %>% do total</small>
            </div>
        </div>
    </div>

    <!-- Gráficos -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card-elegante p-4">
                <h4 class="mb-3"><i class="bi bi-person-plus text-primary me-2"></i>Crescimento de Usuários</h4>
                <div class="chart-container" style="height: 300px;">
                    <canvas id="usuariosChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card-elegante p-4">
                <h4 class="mb-3"><i class="bi bi-box text-primary me-2"></i>Crescimento de Produtos</h4>
                <div class="chart-container" style="height: 300px;">
                    <canvas id="produtosChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card-elegante p-4">
                <h4 class="mb-3"><i class="bi bi-graph-up text-primary me-2"></i>Vendas Mensais</h4>
                <div class="chart-container" style="height: 300px;">
                    <canvas id="vendasChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card-elegante p-4">
                <h4 class="mb-3"><i class="bi bi-pie-chart text-primary me-2"></i>Vendas por Categoria</h4>
                <div class="chart-container" style="height: 300px;">
                    <canvas id="categoriasChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card-elegante p-4">
                <h4 class="mb-3"><i class="bi bi-star text-primary me-2"></i>Distribuição de Avaliações</h4>
                <div class="chart-container" style="height: 300px;">
                    <canvas id="avaliacoesChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card-elegante p-4">
                <h4 class="mb-3"><i class="bi bi-trophy text-primary me-2"></i>Top 10 Vendedores</h4>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Vendedor</th>
                                <th>Vendas</th>
                                <th>Valor</th>
                            </thead>
                        <tbody>
                            <% if (topVendedores && topVendedores.length > 0) { %>
                                <% topVendedores.forEach(v => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-person-circle"></i>
                                            <%= v.email.split('@')[0] %>
                                        </div>
                                    </td>
                                    <td><%= v.total_vendas %></td>
                                    <td>R$ <%= Number(v.valor_total).toFixed(2) %></td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="3" class="text-center">Nenhum dado disponível</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card-elegante p-4">
                <h4 class="mb-3"><i class="bi bi-fire text-primary me-2"></i>Produtos Mais Vendidos</h4>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Produto</th>
                                <th>Vendas</th>
                                <th>Valor</th>
                                <th>⭐</th>
                            </thead>
                        <tbody>
                            <% if (produtosMaisVendidos && produtosMaisVendidos.length > 0) { %>
                                <% produtosMaisVendidos.forEach(p => { %>
                                <tr>
                                    <td><%= p.name %></td>
                                    <td><%= p.quantidade_vendida %></td>
                                    <td>R$ <%= Number(p.valor_total).toFixed(2) %></td>
                                    <td><%= p.media_avaliacoes ? p.media_avaliacoes.toFixed(1) : '-' %></td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="4" class="text-center">Nenhum dado disponível</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card-elegante p-4">
                <h4 class="mb-3"><i class="bi bi-star-fill text-primary me-2"></i>Produtos Melhor Avaliados</h4>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Produto</th>
                                <th>Categoria</th>
                                <th>⭐</th>
                                <th>Avaliações</th>
                            </thead>
                        <tbody>
                            <% if (produtosMelhorAvaliados && produtosMelhorAvaliados.length > 0) { %>
                                <% produtosMelhorAvaliados.forEach(p => { %>
                                <tr>
                                    <td><%= p.name %></td>
                                    <td><span class="badge bg-light text-dark"><%= p.categoria %></span></td>
                                    <td class="text-warning"><%= p.media_avaliacoes.toFixed(1) %></td>
                                    <td><%= p.total_avaliacoes %></td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="4" class="text-center">Nenhum dado disponível</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Dados dos gráficos
        const usuariosLabels = <%= JSON.stringify(crescimentoUsuarios.map(u => u.mes)) %>;
        const usuariosData = <%= JSON.stringify(crescimentoUsuarios.map(u => u.total)) %>;
        
        const produtosLabels = <%= JSON.stringify(crescimentoProdutos.map(p => p.mes)) %>;
        const produtosData = <%= JSON.stringify(crescimentoProdutos.map(p => p.total)) %>;
        
        const vendasLabels = <%= JSON.stringify(vendasMensais.map(v => v.mes)) %>;
        const vendasData = <%= JSON.stringify(vendasMensais.map(v => v.valor_total)) %>;
        
        const categoriasLabels = <%= JSON.stringify(vendasPorCategoria.map(c => c.categoria)) %>;
        const categoriasData = <%= JSON.stringify(vendasPorCategoria.map(c => c.valor_total)) %>;
        
        const avaliacoesLabels = <%= JSON.stringify(distribuicaoAvaliacoes.map(a => a.nota + ' estrelas')) %>;
        const avaliacoesData = <%= JSON.stringify(distribuicaoAvaliacoes.map(a => a.total)) %>;
        
        // Criar gráficos
        new Chart(document.getElementById('usuariosChart'), {
            type: 'line',
            data: {
                labels: usuariosLabels,
                datasets: [{
                    label: 'Novos usuários',
                    data: usuariosData,
                    borderColor: '#667eea',
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });
        
        new Chart(document.getElementById('produtosChart'), {
            type: 'line',
            data: {
                labels: produtosLabels,
                datasets: [{
                    label: 'Novos produtos',
                    data: produtosData,
                    borderColor: '#48bb78',
                    backgroundColor: 'rgba(72, 187, 120, 0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });
        
        new Chart(document.getElementById('vendasChart'), {
            type: 'line',
            data: {
                labels: vendasLabels,
                datasets: [{
                    label: 'Valor vendido (R$)',
                    data: vendasData,
                    borderColor: '#ecc94b',
                    backgroundColor: 'rgba(236, 201, 75, 0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });
        
        new Chart(document.getElementById('categoriasChart'), {
            type: 'pie',
            data: {
                labels: categoriasLabels,
                datasets: [{
                    data: categoriasData,
                    backgroundColor: ['#667eea', '#764ba2', '#48bb78', '#ecc94b', '#f56565', '#4299e1']
                }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });
        
        new Chart(document.getElementById('avaliacoesChart'), {
            type: 'bar',
            data: {
                labels: avaliacoesLabels,
                datasets: [{
                    label: 'Quantidade',
                    data: avaliacoesData,
                    backgroundColor: '#ffd700',
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { y: { beginAtZero: true } }
            }
        });
    });
</script>

<style>
    .chart-container {
        position: relative;
    }
    .badge.bg-light {
        background: #f1f5f9 !important;
        color: #334155 !important;
    }
    .table-sm td, .table-sm th {
        padding: 0.5rem;
    }
</style>

<%- include('../includes/footer') %>