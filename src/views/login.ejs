<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<style>
    /* Estilos adicionais para o botão Google */
    .btn-elegante.google {
        background: white;
        color: #dc4e41;
        border: 2px solid rgba(220, 78, 65, 0.2);
        transition: all 0.3s ease;
    }
    
    .btn-elegante.google:hover {
        border-color: #dc4e41;
        background: #dc4e41;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(220, 78, 65, 0.25);
    }
</style>

<!-- Hero Section - Centralizada e com espaço -->
<section class="hero-section" style="min-height: 50vh; padding: 80px 0 60px 0;">
    <div class="container text-center">
        <h1 class="hero-title">
            Bem-vindo ao <span>Marketplace</span>
        </h1>
        <p class="hero-subtitle mx-auto mt-3">Entre ou crie sua conta para começar</p>
    </div>
</section>

<!-- Card de Login -->
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card-elegante">
                <div class="card-header bg-gradient-primary text-white py-4">
                    <h2 class="h4 mb-0 text-center">
                        <i class="bi bi-person-circle me-2"></i>
                        Acesse sua conta
                    </h2>
                </div>
                <div class="card-body p-4">
                    <!-- MENSAGENS FLASH CORRIGIDAS -->
                    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <%= errors %>
                        </div>
                    <% } %>

                    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <%= success %>
                        </div>
                    <% } %>

                    <!-- Tabs -->
                    <ul class="nav nav-pills nav-justified mb-4 gap-2" id="loginTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="login-tab" data-bs-toggle="tab" 
                                    data-bs-target="#login" type="button" role="tab">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Entrar
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="register-tab" data-bs-toggle="tab" 
                                    data-bs-target="#register" type="button" role="tab">
                                <i class="bi bi-person-plus me-2"></i>Cadastrar
                            </button>
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content">
                        <!-- Login Tab -->
                        <div class="tab-pane fade show active" id="login" role="tabpanel">
                            <form action="/login/login" method="POST">
                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="bi bi-envelope me-2"></i>E-mail
                                    </label>
                                    <input type="email" name="email" class="form-control" 
                                           placeholder="seu@email.com" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="bi bi-lock me-2"></i>Senha
                                    </label>
                                    <input type="password" name="password" class="form-control" 
                                           placeholder="••••••••" required>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="remember">
                                        <label class="form-check-label" for="remember">Lembrar-me</label>
                                    </div>
                                    <a href="#" class="text-decoration-none small">Esqueceu a senha?</a>
                                </div>

                                <button type="submit" class="btn-elegante primary w-100">
                                    <i class="bi bi-box-arrow-in-right"></i> Entrar
                                </button>
                            </form>
                        </div>

                        <!-- Register Tab -->
                        <div class="tab-pane fade" id="register" role="tabpanel">
                            <form action="/login/register" method="POST">
                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="bi bi-envelope me-2"></i>E-mail
                                    </label>
                                    <input type="email" name="email" class="form-control" 
                                           placeholder="seu@email.com" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="bi bi-lock me-2"></i>Senha
                                    </label>
                                    <input type="password" name="password" class="form-control" 
                                           placeholder="Mínimo 6 caracteres" required>
                                </div>

                                <div class="form-check mb-4">
                                    <input type="checkbox" class="form-check-input" id="terms" required>
                                    <label class="form-check-label" for="terms">
                                        Concordo com os <a href="#" class="text-decoration-none">Termos de Uso</a>
                                    </label>
                                </div>

                                <button type="submit" class="btn-elegante success w-100">
                                    <i class="bi bi-person-plus"></i> Criar conta
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Divisor -->
                    <div class="position-relative text-center my-4">
                        <hr class="border-secondary">
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted">ou</span>
                    </div>

                    <!-- Botões Sociais -->
                    <div class="row g-3">
                        <div class="col-md-12">
                            <a href="/em-breve" class="btn-elegante google w-100">
                                <i class="bi bi-google me-2"></i> Continuar com Google
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Ativar aba baseado no hash da URL
    if (window.location.hash === '#register') {
        const registerTab = new bootstrap.Tab(document.getElementById('register-tab'));
        registerTab.show();
    }
</script>

<%- include('./includes/footer') %>