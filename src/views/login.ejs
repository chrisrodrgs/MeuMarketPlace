<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<!-- Hero Section Pequeno -->
<section class="login-hero-section py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 text-center text-white py-4" data-aos="fade-up">
                <h1 class="display-4 fw-bold mb-3">Bem-vindo ao Marketplace</h1>
                <p class="lead">Entre ou cadastre-se para começar a vender e comprar produtos incríveis</p>
            </div>
        </div>
    </div>
</section>

<section class="login-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Cards de estatísticas flutuantes -->
                <div class="row g-4 mb-5">
                    <div class="col-md-4" data-aos="fade-up" data-aos-delay="0">
                        <div class="stats-mini-card text-center p-3">
                            <i class="bi bi-people text-primary fs-1"></i>
                            <h3 class="fw-bold mt-2">+500</h3>
                            <p class="text-muted small">Vendedores</p>
                        </div>
                    </div>
                    <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                        <div class="stats-mini-card text-center p-3">
                            <i class="bi bi-box text-success fs-1"></i>
                            <h3 class="fw-bold mt-2">+1000</h3>
                            <p class="text-muted small">Produtos</p>
                        </div>
                    </div>
                    <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                        <div class="stats-mini-card text-center p-3">
                            <i class="bi bi-star text-warning fs-1"></i>
                            <h3 class="fw-bold mt-2">+2000</h3>
                            <p class="text-muted small">Clientes</p>
                        </div>
                    </div>
                </div>

                <!-- Card de Login/Cadastro -->
                <div class="card login-card shadow-lg border-0" data-aos="fade-up" data-aos-delay="300">
                    <div class="card-body p-5">
                        <!-- Abas estilizadas -->
                        <ul class="nav nav-pills nav-justified mb-5" id="loginTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="login-tab" data-bs-toggle="tab" 
                                        data-bs-target="#login" type="button" role="tab">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>
                                    Entrar
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="register-tab" data-bs-toggle="tab" 
                                        data-bs-target="#register" type="button" role="tab">
                                    <i class="bi bi-person-plus me-2"></i>
                                    Cadastrar
                                </button>
                            </li>
                        </ul>

                        <!-- Mensagens Flash -->
                        <% if (typeof errors !== 'undefined' && errors) { %>
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <%= errors %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        <% } %>

                        <% if (typeof success !== 'undefined' && success) { %>
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                <%= success %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        <% } %>

                        <!-- Conteúdo das Abas -->
                        <div class="tab-content">
                            <!-- Aba de Login -->
                            <div class="tab-pane fade show active" id="login" role="tabpanel">
                                <form action="/login/login" method="POST">
                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">
                                            <i class="bi bi-envelope me-2"></i>E-mail
                                        </label>
                                        <input type="email" name="email" class="form-control form-control-lg" 
                                               placeholder="seu@email.com" required>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">
                                            <i class="bi bi-lock me-2"></i>Senha
                                        </label>
                                        <input type="password" name="password" class="form-control form-control-lg" 
                                               placeholder="••••••••" required>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" id="remember">
                                            <label class="form-check-label" for="remember">Lembrar-me</label>
                                        </div>
                                        <a href="#" class="text-decoration-none">Esqueceu a senha?</a>
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-lg w-100 py-3 mb-3">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>
                                        Entrar
                                    </button>
                                </form>
                            </div>

                            <!-- Aba de Registro -->
                            <div class="tab-pane fade" id="register" role="tabpanel">
                                <form action="/login/register" method="POST">
                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">
                                            <i class="bi bi-envelope me-2"></i>E-mail
                                        </label>
                                        <input type="email" name="email" class="form-control form-control-lg" 
                                               placeholder="seu@email.com" required>
                                        <div class="form-text">Seu e-mail será usado para login</div>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">
                                            <i class="bi bi-lock me-2"></i>Senha
                                        </label>
                                        <input type="password" name="password" class="form-control form-control-lg" 
                                               placeholder="Mínimo 6 caracteres" required>
                                        <div class="form-text">Use letras e números para mais segurança</div>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">
                                            <i class="bi bi-lock me-2"></i>Confirmar Senha
                                        </label>
                                        <input type="password" class="form-control form-control-lg" 
                                               placeholder="Digite a senha novamente">
                                    </div>

                                    <div class="mb-4">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" id="terms" required>
                                            <label class="form-check-label" for="terms">
                                                Concordo com os <a href="#" class="text-decoration-none">Termos de Uso</a> 
                                                e <a href="#" class="text-decoration-none">Política de Privacidade</a>
                                            </label>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-success btn-lg w-100 py-3">
                                        <i class="bi bi-person-plus me-2"></i>
                                        Criar minha conta
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Divisor com opções sociais -->
                        <div class="divider my-4">
                            <span class="divider-text bg-white px-3 text-muted">ou entre com</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <button class="btn btn-outline-danger w-100 py-2">
                                    <i class="bi bi-google me-2"></i>
                                    Google
                                </button>
                            </div>
                            <div class="col-md-6">
                                <button class="btn btn-outline-primary w-100 py-2">
                                    <i class="bi bi-facebook me-2"></i>
                                    Facebook
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Depoimentos -->
                <div class="row mt-5 g-4">
                    <div class="col-md-4" data-aos="fade-up" data-aos-delay="400">
                        <div class="testimonial-card p-4">
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-person-circle fs-1 text-primary me-3"></i>
                                <div>
                                    <h6 class="fw-bold mb-0">João Silva</h6>
                                    <small class="text-muted">Vendedor</small>
                                </div>
                            </div>
                            <p class="mb-0 text-muted">
                                <i class="bi bi-quote me-1"></i>
                                Marketplace incrível! Já vendi mais de 50 produtos.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4" data-aos="fade-up" data-aos-delay="500">
                        <div class="testimonial-card p-4">
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-person-circle fs-1 text-success me-3"></i>
                                <div>
                                    <h6 class="fw-bold mb-0">Maria Santos</h6>
                                    <small class="text-muted">Compradora</small>
                                </div>
                            </div>
                            <p class="mb-0 text-muted">
                                <i class="bi bi-quote me-1"></i>
                                Encontrei produtos maravilhosos por aqui!
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4" data-aos="fade-up" data-aos-delay="600">
                        <div class="testimonial-card p-4">
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-person-circle fs-1 text-warning me-3"></i>
                                <div>
                                    <h6 class="fw-bold mb-0">Pedro Oliveira</h6>
                                    <small class="text-muted">Vendedor</small>
                                </div>
                            </div>
                            <p class="mb-0 text-muted">
                                <i class="bi bi-quote me-1"></i>
                                Plataforma fácil de usar e muito segura.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h2 class="display-5 fw-bold">Por que escolher nosso marketplace?</h2>
            <p class="lead text-muted">Benefícios exclusivos para você</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="0">
                <div class="feature-card text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-shield-check text-primary display-4"></i>
                    </div>
                    <h5>Segurança</h5>
                    <p class="text-muted small">Suas informações protegidas</p>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="100">
                <div class="feature-card text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-lightning-charge text-warning display-4"></i>
                    </div>
                    <h5>Rapidez</h5>
                    <p class="text-muted small">Processamento instantâneo</p>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="200">
                <div class="feature-card text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-currency-dollar text-success display-4"></i>
                    </div>
                    <h5>Sem taxas</h5>
                    <p class="text-muted small">Cadastro gratuito</p>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="300">
                <div class="feature-card text-center p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-headset text-info display-4"></i>
                    </div>
                    <h5>Suporte</h5>
                    <p class="text-muted small">Ajuda 24/7</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Hero Section */
    .login-hero-section {
        position: relative;
        overflow: hidden;
    }
    
    .login-hero-section::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 50%);
        animation: rotate 20s linear infinite;
    }
    
    @keyframes rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* Stats Mini Cards */
    .stats-mini-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
    }
    
    .stats-mini-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
    }

    /* Login Card */
    .login-card {
        border-radius: 20px;
        overflow: hidden;
    }
    
    .login-card .nav-pills .nav-link {
        border-radius: 10px;
        padding: 15px;
        color: #6c757d;
        transition: all 0.3s ease;
    }
    
    .login-card .nav-pills .nav-link.active {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        transform: scale(1.02);
        box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
    }
    
    .login-card .form-control {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 15px;
        transition: all 0.3s ease;
    }
    
    .login-card .form-control:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }
    
    .login-card .btn {
        border-radius: 10px;
        transition: all 0.3s ease;
    }
    
    .login-card .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }
    
    .login-card .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
    }
    
    .login-card .btn-success {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        border: none;
    }
    
    .login-card .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(67, 233, 123, 0.3);
    }

    /* Divider */
    .divider {
        position: relative;
        text-align: center;
    }
    
    .divider::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, #dee2e6, transparent);
    }
    
    .divider-text {
        position: relative;
        display: inline-block;
    }

    /* Testimonial Cards */
    .testimonial-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }
    
    .testimonial-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
    }

    /* Feature Cards */
    .feature-card {
        background: white;
        border-radius: 15px;
        transition: all 0.3s ease;
    }
    
    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
    }
    
    .feature-icon {
        animation: pulse 2s ease-in-out infinite;
    }
    
    @keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.1); }
    }

    /* Responsividade */
    @media (max-width: 768px) {
        .login-card .card-body {
            padding: 2rem !important;
        }
        
        .stats-mini-card {
            margin-bottom: 1rem;
        }
    }

    /* Animações de entrada */
    [data-aos] {
        opacity: 0;
        transition: all 0.8s ease;
    }
    
    [data-aos].aos-animate {
        opacity: 1;
    }
</style>

<!-- Script para manter a aba ativa baseada no hash -->
<script>
    // Ativar aba baseado no hash da URL
    if (window.location.hash === '#register') {
        const registerTab = new bootstrap.Tab(document.getElementById('register-tab'));
        registerTab.show();
    }

    // Animar números quando visíveis
    document.addEventListener('DOMContentLoaded', function() {
        const observerOptions = {
            threshold: 0.5
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('aos-animate');
                }
            });
        }, observerOptions);
        
        document.querySelectorAll('[data-aos]').forEach(el => {
            observer.observe(el);
        });
    });
</script>

<%- include('./includes/footer') %>