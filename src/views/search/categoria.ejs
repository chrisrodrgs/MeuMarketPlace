<%- include('../includes/head') %>
<%- include('../includes/nav1') %>

<!-- Breadcrumb -->
<section class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/busca">Busca</a></li>
                <li class="breadcrumb-item active"><%= categoria %></li>
            </ol>
        </nav>
    </div>
</section>

<!-- Header da Categoria -->
<section class="hero-section" style="min-height: 40vh; padding: 60px 0;">
    <div class="container text-center">
        <h1 class="hero-title">
            <span><%= categoria %></span>
        </h1>
        <p class="hero-subtitle">Explore os melhores produtos nesta categoria</p>
        <div class="mt-3">
            <span class="badge bg-primary fs-6"><%= total %> produtos encontrados</span>
        </div>
    </div>
</section>

<!-- Produtos da Categoria -->
<section class="py-5">
    <div class="container">
        <% if (produtos && produtos.length > 0) { %>
            <div class="row g-4">
                <% produtos.forEach((produto, index) => { %>
                <div class="col-md-6 col-lg-4">
                    <a href="/produto/<%= produto.id %>" class="text-decoration-none">
                        <div class="card-elegante h-100">
                            <div class="product-image-elegante" style="height: 200px;">
                                <% if (produto.imagemUrl) { %>
                                    <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>">
                                <% } else { %>
                                    <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                        <i class="bi bi-image text-secondary" style="font-size: 3rem;"></i>
                                    </div>
                                <% } %>
                            </div>
                            <div class="p-3">
                                <h5 class="fw-bold text-truncate"><%= produto.name %></h5>
                                <p class="text-muted small mb-2"><%= produto.description.substring(0, 80) %>...</p>
                                
                                <!-- Avaliações -->
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="text-warning small">
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <i class="bi <%= i <= Math.round(produto.mediaAvaliacoes) ? 'bi-star-fill' : 'bi-star' %>"></i>
                                        <% } %>
                                    </div>
                                    <small class="text-muted">(<%= produto.totalAvaliacoes %>)</small>
                                </div>
                                
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-primary fw-bold h5 mb-0"><%= produto.precoFormatado %></span>
                                    <small class="text-muted">
                                        <i class="bi bi-person-circle"></i> <%= produto.email.split('@')[0] %>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <i class="bi bi-box display-1 text-muted"></i>
                <h3 class="fw-light mt-3">Nenhum produto encontrado</h3>
                <p class="text-muted">Ainda não há produtos cadastrados na categoria <%= categoria %>.</p>
                <a href="/produtos/adicionar" class="btn-elegante primary mt-3">
                    <i class="bi bi-plus-circle"></i> Anunciar produto
                </a>
            </div>
        <% } %>
    </div>
</section>

<!-- Produtos Relacionados -->
<% if (relacionados && relacionados.length > 0) { %>
<section class="bg-light py-5">
    <div class="container">
        <h2 class="fw-light mb-4">Você também pode <span class="fw-bold">gostar</span></h2>
        <div class="row g-4">
            <% relacionados.forEach((produto, index) => { %>
            <div class="col-md-3">
                <a href="/produto/<%= produto.id %>" class="text-decoration-none">
                    <div class="card-elegante h-100">
                        <div class="product-image-elegante" style="height: 150px;">
                            <% if (produto.imagemUrl) { %>
                                <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>">
                            <% } else { %>
                                <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                    <i class="bi bi-image text-secondary" style="font-size: 2rem;"></i>
                                </div>
                            <% } %>
                        </div>
                        <div class="p-3">
                            <h6 class="text-truncate mb-0"><%= produto.name %></h6>
                            <span class="text-primary fw-bold"><%= produto.precoFormatado %></span>
                        </div>
                    </div>
                </a>
            </div>
            <% }) %>
        </div>
    </div>
</section>
<% } %>

<%- include('../includes/footer') %>