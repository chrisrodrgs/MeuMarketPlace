<%- include('../includes/head') %>
<%- include('../includes/nav1') %>

<!-- Header -->
<section class="hero-section" style="min-height: 30vh; padding: 60px 0;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="hero-title">
                    <span>Resultados</span> da Busca
                </h1>
                <p class="hero-subtitle"><%= stats.total %> produto(s) encontrado(s) para "<%= stats.termo %>"</p>
            </div>
            <div class="col-lg-4">
                <form action="/busca" method="GET">
                    <div class="input-group">
                        <input type="text" name="q" class="form-control" placeholder="Buscar..." value="<%= filtros.q || '' %>">
                        <button class="btn-elegante primary" type="submit"><i class="bi bi-search"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Filtros e Resultados -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <!-- Filtros -->
            <div class="col-lg-3 mb-4">
                <div class="card-elegante p-3">
                    <h5 class="fw-semibold mb-3"><i class="bi bi-funnel text-primary me-2"></i>Filtros</h5>
                    <form method="GET">
                        <input type="hidden" name="q" value="<%= filtros.q || '' %>">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Categoria</label>
                            <select name="categoria" class="form-select">
                                <option value="todas">Todas</option>
                                <% categorias.forEach(cat => { %>
                                    <option value="<%= cat.categoria %>" <%= filtros.categoria === cat.categoria ? 'selected' : '' %>><%= cat.categoria %> (<%= cat.total %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Preço</label>
                            <div class="row g-2">
                                <div class="col-6"><input type="number" name="precoMin" class="form-control" placeholder="Mín" value="<%= filtros.precoMin || '' %>"></div>
                                <div class="col-6"><input type="number" name="precoMax" class="form-control" placeholder="Máx" value="<%= filtros.precoMax || '' %>"></div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Avaliação</label>
                            <select name="avaliacao" class="form-select">
                                <option value="0">Qualquer</option>
                                <option value="4" <%= filtros.avaliacao === '4' ? 'selected' : '' %>>4+ estrelas</option>
                                <option value="3" <%= filtros.avaliacao === '3' ? 'selected' : '' %>>3+ estrelas</option>
                                <option value="2" <%= filtros.avaliacao === '2' ? 'selected' : '' %>>2+ estrelas</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ordenar</label>
                            <select name="ordem" class="form-select">
                                <option value="recentes" <%= !filtros.ordem || filtros.ordem === 'recentes' ? 'selected' : '' %>>Mais recentes</option>
                                <option value="melhores_avaliacoes" <%= filtros.ordem === 'melhores_avaliacoes' ? 'selected' : '' %>>Melhores avaliações</option>
                                <option value="preco_asc" <%= filtros.ordem === 'preco_asc' ? 'selected' : '' %>>Menor preço</option>
                                <option value="preco_desc" <%= filtros.ordem === 'preco_desc' ? 'selected' : '' %>>Maior preço</option>
                            </select>
                        </div>
                        <button type="submit" class="btn-elegante primary w-100 mb-2">Aplicar</button>
                        <a href="/busca" class="btn-elegante secondary w-100">Limpar</a>
                    </form>
                </div>
            </div>
            
            <!-- Produtos -->
            <div class="col-lg-9">
                <% if (produtos && produtos.length > 0) { %>
                    <div class="row g-4">
                        <% produtos.forEach(produto => { %>
                        <div class="col-md-6 col-xl-4">
                            <a href="/produto/<%= produto.id %>" class="text-decoration-none">
                                <div class="card-elegante h-100">
                                    <div class="product-image-elegante" style="height: 180px;">
                                        <% if (produto.imagemUrl) { %>
                                            <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>">
                                        <% } else { %>
                                            <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                                <i class="bi bi-image text-secondary" style="font-size: 2rem;"></i>
                                            </div>
                                        <% } %>
                                    </div>
                                    <div class="p-3">
                                        <h6 class="fw-bold text-truncate"><%= produto.name %></h6>
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <div class="text-warning small">
                                                <% for (let i = 1; i <= 5; i++) { %>
                                                    <i class="bi <%= i <= Math.round(produto.mediaAvaliacoes) ? 'bi-star-fill' : 'bi-star' %>"></i>
                                                <% } %>
                                            </div>
                                            <small class="text-muted">(<%= produto.totalAvaliacoes %>)</small>
                                        </div>
                                        <div class="text-primary fw-bold"><%= produto.precoFormatado %></div>
                                        <small class="text-muted"><i class="bi bi-person-circle"></i> <%= produto.email.split('@')[0] %></small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="bi bi-search display-1 text-muted"></i>
                        <h3 class="fw-light mt-3">Nenhum produto encontrado</h3>
                        <p class="text-muted">Tente outros termos ou remova os filtros</p>
                        <a href="/busca" class="btn-elegante primary mt-3">Nova busca</a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('../includes/footer') %>