<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<!-- Breadcrumb -->
<section class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/meus-produtos">Meus Produtos</a></li>
                <li class="breadcrumb-item active">Confirmar Exclusão</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Header -->
<section class="hero-section" style="min-height: 30vh; padding: 60px 0;">
    <div class="container text-center">
        <h1 class="hero-title">
            Confirmar <span>Exclusão</span>
        </h1>
        <p class="hero-subtitle">Tem certeza que deseja deletar este produto?</p>
    </div>
</section>

<!-- Conteúdo -->
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card-elegante border border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Atenção! Esta ação é irreversível
                    </h5>
                </div>
                <div class="card-body p-4">
                    <!-- Mensagens Flash -->
                    <% if (typeof errors !== 'undefined' && errors) { %>
                        <div class="alert alert-danger"><%= errors %></div>
                    <% } %>
                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success"><%= success %></div>
                    <% } %>

                    <!-- Informações do Produto -->
                    <div class="bg-light rounded-3 p-4 mb-4">
                        <div class="d-flex gap-3 align-items-start">
                            <div class="product-image" style="width: 80px; height: 80px;">
                                <% if (produto.imagemUrl) { %>
                                    <img src="<%= produto.imagemUrl %>" class="w-100 h-100 object-fit-cover rounded-2" alt="<%= produto.name %>">
                                <% } else { %>
                                    <div class="w-100 h-100 bg-white rounded-2 d-flex align-items-center justify-content-center">
                                        <i class="bi bi-image text-secondary fs-2"></i>
                                    </div>
                                <% } %>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="mb-1"><%= produto.name %></h5>
                                <p class="text-muted small mb-2"><%= produto.description %></p>
                                <div class="d-flex gap-3">
                                    <span class="badge bg-primary"><%= produto.categoria || 'Geral' %></span>
                                    <span class="badge bg-success">R$ <%= Number(produto.price).toFixed(2) %></span>
                                    <span class="badge bg-secondary">Estoque: <%= produto.estoque || 0 %></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Aviso -->
                    <div class="alert alert-danger mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Você está prestes a deletar este produto permanentemente!</strong>
                        <hr>
                        <p class="mb-0 small">Todos os dados relacionados a este produto serão removidos do sistema. Esta ação não pode ser desfeita.</p>
                    </div>

                    <!-- Botões de Ação -->
                    <div class="d-flex gap-3">
                        <form action="/produtos/deletar/<%= produto.id %>" method="POST" class="flex-grow-1">
                            <button type="submit" class="btn-elegante danger w-100">
                                <i class="bi bi-trash me-2"></i>
                                Sim, deletar permanentemente
                            </button>
                        </form>
                        <a href="/meus-produtos" class="btn-elegante secondary flex-grow-1">
                            <i class="bi bi-x-lg me-2"></i>
                            Cancelar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .product-image {
        background: #f8f9fa;
        border-radius: 8px;
        overflow: hidden;
    }
    .product-image img {
        transition: transform 0.3s ease;
    }
    .product-image img:hover {
        transform: scale(1.05);
    }
</style>

<%- include('./includes/footer') %>