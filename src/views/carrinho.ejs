<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<!-- Breadcrumb -->
<section class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">Carrinho</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Header Centralizado -->
<section class="hero-section" style="min-height: 30vh; padding: 60px 0;">
    <div class="container text-center">
        <h1 class="hero-title">
            Meu <span>Carrinho</span>
        </h1>
        <p class="hero-subtitle mx-auto"><%= quantidadeItens %> <%= quantidadeItens === 1 ? 'item' : 'itens' %></p>
    </div>
</section>

<!-- Conteúdo -->
<div class="container py-5">
    <div class="card-elegante">
        <div class="card-header bg-gradient-primary text-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-cart me-2"></i>Itens do Carrinho</h5>
                <% if (itens && itens.length > 0) { %>
                    <button class="btn btn-link text-white p-0" onclick="limparCarrinho()">
                        <i class="bi bi-trash"></i> Limpar
                    </button>
                <% } %>
            </div>
        </div>
        <div class="card-body p-4">
            <!-- MENSAGENS FLASH CORRIGIDAS - verificando se há conteúdo -->
            <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <%= errors %>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
                <div class="alert alert-success">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <%= success %>
                </div>
            <% } %>

            <% if (itens && itens.length > 0) { %>
                <!-- Aviso de itens indisponíveis -->
                <% if (itensIndisponiveis > 0) { %>
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <%= itensIndisponiveis %> item(ns) com quantidade superior ao estoque disponível.
                    </div>
                <% } %>

                <!-- Lista de itens -->
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Produto</th>
                                <th>Preço</th>
                                <th>Quantidade</th>
                                <th>Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% itens.forEach(item => { %>
                            <tr id="item-<%= item.id %>" class="<%= !item.disponivel ? 'table-warning' : '' %>">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <% if (item.imagemUrl) { %>
                                            <img src="<%= item.imagemUrl %>" style="width: 50px; height: 50px; object-fit: cover;" class="rounded-2">
                                        <% } else { %>
                                            <div class="bg-light rounded-2 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                <i class="bi bi-image text-secondary"></i>
                                            </div>
                                        <% } %>
                                        <div>
                                            <h6 class="mb-0"><%= item.name %></h6>
                                            <small class="text-muted"><%= item.categoria %></small>
                                        </div>
                                    </div>
                                </td>
                                <td class="fw-bold"><%= item.precoFormatado %></td>
                                <td>
                                    <div class="input-group" style="width: 110px;">
                                        <button class="btn btn-outline-secondary btn-sm" onclick="atualizarQuantidade(<%= item.id %>, <%= item.quantidade - 1 %>)" <%= item.quantidade <= 1 ? 'disabled' : '' %>>-</button>
                                        <input type="text" class="form-control text-center" value="<%= item.quantidade %>" readonly style="width: 45px;">
                                        <button class="btn btn-outline-secondary btn-sm" onclick="atualizarQuantidade(<%= item.id %>, <%= item.quantidade + 1 %>)" <%= item.quantidade >= item.estoqueDisponivel ? 'disabled' : '' %>>+</button>
                                    </div>
                                    <% if (!item.disponivel) { %>
                                        <small class="text-danger d-block mt-1"><%= item.mensagemEstoque %></small>
                                    <% } %>
                                </td>
                                <td class="fw-bold text-primary" id="subtotal-<%= item.id %>"><%= item.subtotalFormatado %></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger" onclick="removerItem(<%= item.id %>)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Resumo -->
                <div class="bg-light rounded-3 p-4 mt-4">
                    <div class="row">
                        <div class="col-md-6 offset-md-6">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal (<%= quantidadeItens %> itens):</span>
                                <span class="fw-bold"><%= subtotal %></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Frete:</span>
                                <span>A calcular</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="h5 mb-0">Total:</span>
                                <span class="h5 text-primary mb-0"><%= total %></span>
                            </div>
                            <button class="btn-elegante primary w-100" onclick="finalizarCompra()" <%= itensIndisponiveis > 0 ? 'disabled' : '' %>>
                                <i class="bi bi-check2-circle me-2"></i> Finalizar Compra
                            </button>
                            <a href="/" class="btn-elegante secondary w-100 mt-2">
                                <i class="bi bi-arrow-left me-2"></i> Continuar comprando
                            </a>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <!-- Carrinho Vazio -->
                <div class="text-center py-5">
                    <i class="bi bi-cart-x display-1 text-muted"></i>
                    <h3 class="fw-light mt-3">Seu carrinho está vazio</h3>
                    <p class="text-muted">Explore nossos produtos e adicione itens ao carrinho</p>
                    <a href="/" class="btn-elegante primary mt-3">
                        <i class="bi bi-shop me-2"></i> Continuar Comprando
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
    function atualizarQuantidade(itemId, novaQuantidade) {
        if (novaQuantidade < 1) return;
        fetch(`/carrinho/item/${itemId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ quantidade: novaQuantidade })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) location.reload();
            else alert(data.error);
        })
        .catch(err => console.error('Erro:', err));
    }

    function removerItem(itemId) {
        if (!confirm('Remover este item do carrinho?')) return;
        fetch(`/carrinho/item/${itemId}`, { method: 'DELETE' })
        .then(res => res.json())
        .then(data => { if (data.success) location.reload(); });
    }

    function limparCarrinho() {
        if (!confirm('Limpar todo o carrinho?')) return;
        fetch('/carrinho/limpar', { method: 'POST' })
        .then(res => res.json())
        .then(data => { if (data.success) location.reload(); });
    }

    function finalizarCompra() {
        alert('Funcionalidade de checkout será implementada em breve!');
    }
</script>

<%- include('./includes/footer') %>