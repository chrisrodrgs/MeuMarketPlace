<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<!-- Header -->
<section class="hero-section" style="min-height: 30vh; padding: 60px 0;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="hero-title">
                    Meus <span>Produtos</span>
                </h1>
                <p class="hero-subtitle">Gerencie todos os seus produtos em um só lugar</p>
            </div>
            <a href="/produtos/adicionar" class="btn-elegante primary">
                <i class="bi bi-plus-circle"></i> Novo Produto
            </a>
        </div>
    </div>
</section>

<!-- Conteúdo Principal -->
<div class="container py-4">
    <!-- MENSAGENS FLASH CORRIGIDAS -->
    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill me-2"></i>
            <%= success %>
        </div>
    <% } %>
    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <%= errors %>
        </div>
    <% } %>

    <!-- Cards de Estatísticas -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="stat-card-elegante">
                <i class="bi bi-box"></i>
                <h3><%= produtos.length %></h3>
                <p>Total de produtos</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card-elegante">
                <i class="bi bi-check-circle"></i>
                <h3><%= produtos.filter(p => p.status === 'ativo').length %></h3>
                <p>Produtos ativos</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card-elegante">
                <i class="bi bi-x-circle"></i>
                <h3><%= produtos.filter(p => p.status !== 'ativo').length %></h3>
                <p>Produtos inativos</p>
            </div>
        </div>
    </div>

    <!-- Lista de Produtos -->
    <% if (produtos && produtos.length > 0) { %>
        <div class="row g-4">
            <% produtos.forEach(produto => { %>
                <div class="col-md-6 col-lg-3">
                    <div class="card-elegante h-100 <%= produto.status !== 'ativo' ? 'opacity-75' : '' %>">
                        <div class="position-relative">
                            <div class="product-image-elegante" style="height: 180px;">
                                <% if (produto.imagemUrl) { %>
                                    <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>">
                                <% } else { %>
                                    <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                        <i class="bi bi-image text-secondary" style="font-size: 2rem;"></i>
                                    </div>
                                <% } %>
                            </div>
                            <div class="position-absolute top-0 start-0 m-2">
                                <span class="badge bg-<%= produto.status === 'ativo' ? 'success' : 'secondary' %>">
                                    <i class="bi bi-<%= produto.status === 'ativo' ? 'check-circle' : 'x-circle' %>"></i>
                                    <%= produto.status === 'ativo' ? 'Ativo' : 'Inativo' %>
                                </span>
                            </div>
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-primary"><%= produto.categoria || 'Geral' %></span>
                            </div>
                            <div class="position-absolute bottom-0 end-0 m-2">
                                <span class="badge bg-dark">
                                    <i class="bi bi-box"></i> <%= produto.estoque || 0 %>
                                </span>
                            </div>
                        </div>
                        <div class="p-3">
                            <h5 class="fw-bold text-truncate"><%= produto.name %></h5>
                            <h4 class="text-primary fw-bold">R$ <%= Number(produto.price).toFixed(2) %></h4>
                            <div class="d-flex gap-2 mt-3">
                                <a href="/produtos/editar/<%= produto.id %>" class="btn-elegante primary small flex-grow-1">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                                <a href="/produtos/deletar/<%= produto.id %>" class="btn-elegante danger small flex-grow-1" 
                                   onclick="return confirm('Deletar este produto?')">
                                    <i class="bi bi-trash"></i> Deletar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="text-center py-5">
            <i class="bi bi-box display-1 text-muted"></i>
            <h3 class="fw-light mt-3">Nenhum produto cadastrado</h3>
            <p class="text-muted">Comece agora mesmo a vender seus produtos!</p>
            <a href="/produtos/adicionar" class="btn-elegante primary mt-3">
                <i class="bi bi-plus-circle"></i> Adicionar Primeiro Produto
            </a>
        </div>
    <% } %>
</div>

<%- include('./includes/footer') %>