<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <!-- Header com saudação e avatar -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 pb-2 border-bottom">
                <div class="d-flex align-items-center">
                    <% if (user.avatar) { %>
                        <img src="/<%= user.avatar %>" alt="Avatar" 
                             class="rounded-circle me-3 border border-2 border-primary"
                             style="width: 60px; height: 60px; object-fit: cover;">
                    <% } else { %>
                        <div class="bg-light rounded-circle me-3 d-flex align-items-center justify-content-center border border-2 border-primary"
                             style="width: 60px; height: 60px;">
                            <i class="bi bi-person-circle text-secondary" style="font-size: 2rem;"></i>
                        </div>
                    <% } %>
                    <div>
                        <h1 class="display-5 fw-bold text-dark mb-1">
                            <i class="bi bi-shop text-primary me-2"></i> Minha Vitrine
                        </h1>
                        <p class="text-secondary-emphasis lead small">
                            Bem-vindo(a) de volta, <span class="fw-semibold text-dark"><%= user.email.split('@')[0] %></span>
                        </p>
                    </div>
                </div>
                <div class="mt-3 mt-md-0">
                    <a href="/produtos/adicionar" class="btn btn-primary btn-lg shadow-sm px-4">
                        <i class="bi bi-plus-circle me-2"></i> 
                        <span class="d-none d-sm-inline">Anunciar Novo Produto</span>
                        <span class="d-sm-none">Anunciar</span>
                    </a>
                </div>
            </div>

            <!-- Mensagens Flash -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success alert-dismissible fade show border-0 border-start border-5 border-success shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                        <div><%= success %></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (typeof errors !== 'undefined' && errors) { %>
                <div class="alert alert-danger alert-dismissible fade show border-0 border-start border-5 border-danger shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
                        <div><%= errors %></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- Dashboard Cards -->
            <% if (produtos && produtos.length > 0) { %>
                <div class="row g-4 mb-5">
                    <div class="col-md-6">
                        <div class="card border-0 bg-gradient-primary text-white shadow-lg h-100">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="small text-white-50 text-uppercase tracking-wider">Total no catálogo</span>
                                        <div class="display-3 fw-bold mt-2"><%= produtos.length %></div>
                                        <p class="mb-0 mt-2 small text-white-50">
                                            <i class="bi bi-box-seam me-1"></i> produtos anunciados
                                        </p>
                                    </div>
                                    <div class="bg-white bg-opacity-25 rounded-circle p-4">
                                        <i class="bi bi-grid-3x3-gap-fill fs-1"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="card border-0 bg-gradient-success text-white shadow-lg h-100">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="small text-white-50 text-uppercase tracking-wider">Valor do estoque</span>
                                        <div class="display-3 fw-bold mt-2">
                                            R$ <% 
                                                let total = 0;
                                                produtos.forEach(p => { total += Number(p.price); });
                                            %><%= total.toFixed(2) %>
                                        </div>
                                        <p class="mb-0 mt-2 small text-white-50">
                                            <i class="bi bi-cash-stack me-1"></i> investimento total
                                        </p>
                                    </div>
                                    <div class="bg-white bg-opacity-25 rounded-circle p-4">
                                        <i class="bi bi-coin fs-1"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Grid de Produtos -->
                <div class="mb-4">
                    <div class="d-flex align-items-center mb-4">
                        <h5 class="fw-semibold text-uppercase tracking-wider text-secondary mb-0">
                            <i class="bi bi-grid me-2"></i> Seus anúncios
                        </h5>
                        <span class="badge bg-light text-dark rounded-pill ms-3 px-3 py-2"><%= produtos.length %> itens</span>
                    </div>
                    
                    <div class="row g-4">
                        <% produtos.forEach(produto => { %>
                            <div class="col-md-6 col-lg-4">
                                <div class="card product-card h-100 border-0 shadow-hover">
                                    <!-- Avatar do vendedor no canto superior -->
                                    <div class="position-absolute top-0 start-0 m-3 z-index-1">
                                        <div class="d-flex align-items-center bg-white bg-opacity-75 rounded-pill px-2 py-1 shadow-sm">
                                            <% if (user.avatar) { %>
                                                <img src="/<%= user.avatar %>" alt="Avatar" 
                                                     class="rounded-circle me-1"
                                                     style="width: 24px; height: 24px; object-fit: cover;">
                                            <% } else { %>
                                                <i class="bi bi-person-circle text-primary me-1"></i>
                                            <% } %>
                                            <span class="small fw-semibold">Você</span>
                                        </div>
                                    </div>

                                    <!-- Badge de categoria -->
                                    <div class="position-absolute top-0 end-0 m-3 z-index-1">
                                        <span class="badge bg-light text-dark px-3 py-2 rounded-pill shadow-sm">
                                            <i class="bi bi-tag me-1"></i> <%= produto.categoria || 'Geral' %>
                                        </span>
                                    </div>
                                    
                                    <!-- Imagem do produto -->
                                    <div class="product-image">
                                        <% if (produto.imagem) { 
                                            let nomeArquivo = produto.imagem.split('/').pop();
                                        %>
                                            <img src="/uploads/produtos/<%= nomeArquivo %>" 
                                                 alt="<%= produto.name %>" 
                                                 class="w-100 h-100 object-fit-cover">
                                        <% } else { %>
                                            <div class="d-flex align-items-center justify-content-center h-100">
                                                <i class="bi bi-image text-secondary" style="font-size: 3rem; opacity: 0.5;"></i>
                                            </div>
                                        <% } %>
                                    </div>
                                    
                                    <div class="card-body p-4">
                                        <!-- Título e data -->
                                        <div class="mb-3">
                                            <h5 class="card-title fw-bold mb-2 text-truncate"><%= produto.name %></h5>
                                            <div class="d-flex align-items-center small text-secondary">
                                                <i class="bi bi-calendar3 me-1"></i>
                                                <%= new Date(produto.data_criacao).toLocaleDateString('pt-BR', {year: 'numeric', month: 'short', day: 'numeric'}) %>
                                            </div>
                                        </div>
                                        
                                        <!-- Descrição -->
                                        <p class="card-text text-secondary mb-3 small">
                                            <%= produto.description.length > 80 ? produto.description.substring(0, 80) + '...' : produto.description %>
                                        </p>
                                        
                                        <!-- Preço e ações -->
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <span class="small text-secondary">Preço</span>
                                                <h4 class="text-primary fw-bold mb-0">R$ <%= Number(produto.price).toFixed(2).replace('.', ',') %></h4>
                                            </div>
                                            <div class="btn-group">
                                                <a href="/produtos/editar/<%= produto.id %>" 
                                                   class="btn btn-sm btn-outline-primary rounded-circle p-2 me-2" 
                                                   data-bs-toggle="tooltip" title="Editar produto">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a href="/produtos/deletar/<%= produto.id %>" 
                                                   class="btn btn-sm btn-outline-danger rounded-circle p-2" 
                                                   data-bs-toggle="tooltip" title="Deletar produto">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% } else { %>
                <!-- Estado vazio -->
                <div class="row justify-content-center mt-5 pt-5">
                    <div class="col-md-8 col-lg-6 text-center">
                        <div class="empty-state p-5">
                            <div class="empty-state-icon mb-4">
                                <i class="bi bi-box text-primary" style="font-size: 5rem; opacity: 0.3;"></i>
                            </div>
                            <h2 class="fw-light mb-3">Sua vitrine está vazia</h2>
                            <p class="text-secondary mb-4">
                                Comece a vender agora mesmo! Anuncie seu primeiro produto e 
                                alcance milhares de clientes em todo o Brasil.
                            </p>
                            
                            <!-- Cards de dicas -->
                            <div class="row g-3 mb-5">
                                <div class="col-4">
                                    <div class="bg-light rounded-3 p-3">
                                        <i class="bi bi-camera text-primary fs-3"></i>
                                        <p class="small mt-2 mb-0">Fotos de qualidade</p>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="bg-light rounded-3 p-3">
                                        <i class="bi bi-chat-dots text-primary fs-3"></i>
                                        <p class="small mt-2 mb-0">Descrição detalhada</p>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="bg-light rounded-3 p-3">
                                        <i class="bi bi-tags text-primary fs-3"></i>
                                        <p class="small mt-2 mb-0">Preço competitivo</p>
                                    </div>
                                </div>
                            </div>
                            
                            <a href="/produtos/adicionar" class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow">
                                <i class="bi bi-plus-circle me-2"></i> Anunciar Produto
                            </a>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- CSS customizado -->
<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    .bg-gradient-success {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
    }
    
    .tracking-wider {
        letter-spacing: 0.05em;
    }
    
    .product-card {
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background: white;
    }
    
    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.15) !important;
    }
    
    .product-image {
        height: 180px;
        background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
        position: relative;
        overflow: hidden;
    }
    
    .product-image img {
        transition: transform 0.3s ease;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .product-card:hover .product-image img {
        transform: scale(1.05);
    }
    
    .z-index-1 {
        z-index: 1;
    }
    
    .text-white-50 {
        color: rgba(255, 255, 255, 0.7) !important;
    }
    
    .shadow-hover {
        transition: box-shadow 0.3s ease;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }
    
    .empty-state {
        animation: fadeInUp 0.6s ease;
    }
    
    .empty-state-icon {
        animation: float 3s ease-in-out infinite;
    }
    
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    @keyframes float {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }
    
    @media (max-width: 768px) {
        .display-3 {
            font-size: 2rem;
        }
        
        .product-image {
            height: 140px;
        }
        
        .rounded-circle.p-4 {
            padding: 1rem !important;
        }
    }
</style>

<!-- Inicializar tooltips -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function(tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
</script>

<%- include('./includes/footer') %>