<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<!-- Breadcrumb -->
<section class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">Produtos do Vendedor</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Header -->
<section class="hero-section" style="min-height: 40vh; padding: 60px 0;">
    <div class="container text-center">
        <h1 class="hero-title">
            Produtos do <span>Vendedor</span>
        </h1>
        <p class="hero-subtitle">Confira todos os produtos disponíveis deste vendedor</p>
        <div class="mt-3">
            <span class="badge bg-primary fs-6"><%= produtos.length %> produtos encontrados</span>
        </div>
    </div>
</section>

<!-- Produtos -->
<section class="py-5">
    <div class="container">
        <% if (produtos && produtos.length > 0) { %>
            <div class="row g-4">
                <% produtos.forEach(produto => { %>
                <div class="col-md-6 col-lg-4">
                    <a href="/produto/<%= produto.id %>" class="text-decoration-none">
                        <div class="card-elegante h-100">
                            <!-- Imagem -->
                            <div class="product-image-elegante" style="height: 200px;">
                                <% if (produto.imagemUrl) { %>
                                    <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>">
                                <% } else { %>
                                    <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                        <i class="bi bi-image text-secondary" style="font-size: 3rem;"></i>
                                    </div>
                                <% } %>
                            </div>
                            
                            <!-- Conteúdo -->
                            <div class="p-3">
                                <h5 class="fw-bold text-truncate"><%= produto.name %></h5>
                                <p class="text-muted small mb-2"><%= produto.description.substring(0, 80) %>...</p>
                                
                                <!-- Categoria -->
                                <span class="badge bg-primary mb-2">
                                    <i class="bi bi-tag me-1"></i> <%= produto.categoria || 'Geral' %>
                                </span>
                                
                                <!-- Avaliações -->
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="text-warning small">
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <i class="bi <%= i <= Math.round(produto.mediaAvaliacoes) ? 'bi-star-fill' : 'bi-star' %>"></i>
                                        <% } %>
                                    </div>
                                    <small class="text-muted">(<%= produto.totalAvaliacoes || 0 %>)</small>
                                </div>
                                
                                <!-- Preço e Estoque -->
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-primary fw-bold h5 mb-0"><%= produto.precoFormatado %></span>
                                    <span class="badge bg-<%= (produto.estoque || 0) > 0 ? 'success' : 'secondary' %>">
                                        <i class="bi bi-box"></i> <%= produto.estoque || 0 %> unid.
                                    </span>
                                </div>
                                
                                <!-- Vendedor -->
                                <div class="mt-2">
                                    <small class="text-muted">
                                        <i class="bi bi-person-circle"></i> 
                                        Vendido por <strong><%= produto.email.split('@')[0] %></strong>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <i class="bi bi-box display-1 text-muted"></i>
                <h3 class="fw-light mt-3">Nenhum produto encontrado</h3>
                <p class="text-muted">Este vendedor ainda não possui produtos cadastrados.</p>
                <a href="/" class="btn-elegante primary mt-3">
                    <i class="bi bi-house"></i> Voltar para home
                </a>
            </div>
        <% } %>
    </div>
</section>

<%- include('./includes/footer') %>