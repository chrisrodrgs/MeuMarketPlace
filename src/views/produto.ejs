<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<!-- Breadcrumb -->
<section class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/categoria/<%= encodeURIComponent(produto.categoria) %>"><%= produto.categoria %></a></li>
                <li class="breadcrumb-item active"><%= produto.name %></li>
            </ol>
        </nav>
    </div>
</section>

<!-- Produto -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="product-image-elegante" style="height: 400px;">
                    <% if (produto.imagemUrl) { %>
                        <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>" class="w-100 h-100 object-fit-cover rounded-4">
                    <% } else { %>
                        <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center rounded-4">
                            <i class="bi bi-image text-secondary" style="font-size: 4rem;"></i>
                        </div>
                    <% } %>
                </div>
            </div>
            <div class="col-md-6">
                <span class="badge bg-primary mb-3"><%= produto.categoria %></span>
                <h1 class="fw-bold mb-3"><%= produto.name %></h1>
                
                <!-- Avaliações -->
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="d-flex">
                        <% for (let i = 1; i <= 5; i++) { %>
                            <i class="bi <%= i <= Math.round(stats.media) ? 'bi-star-fill' : 'bi-star' %> text-warning"></i>
                        <% } %>
                    </div>
                    <span class="text-muted"><%= stats.media %> (<%= stats.total %> avaliações)</span>
                </div>
                
                <h2 class="text-primary fw-bold mb-3"><%= produto.precoFormatado %></h2>
                <p class="text-muted mb-4"><%= produto.description %></p>
                
                <div class="mb-4">
                    <span class="badge bg-<%= produto.estoque > 0 ? 'success' : 'danger' %>">
                        <i class="bi bi-box"></i> <%= produto.estoque > 0 ? `${produto.estoque} unidades em estoque` : 'Esgotado' %>
                    </span>
                </div>
                
                <div class="d-flex gap-3">
                    <button class="btn-elegante primary flex-grow-1" onclick="adicionarAoCarrinho(<%= produto.id %>)" <%= produto.estoque <= 0 ? 'disabled' : '' %>>
                        <i class="bi bi-cart-plus"></i> Adicionar ao Carrinho
                    </button>
                    <button class="btn-elegante outline">
                        <i class="bi bi-heart"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Avaliações -->
<section class="bg-light py-5">
    <div class="container">
        <h2 class="fw-light mb-4">Avaliações <span class="fw-bold">do Produto</span></h2>
        
        <!-- Resumo -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="text-center p-4 bg-white rounded-4 shadow-sm">
                    <div class="display-1 fw-bold text-primary"><%= stats.media %></div>
                    <div class="text-warning fs-4">
                        <% for (let i = 1; i <= 5; i++) { %>
                            <i class="bi <%= i <= Math.round(stats.media) ? 'bi-star-fill' : 'bi-star' %>"></i>
                        <% } %>
                    </div>
                    <div class="text-muted"><%= stats.total %> avaliações</div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="bg-white p-4 rounded-4 shadow-sm">
                    <% for (let i = 5; i >= 1; i--) { %>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="text-warning"><%= i %> <i class="bi bi-star-fill"></i></span>
                            <div class="progress flex-grow-1" style="height: 8px;">
                                <div class="progress-bar" style="width: <%= stats.total > 0 ? (stats.distribuicao[i] / stats.total * 100) : 0 %"></div>
                            </div>
                            <span class="text-muted"><%= stats.distribuicao[i] %></span>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
        
        <!-- Formulário de Avaliação -->
        <% if (user) { %>
        <div class="bg-white p-4 rounded-4 shadow-sm mb-4">
            <h4 class="mb-3"><%= avaliacaoUsuario ? 'Editar avaliação' : 'Avaliar este produto' %></h4>
            <form action="/produto/<%= produto.id %>/avaliar" method="POST">
                <div class="d-flex flex-row-reverse justify-content-end gap-1 mb-3">
                    <input type="radio" name="nota" value="5" id="star5" <%= avaliacaoUsuario && avaliacaoUsuario.nota == 5 ? 'checked' : '' %> required>
                    <label for="star5" class="fs-2 text-secondary"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" name="nota" value="4" id="star4" <%= avaliacaoUsuario && avaliacaoUsuario.nota == 4 ? 'checked' : '' %>>
                    <label for="star4" class="fs-2 text-secondary"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" name="nota" value="3" id="star3" <%= avaliacaoUsuario && avaliacaoUsuario.nota == 3 ? 'checked' : '' %>>
                    <label for="star3" class="fs-2 text-secondary"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" name="nota" value="2" id="star2" <%= avaliacaoUsuario && avaliacaoUsuario.nota == 2 ? 'checked' : '' %>>
                    <label for="star2" class="fs-2 text-secondary"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" name="nota" value="1" id="star1" <%= avaliacaoUsuario && avaliacaoUsuario.nota == 1 ? 'checked' : '' %>>
                    <label for="star1" class="fs-2 text-secondary"><i class="bi bi-star-fill"></i></label>
                </div>
                <textarea name="comentario" class="form-control mb-3" rows="3" placeholder="Conte sua experiência..."><%= avaliacaoUsuario ? avaliacaoUsuario.comentario : '' %></textarea>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn-elegante primary"><%= avaliacaoUsuario ? 'Atualizar' : 'Enviar' %></button>
                    <% if (avaliacaoUsuario) { %>
                        <a href="/avaliacao/<%= avaliacaoUsuario.id %>/deletar" class="btn-elegante danger" onclick="return confirm('Remover avaliação?')">Remover</a>
                    <% } %>
                </div>
            </form>
        </div>
        <% } else { %>
        <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i><a href="/login/index" class="alert-link">Faça login</a> para avaliar este produto.</div>
        <% } %>
        
        <!-- Lista de Avaliações -->
        <% if (avaliacoes && avaliacoes.length > 0) { %>
            <div class="mt-4">
                <% avaliacoes.forEach(av => { %>
                <div class="bg-white p-4 rounded-4 shadow-sm mb-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex align-items-center gap-3">
                            <% if (av.avatarUrl) { %>
                                <img src="<%= av.avatarUrl %>" class="rounded-circle" style="width: 40px; height: 40px;">
                            <% } else { %>
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                            <% } %>
                            <div>
                                <strong><%= av.email.split('@')[0] %></strong>
                                <div class="text-warning">
                                    <% for (let i = 1; i <= 5; i++) { %>
                                        <i class="bi <%= i <= av.nota ? 'bi-star-fill' : 'bi-star' %>"></i>
                                    <% } %>
                                </div>
                                <small class="text-muted"><%= av.dataFormatada %></small>
                            </div>
                        </div>
                    </div>
                    <% if (av.comentario) { %>
                        <p class="mt-3 mb-0"><%= av.comentario %></p>
                    <% } %>
                </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <i class="bi bi-star display-1 text-muted"></i>
                <h4 class="fw-light mt-3">Nenhuma avaliação ainda</h4>
                <p class="text-muted">Seja o primeiro a avaliar este produto!</p>
            </div>
        <% } %>
    </div>
</section>

<!-- Produtos Relacionados -->
<% if (relacionados && relacionados.length > 0) { %>
<section class="py-5">
    <div class="container">
        <h2 class="fw-light mb-4">Produtos <span class="fw-bold">Relacionados</span></h2>
        <div class="row g-4">
            <% relacionados.forEach(rel => { %>
            <div class="col-md-3">
                <a href="/produto/<%= rel.id %>" class="text-decoration-none">
                    <div class="card-elegante">
                        <div class="product-image-elegante" style="height: 150px;">
                            <% if (rel.imagemUrl) { %>
                                <img src="<%= rel.imagemUrl %>" alt="<%= rel.name %>">
                            <% } else { %>
                                <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                    <i class="bi bi-image text-secondary"></i>
                                </div>
                            <% } %>
                        </div>
                        <div class="p-3">
                            <h6 class="text-truncate"><%= rel.name %></h6>
                            <span class="text-primary fw-bold"><%= rel.precoFormatado %></span>
                        </div>
                    </div>
                </a>
            </div>
            <% }) %>
        </div>
    </div>
</section>
<% } %>

<script>
    function adicionarAoCarrinho(produtoId) {
        fetch('/carrinho/adicionar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ produtoId: produtoId, quantidade: 1 })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                const badge = document.getElementById('carrinhoBadge');
                if (badge) {
                    badge.textContent = data.totalItens;
                    badge.style.display = 'inline';
                }
                alert('Produto adicionado ao carrinho!');
            } else if (data.error) {
                alert(data.error);
            }
        });
    }
</script>

<style>
    .product-image-elegante { overflow: hidden; }
    .product-image-elegante img { transition: transform 0.3s ease; }
    .product-image-elegante:hover img { transform: scale(1.05); }
    input[type="radio"] { display: none; }
    input[type="radio"] + label { cursor: pointer; transition: color 0.2s; }
    input[type="radio"]:checked + label { color: #ffd700; }
    input[type="radio"]:not(:checked) + label { color: #e0e0e0; }
    input[type="radio"] + label:hover { color: #ffd700; }
</style>

<%- include('./includes/footer') %>