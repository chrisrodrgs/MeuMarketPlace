<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<!-- Script para busca rápida -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchInput');
    const resultsDiv = document.querySelector('.quick-search-results');
    let timeoutId;
    
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            clearTimeout(timeoutId);
            const term = this.value.trim();
            
            if (term.length < 2) {
                resultsDiv.classList.add('d-none');
                return;
            }
            
            timeoutId = setTimeout(async () => {
                try {
                    const response = await fetch(`/busca/rapida?q=${encodeURIComponent(term)}`);
                    const data = await response.json();
                    
                    if (data.produtos.length > 0) {
                        resultsDiv.innerHTML = data.produtos.map(prod => `
                            <a href="/busca?q=${encodeURIComponent(prod.name)}" class="text-decoration-none">
                                <div class="p-3 border-bottom hover-bg-light">
                                    <div class="d-flex align-items-center">
                                        ${prod.imagem ? 
                                            `<img src="${prod.imagem}" class="rounded me-3" style="width: 40px; height: 40px; object-fit: cover;">` :
                                            `<div class="bg-light rounded me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="bi bi-image text-secondary"></i>
                                            </div>`
                                        }
                                        <div class="flex-grow-1">
                                            <div class="fw-bold text-dark">${prod.name}</div>
                                            <div class="small text-muted">
                                                <span class="text-success">${prod.price}</span>
                                                <span class="mx-2">•</span>
                                                <span>${prod.vendedor}</span>
                                            </div>
                                            ${prod.mediaAvaliacoes ? `
                                            <div class="small">
                                                ${'⭐'.repeat(Math.round(prod.mediaAvaliacoes))} (${prod.mediaAvaliacoes})
                                            </div>
                                            ` : ''}
                                        </div>
                                    </div>
                                </div>
                            </a>
                        `).join('');
                        resultsDiv.classList.remove('d-none');
                    } else {
                        resultsDiv.innerHTML = '<div class="p-3 text-muted text-center">Nenhum produto encontrado</div>';
                        resultsDiv.classList.remove('d-none');
                    }
                } catch (error) {
                    console.error('Erro na busca rápida:', error);
                }
            }, 300);
        });
        
        // Fechar resultados ao clicar fora
        document.addEventListener('click', function(e) {
            if (!searchInput.contains(e.target) && !resultsDiv.contains(e.target)) {
                resultsDiv.classList.add('d-none');
            }
        });
    }
    
    // Atualizar contagem do carrinho
    function atualizarCarrinhoBadge() {
        fetch('/carrinho/contagem')
            .then(res => res.json())
            .then(data => {
                const badge = document.getElementById('carrinhoBadge');
                if (data.total > 0) {
                    badge.textContent = data.total;
                    badge.style.display = 'inline';
                } else {
                    badge.style.display = 'none';
                }
            })
            .catch(err => console.error('Erro ao carregar carrinho:', err));
    }
    
    // Atualizar a cada 30 segundos
    atualizarCarrinhoBadge();
    setInterval(atualizarCarrinhoBadge, 30000);
});
</script>

<style>
.hover-bg-light:hover {
    background-color: #f8f9fa;
}
.quick-search-results {
    border: 1px solid rgba(0,0,0,0.1);
}
</style>