<!-- Chat Widget Flutuante - Sempre visível -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* ===== VARIÁVEIS ===== */
    :root {
        --chat-primary: rgba(102, 126, 234, 0.9);
        --chat-secondary: rgba(118, 75, 162, 0.9);
        --chat-bg: rgba(255, 255, 255, 0.98);
        --chat-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        --chat-border: rgba(255, 255, 255, 0.2);
        --text-dark: #2d3436;
        --text-light: #636e72;
        --gradient: linear-gradient(135deg, var(--chat-primary), var(--chat-secondary));
    }

    /* ===== BOTÃO FLUTUANTE ===== */
    .chat-toggle-button {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 26px;
        cursor: pointer;
        box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
        transition: all 0.3s ease;
        z-index: 9999;
        border: 2px solid rgba(255, 255, 255, 0.2);
    }

    .chat-toggle-button:hover {
        transform: scale(1.1);
        box-shadow: 0 15px 35px rgba(102, 126, 234, 0.6);
    }

    .chat-toggle-button .badge {
        position: absolute;
        top: -5px;
        right: -5px;
        background: #ff4757;
        color: white;
        border-radius: 50%;
        padding: 4px 7px;
        font-size: 11px;
        font-weight: bold;
        min-width: 20px;
        text-align: center;
        border: 2px solid white;
    }

    /* ===== WIDGET PRINCIPAL ===== */
    .chat-widget {
        position: fixed;
        bottom: 100px;
        right: 30px;
        width: 320px;
        background: white;
        border-radius: 20px;
        box-shadow: var(--chat-shadow);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        z-index: 9998;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(102, 126, 234, 0.1);
        opacity: 0;
        transform: translateY(20px);
        pointer-events: none;
    }

    .chat-widget.open {
        opacity: 1;
        transform: translateY(0);
        pointer-events: all;
    }

    .chat-widget.minimized {
        width: 280px;
        transform: translateY(0);
    }

    /* ===== HEADER ===== */
    .chat-header {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        padding: 15px 18px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chat-header h6 {
        margin: 0;
        font-size: 15px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chat-header h6 i {
        font-size: 18px;
    }

    .chat-header .badge {
        background: #ff4757;
        color: white;
        border-radius: 12px;
        padding: 2px 8px;
        font-size: 11px;
        margin-left: 8px;
    }

    .chat-header-actions {
        display: flex;
        gap: 12px;
    }

    .chat-header-actions i {
        cursor: pointer;
        font-size: 16px;
        opacity: 0.8;
        transition: opacity 0.2s;
    }

    .chat-header-actions i:hover {
        opacity: 1;
    }

    /* ===== CORPO DO CHAT ===== */
    .chat-body {
        max-height: 400px;
        overflow-y: auto;
        background: #fafafa;
    }

    /* ===== LOGIN PROMPT - VERSÃO ELEGANTE E COMPACTA ===== */
    .login-prompt {
        padding: 30px 20px;
        text-align: center;
        background: white;
    }

    .login-prompt-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
    }

    .login-prompt-icon i {
        font-size: 32px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .login-prompt h4 {
        font-size: 16px;
        font-weight: 600;
        color: #2d3436;
        margin-bottom: 6px;
    }

    .login-prompt p {
        font-size: 13px;
        color: #636e72;
        margin-bottom: 20px;
        line-height: 1.5;
        padding: 0 10px;
    }

    .login-prompt-buttons {
        display: flex;
        gap: 8px;
        justify-content: center;
    }

    .login-btn {
        padding: 10px 20px;
        border-radius: 25px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .login-btn.primary {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        border: none;
    }

    .login-btn.primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
    }

    .login-btn.secondary {
        background: white;
        color: #667eea;
        border: 1px solid rgba(102, 126, 234, 0.3);
    }

    .login-btn.secondary:hover {
        background: #f8f9fa;
        border-color: #667eea;
    }

    /* ===== CHAT INTERFACE PARA LOGADOS ===== */
    .chat-messages-container {
        padding: 15px;
        min-height: 300px;
        max-height: 300px;
        overflow-y: auto;
    }

    .message-wrapper {
        margin-bottom: 12px;
    }

    .message {
        max-width: 85%;
        padding: 10px 12px;
        border-radius: 15px;
        font-size: 13px;
        line-height: 1.4;
        word-wrap: break-word;
    }

    .message.sent {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        margin-left: auto;
        border-bottom-right-radius: 4px;
    }

    .message.received {
        background: white;
        color: #2d3436;
        margin-right: auto;
        border-bottom-left-radius: 4px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.03);
    }

    .message .sender-name {
        font-size: 10px;
        opacity: 0.7;
        margin-bottom: 3px;
    }

    .message .time {
        font-size: 9px;
        opacity: 0.6;
        margin-top: 4px;
        text-align: right;
    }

    /* ===== INPUT AREA ===== */
    .chat-input-container {
        padding: 12px 15px;
        background: white;
        border-top: 1px solid rgba(0,0,0,0.05);
    }

    .chat-input-wrapper {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .chat-input-wrapper input {
        flex: 1;
        border: 1px solid #e9ecef;
        border-radius: 25px;
        padding: 10px 15px;
        font-size: 13px;
        outline: none;
        transition: all 0.2s;
    }

    .chat-input-wrapper input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .chat-input-wrapper button {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        border: none;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .chat-input-wrapper button:hover {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
    }

    /* ===== TYPING INDICATOR ===== */
    .typing-indicator {
        padding: 8px 15px;
        font-size: 11px;
        color: #636e72;
        font-style: italic;
        display: flex;
        align-items: center;
        gap: 5px;
        background: #f8f9fa;
    }

    .typing-indicator .dots {
        display: flex;
        gap: 3px;
    }

    .typing-indicator .dots span {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #667eea;
        animation: typingDot 1.4s infinite;
    }

    @keyframes typingDot {
        0%, 60%, 100% { transform: translateY(0); }
        30% { transform: translateY(-5px); }
    }

    /* ===== EMPTY STATE ===== */
    .empty-chat {
        text-align: center;
        padding: 40px 15px;
        color: #adb5bd;
    }

    .empty-chat i {
        font-size: 40px;
        margin-bottom: 10px;
        opacity: 0.5;
    }

    .empty-chat h5 {
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 5px;
        color: #495057;
    }

    .empty-chat p {
        font-size: 12px;
        margin: 0;
    }

    /* ===== LOADING ===== */
    .chat-loading {
        padding: 60px 0;
        text-align: center;
    }

    .spinner {
        width: 30px;
        height: 30px;
        border: 2px solid rgba(102, 126, 234, 0.1);
        border-top-color: #667eea;
        border-radius: 50%;
        margin: 0 auto;
        animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* ===== RESPONSIVIDADE ===== */
    @media (max-width: 768px) {
        .chat-widget {
            width: 100%;
            bottom: 0;
            right: 0;
            border-radius: 20px 20px 0 0;
        }

        .chat-widget.minimized {
            width: 100%;
        }

        .chat-toggle-button {
            bottom: 15px;
            right: 15px;
            width: 55px;
            height: 55px;
            font-size: 24px;
        }
    }
</style>

<!-- Botão Flutuante -->
<button class="chat-toggle-button" id="chatToggleButton">
    <i class="bi bi-chat-dots"></i>
    <span class="badge" id="unreadBadge" style="display: none;">0</span>
</button>

<!-- Widget do Chat -->
<div class="chat-widget" id="chatWidget">
    <div class="chat-header" id="chatHeader">
        <h6>
            <i class="bi bi-headset"></i>
            <span>Atendimento</span>
            <span class="badge" id="headerUnreadBadge" style="display: none;">0</span>
        </h6>
        <div class="chat-header-actions">
            <i class="bi bi-dash-lg" id="minimizeChat" title="Minimizar"></i>
            <i class="bi bi-x-lg" id="closeChat" title="Fechar"></i>
        </div>
    </div>
    
    <div class="chat-body" id="chatBody"></div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
(function() {
    // Configuração
    var isUserLoggedIn = <%= user ? 'true' : 'false' %>;
    var userId = '<%= user ? user.id : '' %>';
    var userEmail = '<%= user ? user.email : '' %>';
    var isAdmin = <%= user && user.isAdmin ? 1 : 0 %>;
    
    // Elementos DOM
    var chatWidget = document.getElementById('chatWidget');
    var chatToggleButton = document.getElementById('chatToggleButton');
    var chatHeader = document.getElementById('chatHeader');
    var minimizeBtn = document.getElementById('minimizeChat');
    var closeBtn = document.getElementById('closeChat');
    var chatBody = document.getElementById('chatBody');
    var unreadBadge = document.getElementById('unreadBadge');
    var headerUnreadBadge = document.getElementById('headerUnreadBadge');
    
    // Estado
    var chatState = {
        isOpen: false,
        isMinimized: false,
        unreadCount: 0,
        currentUserId: null,
        typingTimeout: null,
        socket: null
    };
    
    // Utilitários
    function formatarHoraLocal(dataISO) {
        var data = new Date(dataISO);
        return data.toLocaleTimeString([], {
            hour: '2-digit',
            minute: '2-digit',
            hour12: false
        });
    }
    
    function updateUnreadBadge() {
        if (chatState.unreadCount > 0) {
            unreadBadge.style.display = 'inline';
            unreadBadge.textContent = chatState.unreadCount;
            headerUnreadBadge.style.display = 'inline';
            headerUnreadBadge.textContent = chatState.unreadCount;
        } else {
            unreadBadge.style.display = 'none';
            headerUnreadBadge.style.display = 'none';
        }
    }
    
    function scrollToBottom(container) {
        if (container) container.scrollTop = container.scrollHeight;
    }
    
    // Tela de login elegante
    function renderLoginPrompt() {
        chatBody.innerHTML = `
            <div class="login-prompt">
                <div class="login-prompt-icon">
                    <i class="bi bi-chat-dots"></i>
                </div>
                <h4>Fale conosco</h4>
                <p>Faça login para conversar com nossa equipe</p>
                <div class="login-prompt-buttons">
                    <a href="/login/index" class="login-btn primary">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Entrar
                    </a>
                    <a href="/login/index#register" class="login-btn secondary">
                        <i class="bi bi-person-plus"></i>
                        Cadastrar
                    </a>
                </div>
            </div>
        `;
    }
    
    // Interface do chat para logados
    function renderChatInterface() {
        chatBody.innerHTML = `
            <div class="chat-messages-container" id="chatMessages"></div>
            <div class="typing-indicator d-none" id="typingIndicator">
                <span id="typingText"></span>
                <div class="dots">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
            <div class="chat-input-container">
                <div class="chat-input-wrapper">
                    <input type="text" id="chatMessageInput" placeholder="Digite sua mensagem...">
                    <button id="chatSendButton">
                        <i class="bi bi-send"></i>
                    </button>
                </div>
            </div>
        `;
        
        var chatMessages = document.getElementById('chatMessages');
        var messageInput = document.getElementById('chatMessageInput');
        var sendButton = document.getElementById('chatSendButton');
        var typingIndicator = document.getElementById('typingIndicator');
        var typingText = document.getElementById('typingText');
        
        function displayMessage(message) {
            var emptyChat = chatMessages.querySelector('.empty-chat');
            if (emptyChat) emptyChat.remove();
            
            var isSent = (message.sender_id == userId);
            var div = document.createElement('div');
            div.className = 'message-wrapper';
            
            var html = '<div class="message ' + (isSent ? 'sent' : 'received') + '">';
            if (!isSent) html += '<div class="sender-name">' + message.sender_name + '</div>';
            html += '<div>' + message.message + '</div>';
            html += '<div class="time">' + formatarHoraLocal(message.created_at) + '</div>';
            html += '</div>';
            
            div.innerHTML = html;
            chatMessages.appendChild(div);
            scrollToBottom(chatMessages);
        }
        
        sendButton.addEventListener('click', function() {
            var message = messageInput.value.trim();
            if (message === '') return;
            
            if (isAdmin && !chatState.currentUserId) {
                alert('Selecione um usuário para responder');
                return;
            }
            
            chatState.socket.emit('send_message', {
                message: message,
                userId: isAdmin ? chatState.currentUserId : null
            });
            
            messageInput.value = '';
        });
        
        messageInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') sendButton.click();
            
            chatState.socket.emit('typing', {
                isTyping: true,
                userId: isAdmin ? chatState.currentUserId : null
            });
            
            clearTimeout(chatState.typingTimeout);
            chatState.typingTimeout = setTimeout(function() {
                chatState.socket.emit('typing', {
                    isTyping: false,
                    userId: isAdmin ? chatState.currentUserId : null
                });
            }, 1000);
        });
        
        chatState.socket.on('message_history', function(messages) {
            chatMessages.innerHTML = '';
            if (messages.length === 0) {
                chatMessages.innerHTML = '<div class="empty-chat"><i class="bi bi-chat"></i><h5>Nenhuma mensagem</h5><p>Envie uma mensagem para começar</p></div>';
            } else {
                messages.forEach(function(msg) { displayMessage(msg); });
            }
        });
        
        chatState.socket.on('receive_message', function(message) {
            displayMessage(message);
            if (!chatState.isOpen || chatState.isMinimized) {
                chatState.unreadCount++;
                updateUnreadBadge();
            }
        });
        
        chatState.socket.on('user_typing', function(data) {
            if (data.isTyping) {
                typingText.textContent = data.userName;
                typingIndicator.classList.remove('d-none');
            } else {
                typingIndicator.classList.add('d-none');
            }
        });
    }
    
    // Inicialização
    function initChat() {
        if (isUserLoggedIn) {
            chatBody.innerHTML = '<div class="chat-loading"><div class="spinner"></div></div>';
            
            chatState.socket = io({
                auth: {
                    userId: userId,
                    userEmail: userEmail,
                    isAdmin: isAdmin ? 'true' : 'false'
                }
            });
            
            chatState.socket.on('connect', renderChatInterface);
            chatState.socket.on('connect_error', function() {
                chatBody.innerHTML = '<div class="login-prompt"><p>Erro de conexão</p></div>';
            });
        } else {
            renderLoginPrompt();
        }
    }
    
    // Controles do widget
    function openChat() {
        chatWidget.classList.add('open');
        chatToggleButton.style.display = 'none';
        chatState.isOpen = true;
        chatState.isMinimized = false;
        chatState.unreadCount = 0;
        updateUnreadBadge();
    }
    
    function closeChat() {
        chatWidget.classList.remove('open');
        chatToggleButton.style.display = 'flex';
        chatState.isOpen = false;
    }
    
    function minimizeChat() {
        chatWidget.classList.add('minimized');
        chatState.isMinimized = true;
    }
    
    function maximizeChat() {
        chatWidget.classList.remove('minimized');
        chatState.isMinimized = false;
        chatState.unreadCount = 0;
        updateUnreadBadge();
    }
    
    // Event listeners
    chatToggleButton.addEventListener('click', openChat);
    
    chatHeader.addEventListener('click', function(e) {
        if (e.target.closest('.chat-header-actions')) return;
        chatState.isMinimized ? maximizeChat() : minimizeChat();
    });
    
    minimizeBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        minimizeChat();
    });
    
    closeBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        closeChat();
    });
    
    // Iniciar
    initChat();
    chatToggleButton.style.display = 'flex';
})();
</script>