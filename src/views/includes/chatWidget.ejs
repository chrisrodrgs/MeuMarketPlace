<!-- Chat Widget Flutuante Elegante -->
<% if (user) { %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* ===== VARIÁVEIS ===== */
    :root {
        --chat-primary: rgba(102, 126, 234, 0.9);
        --chat-secondary: rgba(118, 75, 162, 0.9);
        --chat-bg: rgba(255, 255, 255, 0.95);
        --chat-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        --chat-border: rgba(255, 255, 255, 0.2);
    }

    /* ===== BOTÃO FLUTUANTE ===== */
    .chat-toggle-button {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 65px;
        height: 65px;
        background: linear-gradient(135deg, var(--chat-primary), var(--chat-secondary));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 28px;
        cursor: pointer;
        box-shadow: var(--chat-shadow);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        z-index: 9999;
        border: 2px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(5px);
        animation: pulse-glow 2s infinite;
    }

    @keyframes pulse-glow {
        0% {
            box-shadow: 0 0 0 0 rgba(102, 126, 234, 0.7);
        }
        70% {
            box-shadow: 0 0 0 15px rgba(102, 126, 234, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(102, 126, 234, 0);
        }
    }

    .chat-toggle-button:hover {
        transform: scale(1.15) rotate(5deg);
        box-shadow: 0 25px 50px rgba(102, 126, 234, 0.5);
    }

    .chat-toggle-button .badge {
        position: absolute;
        top: -5px;
        right: -5px;
        background: #ff4757;
        color: white;
        border-radius: 50%;
        padding: 4px 8px;
        font-size: 12px;
        font-weight: bold;
        min-width: 22px;
        text-align: center;
        box-shadow: 0 2px 10px rgba(255, 71, 87, 0.5);
        animation: bounce 1s ease infinite;
        border: 2px solid white;
    }

    @keyframes bounce {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.2); }
    }

    /* ===== WIDGET PRINCIPAL ===== */
    .chat-widget {
        position: fixed;
        bottom: 110px;
        right: 30px;
        width: 380px;
        height: 550px;
        background: var(--chat-bg);
        backdrop-filter: blur(10px);
        border-radius: 25px;
        box-shadow: var(--chat-shadow);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        z-index: 9998;
        transition: all 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        border: 1px solid var(--chat-border);
        opacity: 0;
        transform: translateY(20px) scale(0.95);
        pointer-events: none;
    }

    .chat-widget.open {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: all;
    }

    .chat-widget.minimized {
        height: 70px;
        width: 300px;
        bottom: 30px;
        transform: translateY(0) scale(1);
    }

    /* ===== HEADER DO CHAT ===== */
    .chat-header {
        background: linear-gradient(135deg, var(--chat-primary), var(--chat-secondary));
        color: white;
        padding: 18px 22px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        user-select: none;
        backdrop-filter: blur(5px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    .chat-header h6 {
        margin: 0;
        font-weight: 600;
        font-size: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        letter-spacing: 0.5px;
    }

    .chat-header h6 i {
        font-size: 20px;
        filter: drop-shadow(0 2px 5px rgba(0,0,0,0.2));
    }

    .chat-header .badge {
        background: #ff4757;
        color: white;
        border-radius: 12px;
        padding: 3px 8px;
        font-size: 11px;
        font-weight: bold;
        margin-left: 8px;
        box-shadow: 0 2px 8px rgba(255, 71, 87, 0.4);
        border: 1px solid rgba(255,255,255,0.3);
    }

    .chat-header-actions {
        display: flex;
        gap: 15px;
    }

    .chat-header-actions i {
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 16px;
        opacity: 0.8;
    }

    .chat-header-actions i:hover {
        opacity: 1;
        transform: scale(1.1);
    }

    /* ===== CORPO DO CHAT ===== */
    .chat-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: rgba(248, 249, 250, 0.7);
        backdrop-filter: blur(5px);
    }

    .chat-messages-container {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        scroll-behavior: smooth;
    }

    .chat-messages-container::-webkit-scrollbar {
        width: 6px;
    }

    .chat-messages-container::-webkit-scrollbar-track {
        background: rgba(0,0,0,0.05);
    }

    .chat-messages-container::-webkit-scrollbar-thumb {
        background: linear-gradient(135deg, var(--chat-primary), var(--chat-secondary));
        border-radius: 10px;
    }

    /* ===== MENSAGENS ===== */
    .message-wrapper {
        margin-bottom: 15px;
        animation: slideInMessage 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }

    @keyframes slideInMessage {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.8);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .message {
        max-width: 80%;
        padding: 12px 16px;
        border-radius: 20px;
        position: relative;
        word-wrap: break-word;
        font-size: 14px;
        line-height: 1.5;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        backdrop-filter: blur(5px);
    }

    .message.sent {
        background: linear-gradient(135deg, var(--chat-primary), var(--chat-secondary));
        color: white;
        margin-left: auto;
        border-bottom-right-radius: 5px;
        border: 1px solid rgba(255,255,255,0.2);
    }

    .message.received {
        background: rgba(255, 255, 255, 0.9);
        color: #2d3436;
        margin-right: auto;
        border-bottom-left-radius: 5px;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .message .sender-name {
        font-size: 11px;
        opacity: 0.8;
        margin-bottom: 4px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .message .time {
        font-size: 9px;
        opacity: 0.6;
        margin-top: 4px;
        text-align: right;
        font-weight: 500;
    }

    .message.sent .time {
        color: rgba(255,255,255,0.8);
    }

    /* ===== INPUT AREA ===== */
    .chat-input-container {
        padding: 15px 20px;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        border-top: 1px solid rgba(0,0,0,0.05);
    }

    .chat-input-wrapper {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .chat-input-wrapper input {
        flex: 1;
        background: rgba(255, 255, 255, 0.9);
        border: 2px solid rgba(102, 126, 234, 0.2);
        border-radius: 25px;
        padding: 12px 18px;
        outline: none;
        transition: all 0.3s ease;
        font-size: 14px;
        backdrop-filter: blur(5px);
    }

    .chat-input-wrapper input:focus {
        border-color: var(--chat-primary);
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        background: white;
    }

    .chat-input-wrapper input::placeholder {
        color: #a0a0a0;
        font-style: italic;
    }

    .chat-input-wrapper button {
        background: linear-gradient(135deg, var(--chat-primary), var(--chat-secondary));
        border: none;
        color: white;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        border: 1px solid rgba(255,255,255,0.3);
    }

    .chat-input-wrapper button:hover:not(:disabled) {
        transform: rotate(360deg) scale(1.1);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.5);
    }

    .chat-input-wrapper button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        filter: grayscale(1);
    }

    /* ===== TYPING INDICATOR ===== */
    .typing-indicator {
        padding: 8px 20px;
        color: #636e72;
        font-size: 12px;
        font-style: italic;
        display: flex;
        align-items: center;
        gap: 5px;
        background: rgba(255,255,255,0.5);
        backdrop-filter: blur(5px);
    }

    .typing-indicator .dots {
        display: flex;
        gap: 3px;
    }

    .typing-indicator .dots span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--chat-primary), var(--chat-secondary));
        animation: typingDot 1.4s infinite ease-in-out;
    }

    .typing-indicator .dots span:nth-child(2) {
        animation-delay: 0.2s;
    }

    .typing-indicator .dots span:nth-child(3) {
        animation-delay: 0.4s;
    }

    @keyframes typingDot {
        0%, 60%, 100% { transform: translateY(0); }
        30% { transform: translateY(-8px); }
    }

    /* ===== EMPTY STATE ===== */
    .empty-chat {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #b2bec3;
        padding: 30px;
        text-align: center;
        animation: float 3s ease-in-out infinite;
    }

    .empty-chat i {
        font-size: 4rem;
        margin-bottom: 15px;
        background: linear-gradient(135deg, var(--chat-primary), var(--chat-secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        filter: drop-shadow(0 5px 15px rgba(102, 126, 234, 0.3));
    }

    .empty-chat h5 {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 8px;
        color: #2d3436;
    }

    .empty-chat p {
        font-size: 13px;
        margin: 0;
        opacity: 0.7;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    /* ===== RESPONSIVIDADE ===== */
    @media (max-width: 768px) {
        .chat-widget {
            width: 100%;
            height: 100%;
            bottom: 0;
            right: 0;
            border-radius: 0;
        }

        .chat-widget.minimized {
            width: 100%;
            height: 70px;
            bottom: 0;
        }

        .chat-toggle-button {
            bottom: 20px;
            right: 20px;
        }
    }

    /* ===== ANIMAÇÃO DE ENTRADA ===== */
    @keyframes widgetAppear {
        0% {
            opacity: 0;
            transform: translateY(30px) scale(0.9);
        }
        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>

<!-- Botão Flutuante -->
<button class="chat-toggle-button" id="chatToggleButton" style="display: none;">
    <i class="bi bi-chat-dots"></i>
    <span class="badge" id="unreadBadge" style="display: none;">0</span>
</button>

<!-- Widget do Chat -->
<div class="chat-widget" id="chatWidget">
    <div class="chat-header" id="chatHeader">
        <h6>
            <i class="bi bi-headset"></i>
            <span id="chatHeaderTitle">Atendimento</span>
            <span class="badge" id="headerUnreadBadge" style="display: none;">0</span>
        </h6>
        <div class="chat-header-actions">
            <i class="bi bi-dash-lg" id="minimizeChat" title="Minimizar"></i>
            <i class="bi bi-x-lg" id="closeChat" title="Fechar"></i>
        </div>
    </div>
    
    <div class="chat-body">
        <div class="chat-messages-container" id="chatMessages">
            <div class="empty-chat">
                <i class="bi bi-chat"></i>
                <h5>Nenhuma mensagem ainda</h5>
                <p>Comece a conversa enviando uma mensagem!</p>
            </div>
        </div>
        
        <div class="typing-indicator d-none" id="typingIndicator">
            <span id="typingText">Alguém está digitando</span>
            <div class="dots">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
        
        <div class="chat-input-container">
            <div class="chat-input-wrapper">
                <input type="text" id="chatMessageInput" 
                       placeholder="Digite sua mensagem...">
                <button id="chatSendButton">
                    <i class="bi bi-send"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
(function() {
    // Verificar se usuário está logado
    <% if (user) { %>
    
    // Configuração
    var userId = '<%= user.id %>';
    var userEmail = '<%= user.email %>';
    var isAdmin = <%= user.isAdmin ? 1 : 0 %>;
    
    // Estado do chat
    var chatState = {
        isOpen: false,
        isMinimized: false,
        unreadCount: 0,
        currentUserId: null,
        typingTimeout: null
    };
    
    // Elementos DOM
    var chatWidget = document.getElementById('chatWidget');
    var chatToggleButton = document.getElementById('chatToggleButton');
    var chatHeader = document.getElementById('chatHeader');
    var minimizeBtn = document.getElementById('minimizeChat');
    var closeBtn = document.getElementById('closeChat');
    var chatMessages = document.getElementById('chatMessages');
    var messageInput = document.getElementById('chatMessageInput');
    var sendButton = document.getElementById('chatSendButton');
    var typingIndicator = document.getElementById('typingIndicator');
    var typingText = document.getElementById('typingText');
    var chatHeaderTitle = document.getElementById('chatHeaderTitle');
    var unreadBadge = document.getElementById('unreadBadge');
    var headerUnreadBadge = document.getElementById('headerUnreadBadge');
    
    // Socket.IO
    var socket = null;
    
    // Função para formatar hora LOCAL do usuário
    function formatarHoraLocal(dataISO) {
        var data = new Date(dataISO);
        
        // Usar o formato local do navegador do usuário
        return data.toLocaleTimeString([], {
            hour: '2-digit',
            minute: '2-digit',
            hour12: false  // Formato 24h
        });
    }
    
    // Inicializar socket
    function initSocket() {
        socket = io({
            auth: {
                userId: userId,
                userEmail: userEmail,
                isAdmin: isAdmin ? 'true' : 'false'
            }
        });
        
        socket.on('message_history', function(messages) {
            if (messages.length > 0) {
                chatMessages.innerHTML = '';
                for (var i = 0; i < messages.length; i++) {
                    displayMessage(messages[i]);
                }
                scrollToBottom();
            }
        });
        
        socket.on('receive_message', function(message) {
            displayMessage(message);
            scrollToBottom();
            
            // Incrementar contador se chat não estiver aberto
            if (!chatState.isOpen || chatState.isMinimized) {
                chatState.unreadCount++;
                updateUnreadBadge();
            }
        });
        
        socket.on('user_typing', function(data) {
            if (data.isTyping) {
                typingText.textContent = data.userName;
                typingIndicator.classList.remove('d-none');
            } else {
                typingIndicator.classList.add('d-none');
            }
        });
    }
    
    // Mostrar mensagem
    function displayMessage(message) {
        // Remover empty state
        var emptyChat = chatMessages.querySelector('.empty-chat');
        if (emptyChat) {
            emptyChat.remove();
        }
        
        var isSent = (message.sender_id == userId);
        var div = document.createElement('div');
        div.className = 'message-wrapper';
        
        var html = '<div class="message ' + (isSent ? 'sent' : 'received') + '">';
        
        if (!isSent) {
            html += '<div class="sender-name">' + message.sender_name + '</div>';
        }
        
        html += '<div>' + message.message + '</div>';
        
        // Usar a função de hora LOCAL
        var horaLocal = formatarHoraLocal(message.created_at);
        html += '<div class="time">' + horaLocal + '</div>';
        
        html += '</div>';
        
        div.innerHTML = html;
        chatMessages.appendChild(div);
    }
    
    function scrollToBottom() {
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }
    
    // Atualizar badge de mensagens não lidas
    function updateUnreadBadge() {
        if (chatState.unreadCount > 0) {
            unreadBadge.style.display = 'inline';
            unreadBadge.textContent = chatState.unreadCount;
            headerUnreadBadge.style.display = 'inline';
            headerUnreadBadge.textContent = chatState.unreadCount;
        } else {
            unreadBadge.style.display = 'none';
            headerUnreadBadge.style.display = 'none';
        }
    }
    
    // Enviar mensagem
    function sendMessage() {
        var message = messageInput.value.trim();
        if (message === '') return;
        
        socket.emit('send_message', {
            message: message,
            userId: isAdmin ? chatState.currentUserId : null
        });
        
        messageInput.value = '';
    }
    
    // Abrir chat
    function openChat() {
        chatWidget.classList.add('open');
        chatToggleButton.style.display = 'none';
        chatState.isOpen = true;
        chatState.isMinimized = false;
        chatState.unreadCount = 0;
        updateUnreadBadge();
    }
    
    // Fechar chat
    function closeChat() {
        chatWidget.classList.remove('open');
        chatToggleButton.style.display = 'flex';
        chatState.isOpen = false;
    }
    
    // Minimizar chat
    function minimizeChat() {
        chatWidget.classList.add('minimized');
        chatState.isMinimized = true;
    }
    
    // Maximizar chat
    function maximizeChat() {
        chatWidget.classList.remove('minimized');
        chatState.isMinimized = false;
        chatState.unreadCount = 0;
        updateUnreadBadge();
    }
    
    // Event listeners
    chatToggleButton.addEventListener('click', openChat);
    
    chatHeader.addEventListener('click', function(e) {
        if (e.target.closest('.chat-header-actions')) return;
        
        if (chatState.isMinimized) {
            maximizeChat();
        } else {
            minimizeChat();
        }
    });
    
    minimizeBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        minimizeChat();
    });
    
    closeBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        closeChat();
    });
    
    sendButton.addEventListener('click', sendMessage);
    
    messageInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            sendMessage();
        }
        
        if (socket) {
            socket.emit('typing', {
                isTyping: true,
                userId: isAdmin ? chatState.currentUserId : null
            });
            
            clearTimeout(chatState.typingTimeout);
            chatState.typingTimeout = setTimeout(function() {
                socket.emit('typing', {
                    isTyping: false,
                    userId: isAdmin ? chatState.currentUserId : null
                });
            }, 1000);
        }
    });
    
    // Mostrar botão após carregar
    chatToggleButton.style.display = 'flex';
    
    // Iniciar socket
    initSocket();
    
    <% } else { %>
    
    // Usuário não logado
    var chatToggleButton = document.getElementById('chatToggleButton');
    chatToggleButton.style.display = 'flex';
    
    chatToggleButton.addEventListener('click', function() {
        window.location.href = '/login/index';
    });
    
    <% } %>
})();
</script>
<% } %>