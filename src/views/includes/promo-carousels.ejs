<!-- DOIS CARROSSÉIS LADO A LADO - ESTILO VITRINE -->
<div class="promo-double-section">
    <div class="container">
        <div class="row g-4">
            <!-- Coluna 1: Maiores Descontos -->
            <div class="col-lg-6">
                <div class="promo-section-title">
                    <h3>🔥 <span>Maiores Descontos</span></h3>
                    <p>Até 50% OFF em produtos selecionados</p>
                </div>
                <div class="promo-carousel-wrapper">
                    <div class="promo-carousel" id="maioresDescontosCarousel">
                        <% if (maioresDescontos && maioresDescontos.length > 0) { %>
                            <% maioresDescontos.forEach(produto => { 
                                let badgeClass = '';
                                if (produto.desconto >= 50) badgeClass = 'alto';
                                else if (produto.desconto >= 10) badgeClass = 'medio';
                                else badgeClass = 'baixo';
                            %>
                            <div>
                                <a href="/produto/<%= produto.id %>" class="promo-card-link">
                                    <div class="promo-card-small">
                                        <div class="promo-card-image">
                                            <% if (produto.imagemUrl) { %>
                                                <img src="<%= produto.imagemUrl %>" alt="<%= produto.nome %>">
                                            <% } else { %>
                                                <div class="w-100 h-100 bg-dark d-flex align-items-center justify-content-center">
                                                    <i class="bi bi-image text-white opacity-50" style="font-size: 2rem;"></i>
                                                </div>
                                            <% } %>
                                            <div class="promo-badge-desconto <%= badgeClass %>">
                                                -<%= produto.desconto %>% OFF
                                            </div>
                                        </div>
                                        <div class="promo-card-info">
                                            <h5><%= produto.nome %></h5>
                                            <div class="promo-card-price">
                                                <span class="promo-old-price-small"><%= produto.precoOriginalFormatado %></span>
                                                <span class="promo-new-price-small"><%= produto.precoFormatado %></span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-5">
                                <i class="bi bi-tags display-4 opacity-25"></i>
                                <p class="mt-3 mb-0 text-muted">Nenhum produto com desconto no momento</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            
            <!-- Coluna 2: Promoções Recentes -->
            <div class="col-lg-6">
                <div class="promo-section-title">
                    <h3>✨ <span>Promoções Recentes</span></h3>
                    <p>Produtos que acabaram de entrar em promoção</p>
                </div>
                <div class="promo-carousel-wrapper">
                    <div class="promo-carousel" id="promocoesRecentesCarousel">
                        <% if (promocoesRecentes && promocoesRecentes.length > 0) { %>
                            <% promocoesRecentes.forEach(produto => { 
                                let badgeClass = '';
                                if (produto.desconto >= 50) badgeClass = 'alto';
                                else if (produto.desconto >= 10) badgeClass = 'medio';
                                else badgeClass = 'baixo';
                            %>
                            <div>
                                <a href="/produto/<%= produto.id %>" class="promo-card-link">
                                    <div class="promo-card-small">
                                        <div class="promo-card-image">
                                            <% if (produto.imagemUrl) { %>
                                                <img src="<%= produto.imagemUrl %>" alt="<%= produto.nome %>">
                                            <% } else { %>
                                                <div class="w-100 h-100 bg-dark d-flex align-items-center justify-content-center">
                                                    <i class="bi bi-image text-white opacity-50" style="font-size: 2rem;"></i>
                                                </div>
                                            <% } %>
                                            <div class="promo-badge-desconto <%= badgeClass %>">
                                                -<%= produto.desconto %>% OFF
                                            </div>
                                        </div>
                                        <div class="promo-card-info">
                                            <h5><%= produto.nome %></h5>
                                            <div class="promo-card-price">
                                                <span class="promo-old-price-small"><%= produto.precoOriginalFormatado %></span>
                                                <span class="promo-new-price-small"><%= produto.precoFormatado %></span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-5">
                                <i class="bi bi-tags display-4 opacity-25"></i>
                                <p class="mt-3 mb-0 text-muted">Nenhum produto com desconto no momento</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>