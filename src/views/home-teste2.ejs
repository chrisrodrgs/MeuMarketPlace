    <div class="container">
        <h2 class="text-center fw-light mb-5 display-5">Por que nos escolher</h2>
        <div class="row">
            <div class="col-md-4">
                <div class="feature-elegante-item">
                    <div class="feature-elegante-icon">
                        <i class="bi bi-gem"></i>
                    </div>
                    <h4 class="fw-light">Design Exclusivo</h4>
                    <p class="text-muted">Uma interface pensada para encantar</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-elegante-item">
                    <div class="feature-elegante-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h4 class="fw-light">Segurança</h4>
                    <p class="text-muted">Suas informações sempre protegidas</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-elegante-item">
                    <div class="feature-elegante-icon">
                        <i class="bi bi-star"></i>
                    </div>
                    <h4 class="fw-light">Qualidade</h4>
                    <p class="text-muted">Os melhores produtos selecionados</p>
                </div>
            </div>
        </div>
    </div>
</section>

