<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<!-- Breadcrumb -->
<section class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/meus-produtos">Meus Produtos</a></li>
                <li class="breadcrumb-item active">Editar Produto</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Header Centralizado -->
<section class="hero-section" style="min-height: 30vh; padding: 60px 0;">
    <div class="container text-center">
        <h1 class="hero-title">
            Editar <span>Produto</span>
        </h1>
        <p class="hero-subtitle mx-auto">Atualize as informações do seu produto</p>
    </div>
</section>

<!-- Formulário -->
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card-elegante shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white py-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="h4 mb-0">
                            <i class="bi bi-pencil-square me-2"></i>
                            Editando: <%= produto.name %>
                        </h2>
                        <span class="badge bg-light text-dark px-3 py-2 rounded-pill">ID: <%= produto.id %></span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <!-- Mensagens Flash -->
                    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <%= errors %>
                        </div>
                    <% } %>
                    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <%= success %>
                        </div>
                    <% } %>

                    <!-- Preview do Produto - MAIS DESTAQUE -->
                    <div class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-3 p-4 mb-4 border border-primary border-opacity-25 shadow-md">
                        <h6 class="fw-semibold mb-3">
                            <i class="bi bi-eye text-primary me-2"></i>
                            Prévia do Produto
                        </h6>
                        <div class="d-flex align-items-center gap-4">
                            <% if (produto.imagemUrl) { %>
                                <img src="<%= produto.imagemUrl %>" class="rounded-3 shadow-sm" style="width: 80px; height: 80px; object-fit: cover; border: 3px solid white;">
                            <% } else { %>
                                <div class="bg-white rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 80px; height: 80px;">
                                    <i class="bi bi-image text-secondary fs-2"></i>
                                </div>
                            <% } %>
                            <div>
                                <h5 id="previewName" class="mb-1 fw-bold text-dark"><%= produto.name %></h5>
                                <span class="text-primary fw-bold fs-4" id="previewPrice">R$ <%= Number(produto.price).toFixed(2) %></span>
                                <div class="mt-1">
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-box me-1"></i> <span id="previewStock">Estoque: <%= produto.estoque || 0 %></span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form action="/produtos/editar/<%= produto.id %>" method="POST">
                        <!-- Nome - MAIOR CONTRASTE -->
                        <div class="field-container mb-4 bg-white rounded-3 p-3 shadow-sm border-start border-4 border-primary">
                            <div class="d-flex align-items-start gap-3">
                                <div class="bg-primary bg-opacity-10 rounded-circle p-2">
                                    <i class="bi bi-tag fs-4 text-primary"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="mb-2 pb-2 border-bottom border-dashed">
                                        <small class="text-muted text-uppercase fw-semibold">Valor atual</small>
                                        <div class="fw-bold fs-5 text-dark"><%= produto.name %></div>
                                    </div>
                                    <div>
                                        <label class="form-label fw-semibold">
                                            <i class="bi bi-pencil text-primary me-1"></i> Novo nome
                                        </label>
                                        <input type="text" class="form-control form-control-lg" id="nome" name="nome" 
                                               value="<%= produto.name %>" oninput="document.getElementById('previewName').textContent = this.value">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Descrição -->
                        <div class="field-container mb-4 bg-white rounded-3 p-3 shadow-sm border-start border-4 border-primary">
                            <div class="d-flex align-items-start gap-3">
                                <div class="bg-primary bg-opacity-10 rounded-circle p-2">
                                    <i class="bi bi-card-text fs-4 text-primary"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="mb-2 pb-2 border-bottom border-dashed">
                                        <small class="text-muted text-uppercase fw-semibold">Descrição atual</small>
                                        <div class="small text-dark"><%= produto.description %></div>
                                    </div>
                                    <div>
                                        <label class="form-label fw-semibold">
                                            <i class="bi bi-pencil text-primary me-1"></i> Nova descrição
                                        </label>
                                        <textarea class="form-control" id="descricao" name="descricao" rows="3"><%= produto.description %></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Preço, Estoque, Categoria -->
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="field-container bg-white rounded-3 p-3 shadow-sm border-start border-4 border-success">
                                    <div class="d-flex align-items-start gap-2">
                                        <i class="bi bi-currency-dollar fs-4 text-success"></i>
                                        <div class="flex-grow-1">
                                            <div class="mb-2 pb-1">
                                                <small class="text-muted">Preço atual</small>
                                                <div class="fw-bold text-success fs-5">R$ <%= Number(produto.price).toFixed(2) %></div>
                                            </div>
                                            <label class="form-label fw-semibold small">Novo preço</label>
                                            <input type="number" class="form-control" id="preco" name="preco" 
                                                   step="0.01" min="0.01" value="<%= produto.price %>"
                                                   oninput="document.getElementById('previewPrice').textContent = 'R$ ' + (parseFloat(this.value) || 0).toFixed(2)">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="field-container bg-white rounded-3 p-3 shadow-sm border-start border-4 border-warning">
                                    <div class="d-flex align-items-start gap-2">
                                        <i class="bi bi-box fs-4 text-warning"></i>
                                        <div class="flex-grow-1">
                                            <div class="mb-2 pb-1">
                                                <small class="text-muted">Estoque atual</small>
                                                <div class="fw-bold text-warning"><%= produto.estoque || 0 %> unid.</div>
                                            </div>
                                            <label class="form-label fw-semibold small">Novo estoque</label>
                                            <input type="number" class="form-control" id="estoque" name="estoque" 
                                                   min="0" value="<%= produto.estoque || 0 %>"
                                                   oninput="document.getElementById('previewStock').textContent = 'Estoque: ' + (parseInt(this.value) || 0)">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="field-container bg-white rounded-3 p-3 shadow-sm border-start border-4 border-info">
                                    <div class="d-flex align-items-start gap-2">
                                        <i class="bi bi-grid fs-4 text-info"></i>
                                        <div class="flex-grow-1">
                                            <div class="mb-2 pb-1">
                                                <small class="text-muted">Categoria atual</small>
                                                <div><%= produto.categoria || 'Não definida' %></div>
                                            </div>
                                            <label class="form-label fw-semibold small">Nova categoria</label>
                                            <select class="form-select" id="categoria" name="categoria">
                                                <option value="<%= produto.categoria %>"><%= produto.categoria || 'Selecione' %></option>
                                                <option value="Café da manhã">Café da manhã</option>
                                                <option value="Doces">Doces</option>
                                                <option value="Salgados">Salgados</option>
                                                <option value="Bebidas">Bebidas</option>
                                                <option value="Descartáveis">Descartáveis</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="field-container mt-4 bg-white rounded-3 p-3 shadow-sm border-start border-4 border-danger">
                            <div class="d-flex align-items-start gap-3">
                                <div class="bg-danger bg-opacity-10 rounded-circle p-2">
                                    <i class="bi bi-toggle-on fs-4 text-danger"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="mb-2 pb-2 border-bottom border-dashed">
                                        <small class="text-muted text-uppercase fw-semibold">Status atual</small>
                                        <div>
                                            <span class="badge bg-<%= produto.status === 'ativo' ? 'success' : 'secondary' %> px-3 py-2">
                                                <i class="bi bi-<%= produto.status === 'ativo' ? 'check-circle' : 'x-circle' %> me-1"></i>
                                                <%= produto.status === 'ativo' ? 'Ativo (visível para compra)' : 'Inativo (não visível)' %>
                                            </span>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="form-label fw-semibold">
                                            <i class="bi bi-pencil text-primary me-1"></i> Novo status
                                        </label>
                                        <select class="form-select" name="status">
                                            <option value="ativo" <%= produto.status === 'ativo' ? 'selected' : '' %>>Ativo (visível para compra)</option>
                                            <option value="inativo" <%= produto.status === 'inativo' ? 'selected' : '' %>>Inativo (não visível)</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Botões -->
                        <div class="d-flex gap-3 mt-5">
                            <button type="submit" class="btn-elegante primary flex-grow-1 py-3">
                                <i class="bi bi-check-circle me-2"></i>
                                Salvar Alterações
                            </button>
                            <a href="/meus-produtos" class="btn-elegante secondary flex-grow-1 py-3">
                                <i class="bi bi-x-lg me-2"></i>
                                Cancelar
                            </a>
                            <button type="button" class="btn-elegante danger py-3 px-4" onclick="confirmarDelecao()">
                                <i class="bi bi-trash"></i> Deletar
                            </button>
                        </div>
                    </form>
                    <form id="deleteForm" action="/produtos/deletar/<%= produto.id %>" method="POST" style="display: none;"></form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmarDelecao() {
        if (confirm('Tem certeza que deseja deletar este produto? Esta ação não pode ser desfeita.')) {
            document.getElementById('deleteForm').submit();
        }
    }
</script>

<style>
    .field-container {
        transition: all 0.3s ease;
    }
    .field-container:hover {
        transform: translateX(4px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important;
    }
    .border-dashed {
        border-bottom: 1px dashed #e2e8f0;
    }
    .bg-gradient-to-br {
        background: linear-gradient(135deg, #eef2ff 0%, #f5f0ff 100%);
    }
    .form-control, .form-select {
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 10px 14px;
        transition: all 0.3s ease;
    }
    .form-control:focus, .form-select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        outline: none;
    }
    .badge.bg-light {
        background: rgba(255,255,255,0.2) !important;
        backdrop-filter: blur(4px);
    }
</style>

<%- include('./includes/footer') %>