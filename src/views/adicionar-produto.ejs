<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<!-- Breadcrumb -->
<section class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/meus-produtos">Meus Produtos</a></li>
                <li class="breadcrumb-item active">Anunciar Produto</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Header Centralizado -->
<section class="hero-section" style="min-height: 30vh; padding: 60px 0;">
    <div class="container text-center">
        <h1 class="hero-title">
            Anunciar <span>Novo Produto</span>
        </h1>
        <p class="hero-subtitle mx-auto">Compartilhe seu produto com milhares de compradores</p>
    </div>
</section>

<!-- Formulário -->
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card-elegante">
                <div class="card-header bg-gradient-primary text-white py-4">
                    <h2 class="h4 mb-0">
                        <i class="bi bi-plus-circle me-2"></i>
                        Informações do Produto
                    </h2>
                    <p class="mb-0 mt-2 opacity-75">Preencha os dados abaixo para criar seu anúncio</p>
                </div>
                <div class="card-body p-4">
                    <!-- Mensagens Flash -->
                    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <%= errors %>
                        </div>
                    <% } %>
                    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <%= success %>
                        </div>
                    <% } %>

                    <form action="/produtos/adicionar" method="POST" enctype="multipart/form-data">
                        <!-- Upload de Imagem -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-camera text-primary me-2"></i>Imagem do Produto
                            </label>
                            <div class="upload-area" id="dropArea">
                                <i class="bi bi-cloud-arrow-up fs-1 text-primary mb-3 d-block"></i>
                                <p>Arraste uma imagem ou clique para selecionar</p>
                                <small class="text-muted">Formatos: JPG, PNG, GIF (max. 5MB)</small>
                                <input type="file" class="d-none" id="imagem" name="imagem" accept="image/*">
                                <button type="button" class="btn-elegante secondary small mt-3" id="selectImageBtn">
                                    <i class="bi bi-folder2-open"></i> Escolher Arquivo
                                </button>
                                <div id="previewContainer" class="mt-3 d-none">
                                    <img src="#" alt="Preview" class="img-thumbnail" style="max-width: 200px;">
                                </div>
                            </div>
                        </div>

                        <!-- Campos -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-tag text-primary me-2"></i>Nome do Produto *
                            </label>
                            <input type="text" class="form-control" id="nome" name="nome" 
                                   placeholder="Ex: Brownie de Doce de Leite" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-card-text text-primary me-2"></i>Descrição *
                            </label>
                            <textarea class="form-control" id="descricao" name="descricao" 
                                      rows="4" placeholder="Descreva seu produto com detalhes..." required></textarea>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-currency-dollar text-primary me-2"></i>Preço (R$) *
                                </label>
                                <input type="number" class="form-control" id="preco" name="preco" 
                                       step="0.01" min="0.01" placeholder="0,00" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-box text-primary me-2"></i>Estoque *
                                </label>
                                <input type="number" class="form-control" id="estoque" name="estoque" 
                                       min="0" step="1" placeholder="Quantidade" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-grid text-primary me-2"></i>Categoria *
                                </label>
                                <select class="form-select" id="categoria" name="categoria" required>
                                    <option value="">Selecione...</option>
                                    <% categorias.forEach(categoria => { %>
                                        <option value="<%= categoria %>"><%= categoria %></option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="mt-4 p-3 bg-light rounded-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-toggle-on text-primary me-2"></i>Status do Produto
                            </label>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="status" id="statusAtivo" value="ativo" checked>
                                <label class="form-check-label" for="statusAtivo">
                                    <i class="bi bi-check-circle-fill text-success"></i> Ativo - Disponível para venda
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="status" id="statusInativo" value="inativo">
                                <label class="form-check-label" for="statusInativo">
                                    <i class="bi bi-x-circle-fill text-secondary"></i> Inativo - Indisponível para venda
                                </label>
                            </div>
                            <small class="text-muted mt-2 d-block">Você pode alterar esta configuração depois</small>
                        </div>

                        <!-- Botões -->
                        <div class="d-flex gap-3 mt-5">
                            <button type="submit" class="btn-elegante primary flex-grow-1">
                                <i class="bi bi-check-circle"></i> Publicar Anúncio
                            </button>
                            <a href="/meus-produtos" class="btn-elegante secondary">
                                <i class="bi bi-x-lg"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const dropArea = document.getElementById('dropArea');
    const imagemInput = document.getElementById('imagem');
    const selectImageBtn = document.getElementById('selectImageBtn');
    const previewContainer = document.getElementById('previewContainer');
    const previewImage = previewContainer?.querySelector('img');

    function showPreview(file) {
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImage.src = e.target.result;
                previewContainer.classList.remove('d-none');
                dropArea.style.display = 'none';
            }
            reader.readAsDataURL(file);
        }
    }

    function cancelPreview() {
        previewContainer.classList.add('d-none');
        dropArea.style.display = 'block';
        imagemInput.value = '';
    }

    selectImageBtn?.addEventListener('click', () => imagemInput.click());
    dropArea?.addEventListener('click', () => imagemInput.click());
    imagemInput?.addEventListener('change', e => showPreview(e.target.files[0]));

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropArea?.addEventListener(eventName, e => e.preventDefault());
    });

    dropArea?.addEventListener('drop', e => {
        const files = e.dataTransfer.files;
        if (files.length) {
            imagemInput.files = files;
            showPreview(files[0]);
        }
    });
</script>

<style>
    .upload-area {
        border: 2px dashed rgba(102, 126, 234, 0.3);
        border-radius: 20px;
        padding: 40px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        background: var(--light-bg);
    }
    .upload-area:hover {
        border-color: var(--primary);
        background: white;
    }
</style>

<%- include('./includes/footer') %>