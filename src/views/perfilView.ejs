<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<!-- Header - IGUAL AO MEUS-PRODUTOS -->
<section class="hero-section" style="min-height: 30vh; padding: 60px 0;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="hero-title">
                    Meu <span>Perfil</span>
                </h1>
                <p class="hero-subtitle">Gerencie suas informações pessoais</p>
            </div>
            <!-- Espaço vazio para manter alinhamento -->
            <div></div>
        </div>
    </div>
</section>

<div class="container py-5">
    <div class="row">
        <div class="col-lg-4">
            <div class="card-elegante text-center p-4">
                <div class="mb-4">
                    <% if (usuario && usuario.avatar) { %>
                        <img src="/<%= usuario.avatar %>" class="rounded-circle border border-3 border-primary" 
                             style="width: 120px; height: 120px; object-fit: cover;">
                    <% } else { %>
                        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center border border-3 border-primary"
                             style="width: 120px; height: 120px;">
                            <i class="bi bi-person-circle text-secondary" style="font-size: 4rem;"></i>
                        </div>
                    <% } %>
                </div>
                <h4 class="fw-bold"><%= usuario ? usuario.email.split('@')[0] : 'Usuário' %></h4>
                <p class="text-muted"><%= usuario ? usuario.email : '' %></p>
                
                <!-- Mensagens Flash -->
                <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
                    <div class="alert alert-danger"><%= errors %></div>
                <% } %>
                <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
                    <div class="alert alert-success"><%= success %></div>
                <% } %>
                
                <hr>
                
                <form action="/usuario/perfil/avatar" method="POST" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Alterar foto</label>
                        <input type="file" class="form-control" name="avatar" accept="image/*" required>
                        <div class="form-text">Máx: 2MB. Formatos: JPG, PNG, GIF</div>
                    </div>
                    <button type="submit" class="btn-elegante primary w-100">
                        <i class="bi bi-cloud-upload"></i> Enviar nova foto
                    </button>
                </form>
                
                <% if (usuario && usuario.avatar) { %>
                    <form action="/usuario/perfil/avatar/remover" method="POST" class="mt-2">
                        <button type="submit" class="btn-elegante danger w-100" 
                                onclick="return confirm('Remover foto?')">
                            <i class="bi bi-trash"></i> Remover foto
                        </button>
                    </form>
                <% } %>
            </div>
        </div>
        
        <div class="col-lg-8">
            <div class="card-elegante p-4 mb-4">
                <h3 class="h5 fw-bold mb-3"><i class="bi bi-info-circle text-primary me-2"></i>Informações da Conta</h3>
                <table class="table">
                     <tr><th>ID:</th><td><%= usuario ? usuario.id : '' %></td></tr>
                     <tr><th>E-mail:</th><td><%= usuario ? usuario.email : '' %></td></tr>
                     <tr><th>Status:</th><td><span class="badge bg-success">Ativo</span></td></tr>
                 </table>
            </div>
            
            <div class="card-elegante p-4">
                <h3 class="h5 fw-bold mb-3"><i class="bi bi-box text-primary me-2"></i>Meus Últimos Produtos</h3>
                <% if (produtos && produtos.length > 0) { %>
                    <div class="row g-3">
                        <% produtos.forEach(produto => { %>
                            <div class="col-md-4">
                                <a href="/produto/<%= produto.id %>" class="text-decoration-none">
                                    <div class="card-elegante">
                                        <div class="product-image-elegante" style="height: 100px;">
                                            <% if (produto.imagemUrl) { %>
                                                <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>">
                                            <% } else { %>
                                                <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                                    <i class="bi bi-image text-secondary"></i>
                                                </div>
                                            <% } %>
                                        </div>
                                        <div class="p-2">
                                            <h6 class="text-truncate"><%= produto.name %></h6>
                                            <span class="text-primary fw-bold">R$ <%= Number(produto.price).toFixed(2) %></span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        <% }) %>
                    </div>
                    <div class="text-center mt-3">
                        <a href="/meus-produtos" class="btn-elegante outline small">Ver todos</a>
                    </div>
                <% } else { %>
                    <p class="text-muted text-center py-3">Nenhum produto cadastrado.</p>
                    <div class="text-center">
                        <a href="/produtos/adicionar" class="btn-elegante primary">Adicionar Produto</a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelector('input[name="avatar"]').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file && !file.type.startsWith('image/')) {
            alert('Por favor, selecione apenas imagens');
            this.value = '';
        }
    });
</script>

<%- include('./includes/footer') %>