<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<style>
    /* ===== VARIÁVEIS ===== */
    :root {
        --primary: #667eea;
        --secondary: #764ba2;
        --light-bg: #fafaff;
        --text-dark: #2d3436;
        --text-light: #636e72;
        --shadow-sm: 0 5px 20px rgba(0,0,0,0.02);
        --shadow-md: 0 10px 30px rgba(102, 126, 234, 0.05);
        --shadow-lg: 0 20px 40px rgba(102, 126, 234, 0.08);
        --gradient: linear-gradient(135deg, var(--primary), var(--secondary));
    }

    /* ===== BREADCRUMB ===== */
    .breadcrumb-section {
        background: white;
        padding: 20px 0;
        border-bottom: 1px solid rgba(102, 126, 234, 0.1);
    }

    .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 0;
    }

    .breadcrumb-item a {
        color: var(--text-light);
        text-decoration: none;
    }

    .breadcrumb-item a:hover {
        color: var(--primary);
    }

    .breadcrumb-item.active {
        color: var(--primary);
        font-weight: 500;
    }

    /* ===== HEADER DO PERFIL ===== */
    .profile-header {
        background: linear-gradient(135deg, #f5f0ff 0%, #f0f5ff 100%);
        padding: 40px 0;
        position: relative;
        overflow: hidden;
    }

    .profile-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 100%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, transparent 60%);
        animation: spinSlow 90s linear infinite;
    }

    @keyframes spinSlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .profile-header-content {
        position: relative;
        z-index: 2;
    }

    /* ===== CARD DO PERFIL ===== */
    .profile-card {
        background: white;
        border-radius: 30px;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
        margin-top: -60px;
        position: relative;
        z-index: 3;
    }

    .profile-card-header {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        padding: 30px;
        color: white;
    }

    .profile-avatar-wrapper {
        position: relative;
        width: 100px;
        height: 100px;
        margin-right: 20px;
    }

    .profile-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 3px solid white;
        box-shadow: var(--shadow-lg);
        object-fit: cover;
    }

    .profile-avatar-placeholder {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        border: 3px solid white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: white;
    }

    .profile-name {
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .profile-email {
        font-size: 1rem;
        opacity: 0.9;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .profile-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 12px;
        background: rgba(255,255,255,0.2);
        border-radius: 50px;
        font-size: 0.85rem;
        margin-top: 10px;
    }

    /* ===== STATS CARDS ===== */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        padding: 30px;
    }

    .stat-item {
        text-align: center;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 600;
        color: var(--primary);
        line-height: 1.2;
    }

    .stat-label {
        font-size: 0.9rem;
        color: var(--text-light);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* ===== TABS ===== */
    .profile-tabs {
        border-bottom: 1px solid rgba(102, 126, 234, 0.1);
        padding: 0 30px;
    }

    .profile-tab {
        padding: 15px 25px;
        background: transparent;
        border: none;
        color: var(--text-light);
        font-weight: 500;
        position: relative;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .profile-tab:hover {
        color: var(--primary);
    }

    .profile-tab.active {
        color: var(--primary);
    }

    .profile-tab.active::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, var(--primary), var(--secondary));
    }

    /* ===== CONTEÚDO DAS TABS ===== */
    .tab-content {
        padding: 30px;
    }

    /* Info Tab */
    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .info-card {
        background: var(--light-bg);
        border-radius: 20px;
        padding: 20px;
    }

    .info-card-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-card-title i {
        color: var(--primary);
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid rgba(0,0,0,0.03);
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-label {
        color: var(--text-light);
        font-size: 0.9rem;
    }

    .info-value {
        color: var(--text-dark);
        font-weight: 500;
    }

    /* Products Tab */
    .products-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .product-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
        text-decoration: none;
        color: inherit;
        border: 1px solid rgba(102, 126, 234, 0.05);
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-md);
    }

    .product-image {
        height: 150px;
        overflow: hidden;
    }

    .product-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .product-card:hover .product-image img {
        transform: scale(1.1);
    }

    .product-info {
        padding: 15px;
    }

    .product-name {
        font-size: 1rem;
        font-weight: 500;
        margin-bottom: 5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .product-price {
        color: var(--primary);
        font-weight: 600;
        font-size: 1.1rem;
    }

    .product-category {
        font-size: 0.8rem;
        color: var(--text-light);
        margin-top: 5px;
    }

    .empty-products {
        grid-column: 1 / -1;
        text-align: center;
        padding: 60px 20px;
        background: var(--light-bg);
        border-radius: 30px;
    }

    .empty-products i {
        font-size: 4rem;
        color: #cbd5e0;
        margin-bottom: 15px;
    }

    .empty-products h4 {
        font-size: 1.3rem;
        font-weight: 400;
        color: var(--text-dark);
        margin-bottom: 10px;
    }

    .empty-products p {
        color: var(--text-light);
        margin-bottom: 20px;
    }

    /* Avatar Upload Tab */
    .upload-area {
        border: 2px dashed rgba(102, 126, 234, 0.3);
        border-radius: 30px;
        padding: 40px;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
        background: var(--light-bg);
    }

    .upload-area:hover {
        border-color: var(--primary);
        background: white;
    }

    .upload-area i {
        font-size: 3rem;
        color: var(--primary);
        margin-bottom: 15px;
    }

    .upload-area h4 {
        font-size: 1.2rem;
        font-weight: 500;
        color: var(--text-dark);
        margin-bottom: 5px;
    }

    .upload-area p {
        color: var(--text-light);
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    .preview-container {
        margin-top: 20px;
        text-align: center;
    }

    .preview-image {
        max-width: 150px;
        max-height: 150px;
        border-radius: 50%;
        border: 3px solid var(--primary);
        padding: 3px;
        margin-bottom: 15px;
    }

    /* ===== BOTÕES ===== */
    .btn-elegante {
        padding: 10px 20px;
        border-radius: 50px;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
        cursor: pointer;
    }

    .btn-elegante.primary {
        background: var(--gradient);
        color: white;
    }

    .btn-elegante.primary:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .btn-elegante.secondary {
        background: white;
        color: var(--primary);
        border: 2px solid rgba(102, 126, 234, 0.2);
    }

    .btn-elegante.secondary:hover {
        border-color: var(--primary);
        transform: translateY(-2px);
    }

    .btn-elegante.danger {
        background: linear-gradient(135deg, #f56565, #c53030);
        color: white;
    }

    .btn-elegante.danger:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(245, 101, 101, 0.3);
    }

    /* ===== MENSAGENS FLASH ===== */
    .alert {
        border-radius: 15px;
        border: none;
        padding: 15px 20px;
        margin-bottom: 20px;
        animation: slideDown 0.5s ease;
    }

    .alert-success {
        background: linear-gradient(135deg, rgba(72, 187, 120, 0.1), rgba(72, 187, 120, 0.2));
        color: #2f855a;
    }

    .alert-danger {
        background: linear-gradient(135deg, rgba(245, 101, 101, 0.1), rgba(245, 101, 101, 0.2));
        color: #c53030;
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ===== RESPONSIVIDADE ===== */
    @media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }
        
        .info-grid {
            grid-template-columns: 1fr;
        }
        
        .products-grid {
            grid-template-columns: 1fr;
        }
        
        .profile-card-header .d-flex {
            flex-direction: column;
            text-align: center;
        }
        
        .profile-avatar-wrapper {
            margin-right: 0;
            margin-bottom: 15px;
        }
    }
</style>

<!-- Breadcrumb -->
<section class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/usuario/perfil">Perfil</a></li>
                <li class="breadcrumb-item active">Minha Conta</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Header -->
<section class="profile-header">
    <div class="container profile-header-content">
        <div class="text-center">
            <h1 class="display-5 fw-light text-dark">Minha <span class="fw-bold" style="background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Conta</span></h1>
            <p class="text-muted">Gerencie suas informações e produtos</p>
        </div>
    </div>
</section>

<!-- Card Principal -->
<div class="container">
    <div class="profile-card">
        <!-- Header do Card -->
        <div class="profile-card-header">
            <div class="d-flex align-items-center">
                <div class="profile-avatar-wrapper">
                    <% if (usuario && usuario.avatar) { %>
                        <img src="/<%= usuario.avatar %>" alt="Avatar" class="profile-avatar">
                    <% } else { %>
                        <div class="profile-avatar-placeholder">
                            <i class="bi bi-person-fill"></i>
                        </div>
                    <% } %>
                </div>
                <div>
                    <h2 class="profile-name"><%= usuario ? usuario.email.split('@')[0] : 'Usuário' %></h2>
                    <div class="profile-email">
                        <i class="bi bi-envelope"></i>
                        <span><%= usuario ? usuario.email : '' %></span>
                    </div>
                    <div class="profile-badge">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        Conta verificada
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-value"><%= produtos ? produtos.length : 0 %></div>
                <div class="stat-label">Produtos</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">0</div>
                <div class="stat-label">Vendas</div>
            </div>
            <div class="stat-item">
                <div class="stat-value"><%= new Date().getFullYear() %></div>
                <div class="stat-label">Membro desde</div>
            </div>
        </div>

        <!-- Mensagens Flash -->
        <div class="px-4">
            <% if (typeof errors !== 'undefined' && errors) { %>
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <%= errors %>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <%= success %>
                </div>
            <% } %>
        </div>

        <!-- Tabs -->
        <div class="profile-tabs">
            <button class="profile-tab active" onclick="showTab('info')">
                <i class="bi bi-person me-2"></i>Informações
            </button>
            <button class="profile-tab" onclick="showTab('products')">
                <i class="bi bi-box me-2"></i>Meus Produtos
            </button>
            <button class="profile-tab" onclick="showTab('avatar')">
                <i class="bi bi-camera me-2"></i>Foto
            </button>
        </div>

        <!-- Tab: Informações -->
        <div id="tab-info" class="tab-content">
            <div class="info-grid">
                <div class="info-card">
                    <h3 class="info-card-title">
                        <i class="bi bi-shield-check"></i>
                        Dados da Conta
                    </h3>
                    <div class="info-row">
                        <span class="info-label">ID do usuário</span>
                        <span class="info-value">#<%= usuario ? usuario.id : '' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">E-mail</span>
                        <span class="info-value"><%= usuario ? usuario.email : '' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Tipo de conta</span>
                        <span class="info-value">
                            <% if (user && user.isAdmin) { %>
                                <span class="badge bg-danger">Administrador</span>
                            <% } else { %>
                                <span class="badge bg-primary">Usuário</span>
                            <% } %>
                        </span>
                    </div>
                </div>

                <div class="info-card">
                    <h3 class="info-card-title">
                        <i class="bi bi-graph-up"></i>
                        Estatísticas
                    </h3>
                    <div class="info-row">
                        <span class="info-label">Produtos cadastrados</span>
                        <span class="info-value"><%= produtos ? produtos.length : 0 %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Total de avaliações</span>
                        <span class="info-value">0</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Média das avaliações</span>
                        <span class="info-value">-</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab: Produtos -->
        <div id="tab-products" class="tab-content" style="display: none;">
            <div class="products-grid">
                <% if (produtos && produtos.length > 0) { %>
                    <% produtos.forEach(produto => { %>
                        <a href="/produto/<%= produto.id %>" class="product-card">
                            <div class="product-image">
                                <% if (produto.imagemUrl) { %>
                                    <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>">
                                <% } else { %>
                                    <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                        <i class="bi bi-image text-secondary"></i>
                                    </div>
                                <% } %>
                            </div>
                            <div class="product-info">
                                <h4 class="product-name"><%= produto.name %></h4>
                                <div class="product-price"><%= produto.precoFormatado %></div>
                                <div class="product-category">
                                    <i class="bi bi-tag me-1"></i><%= produto.categoria %>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                <% } else { %>
                    <div class="empty-products">
                        <i class="bi bi-box"></i>
                        <h4>Nenhum produto cadastrado</h4>
                        <p>Comece a vender anunciando seu primeiro produto!</p>
                        <a href="/produtos/adicionar" class="btn-elegante primary">
                            <i class="bi bi-plus-circle me-2"></i>
                            Adicionar Produto
                        </a>
                    </div>
                <% } %>
            </div>
            
            <% if (produtos && produtos.length > 0) { %>
            <div class="text-center mt-4">
                <a href="/meus-produtos" class="btn-elegante secondary">
                    Ver todos os produtos
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
            <% } %>
        </div>

        <!-- Tab: Avatar -->
        <div id="tab-avatar" class="tab-content" style="display: none;">
            <div class="row">
                <div class="col-lg-8">
                    <form action="/usuario/perfil/avatar" method="POST" enctype="multipart/form-data" id="avatarForm">
                        <div class="upload-area" id="dropArea">
                            <i class="bi bi-cloud-arrow-up"></i>
                            <h4>Upload de foto</h4>
                            <p>Arraste uma imagem ou clique para selecionar</p>
                            <small class="text-muted">Formatos: JPG, PNG, GIF (max. 2MB)</small>
                            <input type="file" class="d-none" id="avatarInput" name="avatar" accept="image/*">
                        </div>
                        
                        <div id="previewContainer" class="preview-container" style="display: none;">
                            <img src="#" alt="Preview" class="preview-image" id="previewImage">
                            <div class="d-flex gap-2 justify-content-center">
                                <button type="submit" class="btn-elegante primary">
                                    <i class="bi bi-check2"></i>
                                    Confirmar
                                </button>
                                <button type="button" class="btn-elegante secondary" onclick="cancelPreview()">
                                    <i class="bi bi-x"></i>
                                    Cancelar
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
                
                <div class="col-lg-4">
                    <% if (usuario && usuario.avatar) { %>
                        <div class="info-card h-100">
                            <h3 class="info-card-title">
                                <i class="bi bi-image"></i>
                                Foto atual
                            </h3>
                            <div class="text-center mb-3">
                                <img src="/<%= usuario.avatar %>" alt="Avatar" class="preview-image">
                            </div>
                            <form action="/usuario/perfil/avatar/remover" method="POST" 
                                  onsubmit="return confirm('Remover foto de perfil?')">
                                <button type="submit" class="btn-elegante danger w-100">
                                    <i class="bi bi-trash"></i>
                                    Remover foto
                                </button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Função para alternar entre as tabs
    function showTab(tabName) {
        // Esconder todas as tabs
        document.getElementById('tab-info').style.display = 'none';
        document.getElementById('tab-products').style.display = 'none';
        document.getElementById('tab-avatar').style.display = 'none';
        
        // Remover classe active de todos os botões
        document.querySelectorAll('.profile-tab').forEach(btn => {
            btn.classList.remove('active');
        });
        
        // Mostrar tab selecionada
        document.getElementById('tab-' + tabName).style.display = 'block';
        
        // Adicionar classe active ao botão clicado
        event.target.classList.add('active');
    }

    // Upload de avatar
    document.addEventListener('DOMContentLoaded', function() {
        const dropArea = document.getElementById('dropArea');
        const avatarInput = document.getElementById('avatarInput');
        const previewContainer = document.getElementById('previewContainer');
        const previewImage = document.getElementById('previewImage');
        
        if (dropArea && avatarInput) {
            // Clique na área de upload
            dropArea.addEventListener('click', () => {
                avatarInput.click();
            });
            
            // Preview ao selecionar arquivo
            avatarInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        previewImage.src = e.target.result;
                        previewContainer.style.display = 'block';
                        dropArea.style.display = 'none';
                    }
                    reader.readAsDataURL(file);
                }
            });
            
            // Drag and drop
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                dropArea.addEventListener(eventName, preventDefaults, false);
            });
            
            function preventDefaults(e) {
                e.preventDefault();
                e.stopPropagation();
            }
            
            ['dragenter', 'dragover'].forEach(eventName => {
                dropArea.addEventListener(eventName, highlight, false);
            });
            
            ['dragleave', 'drop'].forEach(eventName => {
                dropArea.addEventListener(eventName, unhighlight, false);
            });
            
            function highlight() {
                dropArea.style.borderColor = 'var(--primary)';
                dropArea.style.background = 'white';
            }
            
            function unhighlight() {
                dropArea.style.borderColor = 'rgba(102, 126, 234, 0.3)';
                dropArea.style.background = 'var(--light-bg)';
            }
            
            dropArea.addEventListener('drop', function(e) {
                const dt = e.dataTransfer;
                const files = dt.files;
                avatarInput.files = files;
                
                if (files[0]) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        previewImage.src = e.target.result;
                        previewContainer.style.display = 'block';
                        dropArea.style.display = 'none';
                    }
                    reader.readAsDataURL(files[0]);
                }
            });
        }
    });

    // Cancelar preview
    function cancelPreview() {
        document.getElementById('previewContainer').style.display = 'none';
        document.getElementById('dropArea').style.display = 'block';
        document.getElementById('avatarInput').value = '';
    }
</script>

<%- include('./includes/footer') %>