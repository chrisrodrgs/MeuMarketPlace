<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<!-- Header -->
<section class="hero-section" style="min-height: 40vh;">
    <div class="container text-center">
        <div class="mb-4">
            <% if (user && user.avatar) { %>
                <img src="/<%= user.avatar %>" alt="Avatar" 
                     class="rounded-circle border border-4 border-white shadow"
                     style="width: 100px; height: 100px; object-fit: cover;">
            <% } else { %>
                <div class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center"
                     style="width: 100px; height: 100px;">
                    <i class="bi bi-person-circle text-white" style="font-size: 3rem;"></i>
                </div>
            <% } %>
        </div>
        <h1 class="hero-title">
            Olá, <span><%= user ? user.email.split('@')[0] : 'Usuário' %></span>!
        </h1>
        <p class="hero-subtitle mx-auto">Você já está logado em nossa plataforma</p>
        <div class="d-flex justify-content-center gap-3 mt-4">
            <a href="/meus-produtos" class="btn-elegante primary">
                <i class="bi bi-box me-2"></i>Meus Produtos
            </a>
            <a href="/usuario/perfil" class="btn-elegante outline">
                <i class="bi bi-person me-2"></i>Meu Perfil
            </a>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card-elegante text-center p-4">
                    <i class="bi bi-plus-circle display-3 text-primary"></i>
                    <h3 class="h5 mt-3">Adicionar Produto</h3>
                    <p class="text-muted small">Comece a vender anunciando seu primeiro produto</p>
                    <a href="/produtos/adicionar" class="btn-elegante primary mt-2">Adicionar</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-elegante text-center p-4">
                    <i class="bi bi-grid display-3 text-primary"></i>
                    <h3 class="h5 mt-3">Gerenciar Produtos</h3>
                    <p class="text-muted small">Edite ou remova seus produtos existentes</p>
                    <a href="/meus-produtos" class="btn-elegante primary mt-2">Gerenciar</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-elegante text-center p-4">
                    <i class="bi bi-person-circle display-3 text-primary"></i>
                    <h3 class="h5 mt-3">Editar Perfil</h3>
                    <p class="text-muted small">Atualize sua foto e informações pessoais</p>
                    <a href="/usuario/perfil" class="btn-elegante primary mt-2">Editar</a>
                </div>
            </div>
        </div>
        
        <div class="card-elegante text-center p-5 mt-5">
            <h2 class="fw-light mb-3">Pronto para começar?</h2>
            <p class="text-muted mb-4">Explore novos produtos ou continue gerenciando seu negócio</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/" class="btn-elegante outline">
                    <i class="bi bi-house me-2"></i>Página Inicial
                </a>
                <a href="/login/logout" class="btn-elegante danger">
                    <i class="bi bi-box-arrow-right me-2"></i>Sair
                </a>
            </div>
        </div>
    </div>
</section>

<%- include('./includes/footer') %>