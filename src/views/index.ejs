<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 fade-up">
                <h1 class="hero-title mb-4">
                    Bem-vindo ao<br>
                    <span>Marketplace</span><br>
                    mais elegante da web
                </h1>
                <p class="hero-subtitle mb-5">
                    Descubra produtos incríveis de vendedores talentosos. 
                    Uma experiência única de compras, onde design e funcionalidade se encontram.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="/produtos/adicionar" class="btn-elegante primary">
                        <i class="bi bi-plus-circle me-2"></i>Começar a vender
                    </a>
                    <a href="#categorias" class="btn-elegante outline">
                        Explorar <i class="bi bi-arrow-down ms-2"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center d-none d-lg-block">
                <div class="float">
                    <i class="bi bi-box-seam display-1" style="color: var(--primary); opacity: 0.3; font-size: 15rem;"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Estatísticas -->
<section class="stats-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="stat-card-elegante">
                    <i class="bi bi-shop"></i>
                    <h3><span class="counter" data-target="<%= stats.vendedores %>">0</span></h3>
                    <p>Vendedores ativos</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card-elegante">
                    <i class="bi bi-box"></i>
                    <h3><span class="counter" data-target="<%= stats.produtos %>">0</span></h3>
                    <p>Produtos cadastrados</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card-elegante">
                    <i class="bi bi-star"></i>
                    <h3><span class="counter" data-target="<%= stats.clientesSatisfeitos %>">0</span></h3>
                    <p>Avaliações 4+ estrelas</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categorias -->
<section id="categorias" class="categories-section">
    <div class="container">
        <div class="section-title">
            <h2>Navegue por <span>Categorias</span></h2>
            <p>Encontre exatamente o que você procura</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-2-4">
                <a href="/categoria/Café%20da%20manhã" class="category-card-elegante">
                    <i class="bi bi-cup-hot-fill"></i>
                    <h5>Café da manhã</h5>
                </a>
            </div>
            <div class="col-md-2-4">
                <a href="/categoria/Doces" class="category-card-elegante">
                    <i class="bi bi-cake-fill"></i>
                    <h5>Doces</h5>
                </a>
            </div>
            <div class="col-md-2-4">
                <a href="/categoria/Salgados" class="category-card-elegante">
                    <i class="bi bi-egg-fried"></i>
                    <h5>Salgados</h5>
                </a>
            </div>
            <div class="col-md-2-4">
                <a href="/categoria/Bebidas" class="category-card-elegante">
                    <i class="bi bi-cup-straw"></i>
                    <h5>Bebidas</h5>
                </a>
            </div>
            <div class="col-md-2-4">
                <a href="/categoria/Descart%C3%A1veis" class="category-card-elegante">
                    <i class="bi bi-box-seam"></i>
                    <h5>Descartáveis</h5>
                </a>
            </div>
        </div>
        
        <div class="text-center mt-5">
            <a href="/categorias" class="btn-elegante outline">
                Ver todas as categorias <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

<!-- Produtos em Destaque -->
<section class="featured-section">
    <div class="container">
        <div class="section-title">
            <h2>Produtos em <span>Destaque</span></h2>
            <p>Os produtos mais recentes da nossa comunidade</p>
        </div>

        <div class="row g-4">
            <% if (produtosDestaque && produtosDestaque.length > 0) { %>
                <% produtosDestaque.slice(0, 4).forEach((produto, index) => { %>
                <div class="col-md-6 col-lg-3">
                    <a href="/produto/<%= produto.id %>" class="product-card-elegante">
                        <div class="product-image-elegante">
                            <% if (produto.imagemUrl) { %>
                                <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>">
                            <% } else { %>
                                <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                    <i class="bi bi-image text-secondary" style="font-size: 3rem;"></i>
                                </div>
                            <% } %>
                            <span class="product-badge-elegante"><%= produto.categoria %></span>
                        </div>
                        <div class="product-content-elegante">
                            <h5><%= produto.name %></h5>
                            <div class="price"><%= produto.precoFormatado %></div>
                            <div class="seller">
                                <i class="bi bi-person-circle"></i>
                                <span><%= produto.email.split('@')[0] %></span>
                            </div>
                        </div>
                    </a>
                </div>
                <% }) %>
            <% } else { %>
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Nenhum produto em destaque no momento.</p>
                </div>
            <% } %>
        </div>
    </div>
</section>

<!-- Newsletter -->
<section class="newsletter-section">
    <div class="container">
        <div class="newsletter-card">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-3 mb-lg-0">
                    <h3>Fique por dentro</h3>
                    <p class="mb-0">Receba ofertas exclusivas e novidades diretamente no seu email</p>
                </div>
                <div class="col-lg-6">
                    <div class="d-flex gap-2 flex-wrap">
                        <input type="email" class="newsletter-input" placeholder="Seu melhor email">
                        <button class="newsletter-btn">
                            <i class="bi bi-send me-2"></i>Inscrever
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Contadores animados
        const counters = document.querySelectorAll('.counter');
        const speed = 100;

        counters.forEach(counter => {
            const updateCount = () => {
                const target = +counter.getAttribute('data-target');
                const count = +counter.innerText;
                const increment = target / speed;

                if (count < target) {
                    counter.innerText = Math.ceil(count + increment);
                    setTimeout(updateCount, 20);
                } else {
                    counter.innerText = target;
                }
            };

            updateCount();
        });

        // Observador de interseção para animações
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('fade-up');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.category-card-elegante, .product-card-elegante, .stat-card-elegante').forEach(el => {
            observer.observe(el);
        });
    });
</script>

<%- include('./includes/footer') %>