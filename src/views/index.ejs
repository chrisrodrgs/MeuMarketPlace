<!-- Categorias Elegantes -->
<section id="categorias" class="categories-section">
    <div class="container">
        <div class="section-title">
            <h2>Navegue por <span>Categorias</span></h2>
            <p>Encontre exatamente o que você procura</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-2-4">
                <div class="category-card-elegante">
                    <i class="bi bi-cup-hot-fill"></i>
                    <h5>Café da manhã</h5>
                </div>
            </div>
            <div class="col-md-2-4">
                <div class="category-card-elegante">
                    <i class="bi bi-cake-fill"></i>
                    <h5>Doces</h5>
                </div>
            </div>
            <div class="col-md-2-4">
                <div class="category-card-elegante">
                    <i class="bi bi-egg-fried"></i>
                    <h5>Salgados</h5>
                </div>
            </div>
            <div class="col-md-2-4">
                <div class="category-card-elegante">
                    <i class="bi bi-cup-straw"></i>
                    <h5>Bebidas</h5>
                </div>
            </div>
            <div class="col-md-2-4">
                <div class="category-card-elegante">
                    <i class="bi bi-box-seam"></i>
                    <h5>Descartáveis</h5>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Produtos em Destaque -->
<section class="featured-section">
    <div class="container">
        <div class="section-title">
            <h2>Produtos em <span>Destaque</span></h2>
            <p>Os produtos mais recentes da nossa comunidade</p>
        </div>

        <div class="row g-4">
            <% if (produtosDestaque && produtosDestaque.length > 0) { %>
                <% produtosDestaque.slice(0, 4).forEach((produto, index) => { %>
                <div class="col-md-6 col-lg-3">
                    <div class="product-card-elegante">
                        <div class="product-image-elegante">
                            <% if (produto.imagemUrl) { %>
                                <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>">
                            <% } else { %>
                                <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                    <i class="bi bi-image text-secondary" style="font-size: 3rem;"></i>
                                </div>
                            <% } %>
                            <span class="product-badge-elegante"><%= produto.categoria %></span>
                        </div>
                        <div class="product-content-elegante">
                            <h5><%= produto.name %></h5>
                            <div class="price"><%= produto.precoFormatado %></div>
                            <div class="seller">
                                <i class="bi bi-person-circle"></i>
                                <span><%= produto.email.split('@')[0] %></span>
                            </div>
                            <a href="/usuario/<%= produto.usuario_id %>/produtos" class="btn-product-elegante">
                                Ver detalhes
                            </a>
                        </div>
                    </div>
                </div>
                <% }) %>
            <% } else { %>
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Nenhum produto em destaque no momento.</p>
                </div>
            <% } %>
        </div>
    </div>
</section>

<!-- Newsletter Elegante -->
<section class="newsletter-section">
    <div class="container">
        <div class="newsletter-card">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h3>Fique por dentro</h3>
                    <p class="mb-0">Receba ofertas exclusivas e novidades diretamente no seu email</p>
                </div>
                <div class="col-lg-6">
                    <div class="d-flex gap-2">
                        <input type="email" class="form-control newsletter-input" placeholder="Seu melhor email">
                        <button class="btn newsletter-btn">
                            <i class="bi bi-send me-2"></i>Inscrever
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Scripts -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Contadores animados
        const counters = document.querySelectorAll('.counter');
        const speed = 100;

        counters.forEach(counter => {
            const updateCount = () => {
                const target = +counter.getAttribute('data-target');
                const count = +counter.innerText;
                const increment = target / speed;

                if (count < target) {
                    counter.innerText = Math.ceil(count + increment);
                    setTimeout(updateCount, 20);
                } else {
                    counter.innerText = target;
                }
            };

            updateCount();
        });

        // Observador de interseção para animações
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('fade-up');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.category-card-elegante, .product-card-elegante, .stat-card-elegante').forEach(el => {
            observer.observe(el);
        });
    });
</script>

<%- include('./includes/footer') %>