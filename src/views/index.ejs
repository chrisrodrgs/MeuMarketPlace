                        Explorar <i class="bi bi-arrow-down ms-2"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center d-none d-lg-block">
                <div class="float">
                    <i class="bi bi-box-seam display-1" style="color: var(--primary); opacity: 0.3; font-size: 15rem;"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Estatísticas Elegantes -->
<section class="stats-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="stat-card-elegante">
                    <i class="bi bi-shop"></i>
                    <h3><span class="counter" data-target="500">0</span>+</h3>
                    <p>Vendedores ativos</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card-elegante">
                    <i class="bi bi-box"></i>
                    <h3><span class="counter" data-target="1200">0</span>+</h3>
                    <p>Produtos cadastrados</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card-elegante">
                    <i class="bi bi-star"></i>
                    <h3><span class="counter" data-target="3000">0</span>+</h3>
                    <p>Clientes satisfeitos</p>
                </div>
