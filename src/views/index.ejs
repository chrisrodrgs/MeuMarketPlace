            </div>
        </div>
    </div>
</section>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>

<script>
    // Função para verificar se o link existe antes de redirecionar
    async function verificarLink(event, url) {
        if (!url || url === '') return true;
        
        event.preventDefault();
        
        try {
            const response = await fetch(url, { method: 'HEAD' });
            
            if (response.ok) {
                window.location.href = url;
            } else if (response.status === 404) {
                window.location.href = '/404';
            } else {
                window.location.href = '/404';
            }
        } catch (error) {
            console.error('Erro ao verificar link:', error);
            window.location.href = '/404';
        }
        
        return false;
    }
    
    $(document).ready(function() {
        // Configuração para transições mais fluidas e rápidas
        const slickSettings = {
            slidesToShow: 2,
            slidesToScroll: 1,
            autoplay: true,
            autoplaySpeed: 4000,
            dots: true,
            arrows: true,
            infinite: true,
            speed: 400,
            adaptiveHeight: false,
            cssEase: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)',
            prevArrow: '<button type="button" class="slick-prev" aria-label="Previous"></button>',
            nextArrow: '<button type="button" class="slick-next" aria-label="Next"></button>',
            responsive: [
                { breakpoint: 768, settings: { slidesToShow: 1 } }
            ]
        };
        
        // Inicializar carrossel de maiores descontos
        if ($('#maioresDescontosCarousel').length) {
            $('#maioresDescontosCarousel').slick(slickSettings);
        }
        
        // Inicializar carrossel de promoções recentes
        if ($('#promocoesRecentesCarousel').length) {
            $('#promocoesRecentesCarousel').slick(slickSettings);
        }
        
        // Contadores animados
        const counters = document.querySelectorAll('.counter');
        const speed = 100;

        counters.forEach(counter => {
            const updateCount = () => {
                const target = +counter.getAttribute('data-target');
                const count = +counter.innerText;
                const increment = target / speed;

                if (count < target) {
                    counter.innerText = Math.ceil(count + increment);
                    setTimeout(updateCount, 20);
                } else {
                    counter.innerText = target;
                }
            };

            updateCount();
        });

        // Observador de interseção para animações
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('fade-up');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.category-card-elegante, .product-card-elegante, .stat-card-elegante').forEach(el => {
            observer.observe(el);
        });
        
        // Remover qualquer texto residual dos botões após inicialização
        setTimeout(function() {
            $('.slick-prev, .slick-next').each(function() {
                $(this).html('');
                $(this).find('*').remove();
            });
        }, 100);
        
        // Adicionar evento de clique nos banners para verificar links
        $('.carousel-item').on('click', function(e) {
            if (!$(e.target).closest('a').length) {
                const link = $(this).find('a').attr('href');
                if (link && link !== '') {
                    verificarLink(e, link);
                }
            }
        });
    });
</script>

