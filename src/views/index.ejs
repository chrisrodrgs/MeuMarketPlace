        <div class="section-title">
            <h2>Navegue por <span>Categorias</span></h2>
            <p>Encontre exatamente o que você procura</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-2-4">
                <a href="/categoria/Café%20da%20manhã" class="category-card-elegante">
                    <i class="bi bi-cup-hot-fill"></i>
                    <h5>Café da manhã</h5>
                </a>
            </div>
            <div class="col-md-2-4">
                <a href="/categoria/Doces" class="category-card-elegante">
                    <i class="bi bi-cake-fill"></i>
                    <h5>Doces</h5>
                </a>
            </div>
            <div class="col-md-2-4">
                <a href="/categoria/Salgados" class="category-card-elegante">
                    <i class="bi bi-egg-fried"></i>
                    <h5>Salgados</h5>
                </a>
            </div>
            <div class="col-md-2-4">
                <a href="/categoria/Bebidas" class="category-card-elegante">
                    <i class="bi bi-cup-straw"></i>
                    <h5>Bebidas</h5>
                </a>
            </div>
            <div class="col-md-2-4">
                <a href="/categoria/Descart%C3%A1veis" class="category-card-elegante">
                    <i class="bi bi-box-seam"></i>
                    <h5>Descartáveis</h5>
                </a>
            </div>
        </div>
        
        <div class="text-center mt-5">
            <a href="/categorias" class="btn-elegante outline">
                Ver todas as categorias <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

<!-- Produtos em Destaque -->
<section class="featured-section">
    <div class="container">
        <div class="section-title">
            <h2>Produtos em <span>Destaque</span></h2>
            <p>Os produtos mais recentes da nossa comunidade</p>
        </div>

        <div class="row g-4">
            <% if (produtosDestaque && produtosDestaque.length > 0) { %>
                <% produtosDestaque.slice(0, 4).forEach((produto, index) => { 
                    let badgeClass = '';
                    if (produto.desconto >= 50) badgeClass = 'alto';
                    else if (produto.desconto >= 10) badgeClass = 'medio';
                    else if (produto.desconto > 0) badgeClass = 'baixo';
                %>
                <div class="col-md-6 col-lg-3">
                    <div class="product-card-elegante position-relative">
                        <% if (produto.desconto > 0) { %>
                            <div class="promo-badge <%= badgeClass %>">
                                -<%= produto.desconto %>% OFF
                            </div>
                        <% } %>
                        <a href="/produto/<%= produto.id %>" class="text-decoration-none">
                            <div class="product-image-elegante">
                                <% if (produto.imagemUrl) { %>
                                    <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>">
                                <% } else { %>
                                    <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                        <i class="bi bi-image text-secondary" style="font-size: 3rem;"></i>
                                    </div>
                                <% } %>
                                <span class="product-badge-elegante"><%= produto.categoria %></span>
                            </div>
                            <div class="product-content-elegante">
                                <h5><%= produto.name %></h5>
                                <div class="price">
                                    <% if (produto.precoOriginalFormatado) { %>
                                        <span class="preco-antigo"><%= produto.precoOriginalFormatado %></span>
                                        <span class="preco-promocional"><%= produto.precoFormatado %></span>
                                    <% } else { %>
                                        <span><%= produto.precoFormatado %></span>
                                    <% } %>
                                </div>
                                <div class="seller">
                                    <i class="bi bi-person-circle"></i>
                                    <span><%= produto.email.split('@')[0] %></span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
                <% }) %>
            <% } else { %>
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Nenhum produto em destaque no momento.</p>
                </div>
            <% } %>
        </div>
    </div>
</section>

<!-- Newsletter -->
<section class="newsletter-section">
    <div class="container">
        <div class="newsletter-card">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-3 mb-lg-0">
                    <h3>Fique por dentro</h3>
                    <p class="mb-0">Receba ofertas exclusivas e novidades diretamente no seu email</p>
                </div>
                <div class="col-lg-6">
                    <div class="d-flex gap-2 flex-wrap">
                        <input type="email" class="newsletter-input" placeholder="Seu melhor email">
                        <button class="newsletter-btn">
                            <i class="bi bi-send me-2"></i>Inscrever
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>

<script>
    $(document).ready(function() {
        // Inicializar carrossel de maiores descontos
        if ($('#maioresDescontosCarousel').length) {
            $('#maioresDescontosCarousel').slick({
                slidesToShow: 2,
                slidesToScroll: 1,
                autoplay: true,
                autoplaySpeed: 5000,
                dots: true,
                arrows: true,
                infinite: true,
                speed: 500,
                adaptiveHeight: false,
                responsive: [
                    { breakpoint: 768, settings: { slidesToShow: 1 } }
                ]
            });
        }
        
        // Inicializar carrossel de promoções recentes
        if ($('#promocoesRecentesCarousel').length) {
            $('#promocoesRecentesCarousel').slick({
                slidesToShow: 2,
                slidesToScroll: 1,
                autoplay: true,
                autoplaySpeed: 5000,
                dots: true,
                arrows: true,
                infinite: true,
                speed: 500,
                adaptiveHeight: false,
                responsive: [
                    { breakpoint: 768, settings: { slidesToShow: 1 } }
                ]
            });
        }
        
        // Contadores animados
        const counters = document.querySelectorAll('.counter');
        const speed = 100;

        counters.forEach(counter => {
            const updateCount = () => {
                const target = +counter.getAttribute('data-target');
                const count = +counter.innerText;
                const increment = target / speed;

                if (count < target) {
                    counter.innerText = Math.ceil(count + increment);
                    setTimeout(updateCount, 20);
                } else {
                    counter.innerText = target;
                }
            };

            updateCount();
        });

        // Observador de interseção para animações
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('fade-up');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.category-card-elegante, .product-card-elegante, .stat-card-elegante').forEach(el => {
            observer.observe(el);
        });
    });
</script>

