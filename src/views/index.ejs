<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<style>
    /* Carrossel de Banners */
    .carousel-container {
        position: relative;
        margin-bottom: 40px;
    }
    .carousel-item {
        position: relative;
        border-radius: 24px;
        overflow: hidden;
        height: 400px;
    }
    .carousel-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .carousel-caption {
        position: absolute;
        bottom: 20%;
        left: 10%;
        right: auto;
        text-align: left;
        background: linear-gradient(90deg, rgba(0,0,0,0.7), transparent);
        padding: 30px;
        border-radius: 20px;
        max-width: 500px;
    }
    .carousel-caption h3 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 10px;
        color: white;
    }
    .carousel-caption p {
        font-size: 1rem;
        margin-bottom: 20px;
        color: rgba(255,255,255,0.9);
    }
    .carousel-caption .btn {
        background: white;
        color: #667eea;
        border-radius: 50px;
        padding: 10px 25px;
        font-weight: 500;
        text-decoration: none;
    }
    .carousel-control-prev, .carousel-control-next {
        width: 50px;
        height: 50px;
        background: white;
        border-radius: 50%;
        top: 50%;
        transform: translateY(-50%);
        opacity: 0.8;
    }
    .carousel-control-prev:hover, .carousel-control-next:hover {
        opacity: 1;
    }
    .carousel-control-prev-icon, .carousel-control-next-icon {
        filter: invert(1);
    }
    .carousel-indicators button {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin: 0 5px;
        background: white;
    }
    .carousel-indicators button.active {
        background: #667eea;
    }
</style>

<!-- Carrossel de Banners -->
<% if (banners && banners.length > 0) { %>
<div class="container mt-4">
    <div id="mainCarousel" class="carousel slide carousel-container" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <% banners.forEach((banner, index) => { %>
            <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="<%= index %>" 
                    class="<%= index === 0 ? 'active' : '' %>"></button>
            <% }) %>
        </div>
        <div class="carousel-inner">
            <% banners.forEach((banner, index) => { %>
            <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                <img src="<%= banner.imagem %>" alt="<%= banner.titulo %>">
                <div class="carousel-caption">
                    <h3><%= banner.titulo %></h3>
                    <p><%= banner.descricao %></p>
                    <a href="<%= banner.link || '#' %>" class="btn">Saiba mais</a>
                </div>
            </div>
            <% }) %>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Próximo</span>
        </button>
    </div>
</div>
<% } %>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 fade-up">
                <h1 class="hero-title mb-4">
                    Bem-vindo ao<br>
                    <span>Marketplace</span><br>
                    mais elegante da web
                </h1>
                <p class="hero-subtitle mb-5">
                    Descubra produtos incríveis de vendedores talentosos. 
                    Uma experiência única de compras, onde design e funcionalidade se encontram.
                </p>
                <div class="d-flex gap-3 flex-wrap mb-4">
                    <a href="/produtos/adicionar" class="btn-elegante primary">
                        <i class="bi bi-plus-circle me-2"></i>Começar a vender
                    </a>
                    <a href="#categorias" class="btn-elegante outline">
                        Explorar <i class="bi bi-arrow-down ms-2"></i>
                    </a>
                </div>
                <div class="mb-5"></div>
            </div>
            <div class="col-lg-6 text-center d-none d-lg-block">
                <div class="float">
                    <i class="bi bi-box-seam display-1" style="color: var(--primary); opacity: 0.3; font-size: 15rem;"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- INCLUDE DOS CARROSSÉIS DE PROMOÇÃO -->
<%- include('./includes/promo-carousels') %>

<!-- Estatísticas -->
<section class="stats-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="stat-card-elegante">
                    <i class="bi bi-shop"></i>
                    <h3><span class="counter" data-target="<%= stats.vendedores %>">0</span></h3>
                    <p>Vendedores ativos</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card-elegante">
                    <i class="bi bi-box"></i>
                    <h3><span class="counter" data-target="<%= stats.produtos %>">0</span></h3>
                    <p>Produtos cadastrados</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card-elegante">
                    <i class="bi bi-star"></i>
                    <h3><span class="counter" data-target="<%= stats.clientesSatisfeitos %>">0</span></h3>
                    <p>Avaliações 4+ estrelas</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categorias -->
