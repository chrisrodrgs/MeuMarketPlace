<!-- Produtos em Destaque -->
<section class="featured-section">
    <div class="container">
        <div class="section-title">
            <h2>Produtos em <span>Destaque</span></h2>
            <p>Os produtos mais recentes da nossa comunidade</p>
        </div>

        <div class="row g-4">
            <% if (produtosDestaque && produtosDestaque.length > 0) { %>
                <% produtosDestaque.slice(0, 4).forEach((produto, index) => { 
                    let badgeClass = '';
                    if (produto.desconto >= 50) badgeClass = 'alto';
                    else if (produto.desconto >= 10) badgeClass = 'medio';
                    else if (produto.desconto > 0) badgeClass = 'baixo';
                %>
                <div class="col-md-6 col-lg-3">
                    <div class="product-card-elegante position-relative">
                        <% if (produto.desconto > 0) { %>
                            <div class="promo-badge <%= badgeClass %>">
                                -<%= produto.desconto %>% OFF
                            </div>
                        <% } %>
                        <a href="/produto/<%= produto.id %>" class="text-decoration-none">
                            <div class="product-image-elegante">
                                <% if (produto.imagemUrl) { %>
                                    <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>">
                                <% } else { %>
                                    <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                        <i class="bi bi-image text-secondary" style="font-size: 3rem;"></i>
                                    </div>
                                <% } %>
                                <span class="product-badge-elegante"><%= produto.categoria %></span>
                            </div>
                            <div class="product-content-elegante">
                                <h5><%= produto.name %></h5>
                                <div class="price">
                                    <% if (produto.precoOriginalFormatado) { %>
                                        <span class="preco-antigo"><%= produto.precoOriginalFormatado %></span>
                                        <span class="preco-promocional"><%= produto.precoFormatado %></span>
                                    <% } else { %>
                                        <span><%= produto.precoFormatado %></span>
                                    <% } %>
                                </div>
                                <div class="seller">
                                    <i class="bi bi-person-circle"></i>
                                    <span><%= produto.email.split('@')[0] %></span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
                <% }) %>
            <% } else { %>
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Nenhum produto em destaque no momento.</p>
                </div>
            <% } %>
        </div>
    </div>
</section>

<!-- Newsletter -->
