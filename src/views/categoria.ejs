<%- include('./includes/head') %>
<%- include('./includes/nav1') %>

<!-- Breadcrumb -->
<section class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/categorias">Categorias</a></li>
                <li class="breadcrumb-item active"><%= categoria %></li>
            </ol>
        </nav>
    </div>
</section>

<!-- Header -->
<section class="hero-section" style="min-height: 30vh; padding: 60px 0;">
    <div class="container text-center">
        <h1 class="hero-title">
            <span><%= categoria %></span>
        </h1>
        <p class="hero-subtitle">Explore os melhores produtos nesta categoria</p>
        <div class="mt-3">
            <span class="badge bg-primary fs-6"><%= totalProdutos %> produtos</span>
        </div>
    </div>
</section>

<!-- Filtros e Produtos -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <!-- Filtros -->
            <div class="col-lg-3 mb-4">
                <div class="card-elegante p-3">
                    <h5 class="fw-semibold mb-3"><i class="bi bi-funnel text-primary me-2"></i>Filtros</h5>
                    <form id="filterForm" method="GET">
                        <!-- Ordenar -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ordenar por</label>
                            <select name="ordenar" class="form-select">
                                <option value="recentes" <%= !filtros.ordenar || filtros.ordenar === 'recentes' ? 'selected' : '' %>>Mais recentes</option>
                                <option value="melhores_avaliacoes" <%= filtros.ordenar === 'melhores_avaliacoes' ? 'selected' : '' %>>Melhores avaliações</option>
                                <option value="mais_avaliados" <%= filtros.ordenar === 'mais_avaliados' ? 'selected' : '' %>>Mais avaliados</option>
                                <option value="preco_asc" <%= filtros.ordenar === 'preco_asc' ? 'selected' : '' %>>Menor preço</option>
                                <option value="preco_desc" <%= filtros.ordenar === 'preco_desc' ? 'selected' : '' %>>Maior preço</option>
                            </select>
                        </div>
                        <!-- Preço -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Faixa de preço</label>
                            <select name="preco" class="form-select">
                                <option value="">Todos</option>
                                <option value="0-50" <%= filtros.preco === '0-50' ? 'selected' : '' %>>Até R$ 50</option>
                                <option value="50-100" <%= filtros.preco === '50-100' ? 'selected' : '' %>>R$ 50 - R$ 100</option>
                                <option value="100-200" <%= filtros.preco === '100-200' ? 'selected' : '' %>>R$ 100 - R$ 200</option>
                                <option value="200+" <%= filtros.preco === '200+' ? 'selected' : '' %>>Acima R$ 200</option>
                            </select>
                        </div>
                        <!-- Avaliação -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Avaliação mínima</label>
                            <select name="avaliacao" class="form-select">
                                <option value="0" <%= !filtros.avaliacao || filtros.avaliacao === '0' ? 'selected' : '' %>>Qualquer</option>
                                <option value="4" <%= filtros.avaliacao === '4' ? 'selected' : '' %>>4+ estrelas</option>
                                <option value="3" <%= filtros.avaliacao === '3' ? 'selected' : '' %>>3+ estrelas</option>
                                <option value="2" <%= filtros.avaliacao === '2' ? 'selected' : '' %>>2+ estrelas</option>
                            </select>
                        </div>
                        <button type="submit" class="btn-elegante primary w-100 mb-2">Aplicar</button>
                        <a href="/categoria/<%= encodeURIComponent(categoria) %>" class="btn-elegante secondary w-100">Limpar</a>
                    </form>
                </div>
            </div>
            
            <!-- Produtos -->
            <div class="col-lg-9">
                <% if (produtos && produtos.length > 0) { %>
                    <div class="row g-4">
                        <% produtos.forEach(produto => { %>
                        <div class="col-md-6 col-xl-4">
                            <a href="/produto/<%= produto.id %>" class="text-decoration-none">
                                <div class="card-elegante h-100">
                                    <div class="product-image-elegante" style="height: 180px;">
                                        <% if (produto.imagemUrl) { %>
                                            <img src="<%= produto.imagemUrl %>" alt="<%= produto.name %>">
                                        <% } else { %>
                                            <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                                <i class="bi bi-image text-secondary" style="font-size: 2rem;"></i>
                                            </div>
                                        <% } %>
                                    </div>
                                    <div class="p-3">
                                        <h6 class="fw-bold text-truncate"><%= produto.name %></h6>
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <div class="text-warning small">
                                                <% for (let i = 1; i <= 5; i++) { %>
                                                    <i class="bi <%= i <= Math.round(produto.mediaAvaliacoes) ? 'bi-star-fill' : 'bi-star' %>"></i>
                                                <% } %>
                                            </div>
                                            <small class="text-muted">(<%= produto.totalAvaliacoes %>)</small>
                                        </div>
                                        <div class="text-primary fw-bold"><%= produto.precoFormatado %></div>
                                        <small class="text-muted"><i class="bi bi-person-circle"></i> <%= produto.email.split('@')[0] %></small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <% }) %>
                    </div>
                    
                    <!-- Paginação -->
                    <% if (totalPaginas > 1) { %>
                    <div class="d-flex justify-content-center gap-2 mt-5">
                        <% for (let i = 1; i <= totalPaginas; i++) { %>
                            <a href="?pagina=<%= i %><%= filtros.ordenar ? '&ordenar=' + filtros.ordenar : '' %><%= filtros.preco ? '&preco=' + filtros.preco : '' %><%= filtros.avaliacao && filtros.avaliacao !== '0' ? '&avaliacao=' + filtros.avaliacao : '' %>" 
                               class="btn btn-sm <%= i === paginaAtual ? 'btn-primary' : 'btn-outline-primary' %>"><%= i %></a>
                        <% } %>
                    </div>
                    <% } %>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="bi bi-box display-1 text-muted"></i>
                        <h3 class="fw-light mt-3">Nenhum produto encontrado</h3>
                        <a href="/categoria/<%= encodeURIComponent(categoria) %>" class="btn-elegante primary mt-3">Limpar filtros</a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('./includes/footer') %>